#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.14"
# dependencies = []
# ///
"""Offline console for the agent-skill inventory.

`render` simulates Claude Code's skill-listing admission from live inputs and
writes one self-contained HTML page. `apply` validates a decisions document
exported from that page and commits the edits into the chezmoi source tree.
`budget` recomputes an admission from a fixture table. This file is argument
parsing, orchestration, and output formatting; the algorithm lives in the
`skill_console` package.
"""
from __future__ import annotations

import argparse
import dataclasses
import difflib
import enum
import json
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import webbrowser
from collections.abc import Mapping, Sequence
from dataclasses import dataclass, replace
from datetime import UTC, datetime
from pathlib import Path
from typing import NoReturn

from skill_console import (
    BINARY_VERSION,
    CAPABILITIES,
    CONSOLE_VERSION,
    Admission,
    BudgetInputs,
    Decisions,
    ListingEntry,
    Op,
    Origin,
    PackageRecord,
    Predicted,
    Rendered,
    Row,
    SkillRecord,
    Snapshot,
    Tree,
    Violation,
)
from skill_console import decisions as decisions_api
from skill_console.budget import (
    admit,
    diff_admissions,
    display_width,
    listing_text,
    render_listing,
    utf16_length,
)
from skill_console.frontmatter import FrontmatterError
from skill_console.inventory import (
    Divergence,
    ListingCapture,
    MergedSettings,
    build_rows,
    build_snapshot,
    bundled_skills_disabled,
    entries_for,
    load_builtins,
    load_listing_capture,
    load_repo_packages,
    load_settings,
    load_skills,
    load_statusline_state,
    load_unmanaged_skills,
    load_usage,
    reconcile,
    resolve_budget_inputs,
    resolve_load_roots,
)

SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT = SCRIPT_DIR.parents[3]
PACKAGES_ROOT = REPO_ROOT / "home/dot_agents/packages"
TEMPLATE_PATH = SCRIPT_DIR.parent / "templates/skill-console.html"
BUILTINS_FIXTURE = SCRIPT_DIR / "skill_console/builtins.json"
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
CONSOLE_STATE = STATE_HOME / "dotfiles/skill-console"
STATUSLINE_DIR = STATE_HOME / "dotfiles/claude/statusline"
MARKETPLACE_ROOT = Path.home() / ".agents/plugins/plugins"
# Claude keeps settings, plugins, projects, and .claude.json inside
# CLAUDE_CONFIG_DIR when it is set; otherwise .claude.json sits beside ~/.claude.
_CONFIG_DIR_OVERRIDE = os.environ.get("CLAUDE_CONFIG_DIR")
CLAUDE_CONFIG_DIR = (
    Path(_CONFIG_DIR_OVERRIDE).expanduser() if _CONFIG_DIR_OVERRIDE else Path.home() / ".claude"
)
CLAUDE_CONFIG = (CLAUDE_CONFIG_DIR if _CONFIG_DIR_OVERRIDE else Path.home()) / ".claude.json"
CLAUDE_PROJECTS = CLAUDE_CONFIG_DIR / "projects"

# Same JSON <script> slot convention as scripts/eval-review.py.
DATA_MARKER = "__EMBEDDED_DATA__"
APM_DEPENDENCY_LINE = re.compile(r"^- APM dependency: `([^`]+)`\s*$", re.MULTILINE)

EXIT_OK = 0
EXIT_USAGE = 1
EXIT_DISCOVERY = 2
EXIT_VALIDATION = 3
EXIT_STAGED = 4
EXIT_PARTIAL = 5

STALE_VIOLATION = "V11"


class ConsoleExit(Exception):
    def __init__(self, code: int, reason: str, payload: Mapping[str, object] | None = None):
        super().__init__(reason)
        self.code = code
        self.reason = reason
        self.payload = dict(payload or {})


class _Parser(argparse.ArgumentParser):
    # argparse exits 2 on usage errors, but the contract reserves 2 for
    # discovery failures; route usage errors through the same exit path.
    def error(self, message: str) -> NoReturn:
        self.print_usage(sys.stderr)
        raise ConsoleExit(EXIT_USAGE, message)


@dataclass(frozen=True, slots=True)
class _Live:
    settings: MergedSettings
    packages: list[PackageRecord]
    capture: ListingCapture | None
    inputs: BudgetInputs
    model_id: str
    warnings: list[str]
    rows: list[Row]
    entries: list[ListingEntry]
    admission: Admission
    divergences: list[Divergence]
    snapshot: Snapshot
    cwd: Path
    project_root: Path
    now_ms: int


# --- shared helpers ---------------------------------------------------------


def _warn(message: str) -> None:
    print(f"skill-console: warning: {message}", file=sys.stderr)


def _jsonable(value: object) -> object:
    if dataclasses.is_dataclass(value) and not isinstance(value, type):
        return {
            field.name: _jsonable(getattr(value, field.name))
            for field in dataclasses.fields(value)
        }
    if isinstance(value, enum.Enum):
        return value.value
    if isinstance(value, Path):
        return str(value)
    if isinstance(value, Mapping):
        return {str(_jsonable(key)): _jsonable(item) for key, item in value.items()}
    if isinstance(value, (list, tuple, set, frozenset)):
        return [_jsonable(item) for item in value]
    # JSON has no literal for an infinite env budget; the page turns it back into a Number.
    if isinstance(value, float) and math.isinf(value):
        return "Infinity" if value > 0 else "-Infinity"
    return value


def _fmt_number(value: int | float) -> str:
    if isinstance(value, float):
        if math.isinf(value):
            return "Infinity" if value > 0 else "-Infinity"
        return f"{value:g}"
    return f"{value:,}"


_LONE_SURROGATE = re.compile("[\ud800-\udfff]")


def _json_text(value: object, **kwargs: object) -> str:
    """`json.dumps` that survives a lone surrogate, which the 1536 cap can leave
    behind when it cuts a surrogate pair; JSON allows it only as an escape."""
    text = json.dumps(_jsonable(value), ensure_ascii=False, **kwargs)
    return _LONE_SURROGATE.sub(lambda match: f"\\u{ord(match.group()):04x}", text)


def _dump_json(value: object) -> None:
    print(_json_text(value, indent=2, sort_keys=True))


def _read_json_file(path: Path, what: str) -> object:
    try:
        return json.loads(path.read_text())
    except OSError as exc:
        raise ConsoleExit(EXIT_USAGE, f"cannot read {what} {path}: {exc.strerror}") from exc
    except json.JSONDecodeError as exc:
        raise ConsoleExit(EXIT_USAGE, f"{what} {path} is not valid JSON: {exc}") from exc


def _utc_stamp(now_ms: int | None = None) -> str:
    moment = datetime.now(UTC) if now_ms is None else datetime.fromtimestamp(now_ms / 1000, UTC)
    return moment.strftime("%Y%m%dT%H%M%SZ")


def _project_root(explicit: str | None) -> Path:
    if explicit:
        return Path(explicit).resolve()
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=False
    )
    if result.returncode == 0 and result.stdout.strip():
        return Path(result.stdout.strip()).resolve()
    return Path.cwd()


def _claude_binary() -> Path | None:
    found = shutil.which("claude")
    return Path(found).resolve() if found else None


def _main_worktree_root(cwd: Path) -> Path | None:
    """The main worktree of a linked git worktree; None for a plain checkout."""
    result = subprocess.run(
        ["git", "-C", str(cwd), "rev-parse", "--git-common-dir"],
        capture_output=True, text=True, check=False,
    )
    if result.returncode != 0 or not result.stdout.strip():
        return None
    common = Path(result.stdout.strip())
    if not common.is_absolute():
        common = cwd / common
    return common.resolve().parent if common.name == ".git" else None


def _latest_statusline_state() -> tuple[str, int, str] | None:
    if not STATUSLINE_DIR.is_dir():
        return None
    # One file per session and no session id here, so newest write wins.
    for path in sorted(STATUSLINE_DIR.glob("*.json"), key=lambda p: p.stat().st_mtime, reverse=True):
        state = load_statusline_state(path)
        if state is not None:
            return state
    return None


def _format_table(
    headers: Sequence[str], rows: Sequence[Sequence[str]], right: Sequence[bool]
) -> list[str]:
    widths = [len(header) for header in headers]
    for row in rows:
        for index, cell in enumerate(row):
            widths[index] = max(widths[index], len(cell))

    def line(cells: Sequence[str]) -> str:
        return "  ".join(
            cell.rjust(widths[index]) if right[index] else cell.ljust(widths[index])
            for index, cell in enumerate(cells)
        ).rstrip()

    return [line(headers), *(line(row) for row in rows)]


def _admission_table(
    admission: Admission,
    entries: Sequence[ListingEntry],
    rows_by_name: Mapping[str, Row] | None = None,
) -> list[str]:
    headers = ["#", "rendered", "cost", "upgrade", "rank", "flags", "name"]
    right = [True, False, True, True, True, False, False]
    if rows_by_name is not None:
        headers.insert(5, "origin")
        right.insert(5, False)
    body: list[list[str]] = []
    for cost in admission.costs:
        entry = entries[cost.index]
        full = admission.rendered.get(cost.name) is Rendered.FULL
        flags = [
            flag
            for flag, on in (
                ("protected", entry.protected),
                ("pinned", entry.forced_name_only),
                ("capped", cost.capped),
                ("divergent", cost.width_divergent),
            )
            if on
        ]
        cells = [
            str(cost.index + 1),
            "full" if full else "name-only",
            str(cost.full_cost if full else cost.name_only_cost),
            "" if full else f"+{cost.upgrade_cost}",
            f"{entry.rank:.2f}",
            " ".join(flags),
            cost.name,
        ]
        if rows_by_name is not None:
            row = rows_by_name.get(cost.name)
            cells.insert(5, row.origin.value if row else "")
        body.append(cells)
    return _format_table(headers, body, right)


def _budget_line(inputs: BudgetInputs, admission: Admission) -> str:
    if inputs.env_budget:
        note = "" if admission.budget_from_env else ", negative and still honored"
        return (
            f"{_fmt_number(admission.budget)} chars"
            f"  (SLASH_COMMAND_TOOL_CHAR_BUDGET={_fmt_number(inputs.env_budget)}{note})"
        )
    return (
        f"{inputs.context_window:,} window x {inputs.bytes_per_token} bytes/token"
        f" x {inputs.fraction:g} fraction = {_fmt_number(admission.budget)} chars"
    )


def _admission_summary(admission: Admission) -> list[str]:
    over = admission.demand_chars - admission.budget
    demand_note = f"{_fmt_number(over)} over budget" if over > 0 else f"{_fmt_number(-over)} under budget"
    lines = [
        f"mode      {admission.mode}  (demand {admission.demand_chars:,} chars, {demand_note})",
        f"rendered  {admission.rendered_chars:,} chars, headroom {_fmt_number(admission.headroom_chars)}",
    ]
    if admission.all_pinned:
        lines.append("          every row is pinned: the listing renders in full while over budget")
    divergent = sum(1 for cost in admission.costs if cost.width_divergent)
    lines.append(
        f"rows      {len(admission.costs)} listed: {len(admission.full)} full,"
        f" {len(admission.name_only)} name-only, {len(admission.capped)} capped,"
        f" {divergent} width-divergent"
    )
    return lines


# --- live inventory ---------------------------------------------------------


def _collect(
    *,
    project_root: Path,
    model: str | None,
    context_window: int | None,
    now_ms: int,
) -> _Live:
    home = Path.home()
    cwd = Path.cwd()
    if not BUILTINS_FIXTURE.is_file():
        raise ConsoleExit(EXIT_DISCOVERY, f"built-in listing fixture missing: {BUILTINS_FIXTURE}")
    try:
        settings = load_settings(home, project_root, config_dir=CLAUDE_CONFIG_DIR)
        packages = load_repo_packages(REPO_ROOT)
        load_roots = resolve_load_roots(settings, home, config_dir=CLAUDE_CONFIG_DIR)
        by_tree = {
            Tree.SOURCE: load_skills(PACKAGES_ROOT, Tree.SOURCE),
            Tree.MARKETPLACE: load_skills(MARKETPLACE_ROOT, Tree.MARKETPLACE),
            Tree.CACHE: [
                *(
                    record
                    for root in dict.fromkeys(load_roots.values())
                    for record in load_skills(root, Tree.CACHE)
                ),
                *load_unmanaged_skills(
                    home,
                    project_root,
                    cwd=cwd,
                    config_dir=CLAUDE_CONFIG_DIR,
                    main_worktree_root=_main_worktree_root(cwd),
                ),
            ],
        }
        usage = load_usage(CLAUDE_CONFIG)
        builtins = load_builtins(BUILTINS_FIXTURE)
    except FrontmatterError as exc:
        raise ConsoleExit(EXIT_DISCOVERY, f"unreadable skill frontmatter: {exc}") from exc
    try:
        inputs, model_id, warnings = resolve_budget_inputs(
            settings,
            model=model,
            context_window=context_window,
            statusline_state=_latest_statusline_state(),
            env=os.environ,
        )
    except ValueError as exc:
        raise ConsoleExit(EXIT_DISCOVERY, str(exc)) from exc

    rows = build_rows(
        packages, by_tree, builtins, usage, settings, now_ms,
        disable_bundled=bundled_skills_disabled(settings, os.environ),
    )
    entries = entries_for(rows, settings=settings)
    admission = admit(entries, inputs)
    rows = _with_admission(rows, admission)
    # Sessions record the directory claude was launched from, normally the
    # project root, so a render from a subdirectory still finds its capture.
    capture = load_listing_capture(CLAUDE_PROJECTS, cwd)
    if capture is None and project_root != cwd:
        capture = load_listing_capture(CLAUDE_PROJECTS, project_root)
    snapshot = build_snapshot(
        inputs=inputs,
        model=model_id,
        by_tree=by_tree,
        settings=settings,
        usage=usage,
        capture=capture,
        binary_path=_claude_binary(),
        repo_root=REPO_ROOT,
        cwd=cwd,
        project_root=project_root,
        now_ms=now_ms,
    )
    return _Live(
        settings=settings,
        packages=packages,
        capture=capture,
        inputs=inputs,
        model_id=model_id,
        warnings=list(warnings),
        rows=rows,
        entries=entries,
        admission=admission,
        divergences=reconcile(rows),
        snapshot=snapshot,
        cwd=cwd,
        project_root=project_root,
        now_ms=now_ms,
    )


def _with_admission(rows: Sequence[Row], admission: Admission) -> list[Row]:
    costs = {cost.name: cost for cost in admission.costs}
    joined: list[Row] = []
    for row in rows:
        cost = costs.get(row.name)
        if cost is None:
            joined.append(row)
            continue
        joined.append(
            replace(
                row,
                rendered=admission.rendered[row.name],
                capped=cost.capped,
                width_divergent=cost.width_divergent,
            )
        )
    return joined


# --- prediction -------------------------------------------------------------


def _record_for(row: Row) -> SkillRecord | None:
    return row.source_record or row.marketplace_record or row.cache_record


def _entry_from_row(row: Row, description: str | None = None) -> ListingEntry:
    record = _record_for(row)
    text = description if description is not None else (record.description if record else "")
    when_to_use = record.when_to_use if record else None
    return ListingEntry(
        name=row.name,
        listing_text=listing_text(text, when_to_use),
        protected=row.protected,
        forced_name_only=False,
        rank=row.rank,
    )


def _entries_after(
    decisions: Decisions, live: _Live
) -> tuple[list[ListingEntry], BudgetInputs]:
    inputs = live.inputs
    disabled_packages: set[str] = set()
    enabled_packages: set[str] = set()
    delisted: set[str] = set()
    relisted: set[str] = set()
    new_description: dict[str, str] = {}
    for operation in decisions.operations:
        fields = operation.fields
        match operation.op:
            case Op.SET_BUDGET_FRACTION:
                inputs = replace(inputs, fraction=float(fields["to_value"]))
            case Op.SET_DEFAULT_LOADED | Op.SET_PACKAGE_ENABLED:
                package = operation.key.split("@", 1)[0]
                (enabled_packages if fields["value"] else disabled_packages).add(package)
            case Op.DELETE_SKILL:
                delisted.add(operation.key)
            case Op.SET_FRONTMATTER:
                if fields["field"] == "disable-model-invocation":
                    (delisted if fields["value"] else relisted).add(operation.key)
            case Op.SET_DESCRIPTION:
                new_description[operation.key] = str(fields["text"])

    rows_by_name = {row.name: row for row in live.rows}
    after: list[ListingEntry] = []
    for entry in live.entries:
        row = rows_by_name.get(entry.name)
        if entry.name in delisted or (row is not None and row.package in disabled_packages):
            continue
        if entry.name in new_description and row is not None:
            after.append(replace(entry, listing_text=_entry_from_row(row, new_description[entry.name]).listing_text))
        else:
            after.append(entry)

    present = {entry.name for entry in after} | delisted
    entering: list[ListingEntry] = []
    for row in live.rows:
        if row.name in present:
            continue
        record = _record_for(row)
        via_package = row.package in enabled_packages and row.package not in disabled_packages
        if via_package and record is not None and record.disable_model_invocation and row.name not in relisted:
            continue
        if row.name in relisted or via_package:
            entering.append(_entry_from_row(row, new_description.get(row.name)))
            present.add(row.name)
    # Plugin rows precede the command registry in the real listing, so a row
    # that enters (re-enabled package, DMI cleared) goes before the built-ins.
    if entering:
        builtin_names = {row.name for row in live.rows if row.origin is Origin.BUILTIN}
        split = next(
            (index for index, entry in enumerate(after) if entry.name in builtin_names),
            len(after),
        )
        after[split:split] = entering
    return after, inputs


def _predict(decisions: Decisions, live: _Live) -> Predicted:
    entries_after, inputs_after = _entries_after(decisions, live)
    return diff_admissions(live.admission, admit(entries_after, inputs_after))


# --- render -----------------------------------------------------------------


def _apm_ownership(rows: Sequence[Row]) -> dict[str, dict[str, object]]:
    dependency_of: dict[str, tuple[str, str]] = {}
    for row in rows:
        record = row.source_record
        if record is None or record.origin is not Origin.REPO_VENDOR:
            continue
        source_md = record.path / "SOURCE.md"
        if not source_md.is_file():
            continue
        match = APM_DEPENDENCY_LINE.search(source_md.read_text())
        if match:
            dependency_of[row.name] = (record.package, match.group(1))
    owned: dict[tuple[str, str], int] = {}
    for key in dependency_of.values():
        owned[key] = owned.get(key, 0) + 1
    return {
        name: {"apm_dep": dependency, "dep_owns_skills": owned[(package, dependency)]}
        for name, (package, dependency) in dependency_of.items()
    }


def _render_html(payload: Mapping[str, object]) -> str:
    if not TEMPLATE_PATH.is_file():
        raise ConsoleExit(EXIT_DISCOVERY, f"HTML template missing: {TEMPLATE_PATH}")
    template = TEMPLATE_PATH.read_text()
    if DATA_MARKER not in template:
        raise ConsoleExit(EXIT_DISCOVERY, f"HTML template has no {DATA_MARKER} slot: {TEMPLATE_PATH}")
    data = _json_text(payload).replace("</", "<\\/")
    return template.replace(DATA_MARKER, data, 1)


def _capture_line(live: _Live) -> str:
    capture = live.capture
    if capture is None:
        return "live      no skill_listing capture for this cwd under ~/.claude/projects"
    admission = live.admission
    summary = (
        f"live      capture {capture.captured_at}: {len(capture.names)} rows,"
        f" {len(capture.full)} full / {len(capture.name_only)} name-only"
    )
    simulated = tuple(entry.name for entry in live.entries)
    if simulated == capture.names and admission.full == capture.full and admission.name_only == capture.name_only:
        if render_listing(live.entries, live.inputs) == capture.text:
            return f"{summary}; simulation agrees (rows, order, split, and text all identical)"
        return f"{summary}; simulation agrees on rows, order, and split (descriptions changed since)"
    if set(simulated) == set(capture.names) and set(admission.full) == set(capture.full):
        return f"{summary}; simulation lists the same rows and split in a different order"
    gained_full = sorted(set(admission.full) - set(capture.full))
    lost_full = sorted(set(capture.full) - set(admission.full))
    missing = sorted(set(capture.names) - set(admission.rendered))
    added = sorted(set(admission.rendered) - set(capture.names))
    parts = []
    if gained_full:
        parts.append(f"full now: {', '.join(gained_full)}")
    if lost_full:
        parts.append(f"name-only now: {', '.join(lost_full)}")
    if missing:
        parts.append(f"no longer listed: {', '.join(missing)}")
    if added:
        parts.append(f"newly listed: {', '.join(added)}")
    return f"{summary}, simulation differs ({'; '.join(parts)})"


def _print_render_report(live: _Live, out: Path) -> None:
    snapshot = live.snapshot
    constants = (
        "constants verified"
        if snapshot.binary_hash_matched
        else f"binary hash differs from the {BINARY_VERSION} build the constants came from; re-verify"
    )
    print(f"skill-console render  (claude code {snapshot.binary_version}, {constants})")
    print(f"model     {snapshot.model}")
    print(f"budget    {_budget_line(live.inputs, live.admission)}")
    for line in _admission_summary(live.admission):
        print(line)
    print(_capture_line(live))
    print(f"drift     {len(live.divergences)} cross-tree divergences")
    print(f"out       {out}")
    print()
    rows_by_name = {row.name: row for row in live.rows}
    for line in _admission_table(live.admission, live.entries, rows_by_name):
        print(line)
    if live.divergences:
        print()
        print("cross-tree divergences")
        for divergence in live.divergences:
            print(f"  {divergence.kind:<13} {divergence.name}: {divergence.detail}")


def _cmd_render(args: argparse.Namespace) -> int:
    now_ms = args.now_ms if args.now_ms is not None else int(time.time() * 1000)
    live = _collect(
        project_root=_project_root(args.project_root),
        model=args.model,
        context_window=args.context_window,
        now_ms=now_ms,
    )
    for warning in live.warnings:
        _warn(warning)
    if not live.snapshot.binary_hash_matched:
        _warn(
            f"claude binary hash is not the {BINARY_VERSION} build the constants were read from;"
            " the simulation may be stale and apply will reject this snapshot"
        )

    out = Path(args.out).expanduser() if args.out else CONSOLE_STATE / f"skill-console-{_utc_stamp()}.html"
    payload = {
        "console_version": CONSOLE_VERSION,
        "snapshot": live.snapshot,
        "inputs": live.inputs,
        "model": live.model_id,
        "admission": live.admission,
        "entries": live.entries,
        "rows": live.rows,
        "packages": live.packages,
        "repo_root": str(REPO_ROOT),
        "divergences": live.divergences,
        "capture": live.capture,
        "enabled_plugins": live.settings.values.get("enabledPlugins") or {},
        "apm": _apm_ownership(live.rows),
        "warnings": live.warnings,
        "capabilities": {origin: sorted(ops) for origin, ops in CAPABILITIES.items()},
    }
    html = _render_html(payload)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(html)

    if args.json:
        _dump_json(
            {
                "ok": True,
                "snapshot": live.snapshot,
                "admission": live.admission,
                "rows": live.rows,
                "divergences": live.divergences,
                "warnings": live.warnings,
                "out": str(out),
            }
        )
    else:
        _print_render_report(live, out)
    if args.open_browser:
        webbrowser.open(out.as_uri())
    return EXIT_OK


# --- apply ------------------------------------------------------------------


def _fail_validation(violations: Sequence[Violation]) -> NoReturn:
    first = violations[0]
    raise ConsoleExit(
        EXIT_VALIDATION,
        f"{len(violations)} validation failure(s); first: {first.code} {first.message} ({first.pointer})",
        {"violations": [_jsonable(violation) for violation in violations]},
    )


def _dirty_paths(repo_root: Path, relpaths: Sequence[str]) -> list[str]:
    if not relpaths:
        return []
    result = subprocess.run(
        [
            "git", "-C", str(repo_root), "status", "--porcelain=v1",
            "--untracked-files=all", "--", *relpaths,
        ],
        capture_output=True,
        text=True,
        check=True,
    )
    return [line[3:] for line in result.stdout.splitlines() if line.strip()]


def _print_plan_diff(apply_plan: decisions_api.ApplyPlan, repo_root: Path) -> None:
    for edit in apply_plan.edits:
        target = repo_root / edit.relpath
        if edit.kind == "delete-tree":
            print(f"delete {edit.relpath}/")
            for file in sorted(path for path in target.rglob("*") if path.is_file()):
                print(f"  - {file.relative_to(repo_root)}")
            continue
        before = target.read_text() if target.is_file() else ""
        after = edit.content or ""
        sys.stdout.writelines(
            difflib.unified_diff(
                before.splitlines(keepends=True),
                after.splitlines(keepends=True),
                fromfile=f"a/{edit.relpath}",
                tofile=f"b/{edit.relpath}",
            )
        )


def _print_predicted(predicted: Predicted) -> None:
    print(
        f"predicted  {predicted.mode_before} -> {predicted.mode_after};"
        f" demand {predicted.demand_before:,} -> {predicted.demand_after:,};"
        f" rendered {predicted.rendered_before:,} -> {predicted.rendered_after:,}"
        f" of {predicted.cap_chars:,}"
    )
    print(
        f"           full {predicted.full_before} -> {predicted.full_after};"
        f" name-only {predicted.name_only_before} -> {predicted.name_only_after}"
    )
    if predicted.newly_admitted:
        print(f"           newly full: {', '.join(predicted.newly_admitted)}")
    if predicted.newly_dropped:
        print(f"           newly name-only: {', '.join(predicted.newly_dropped)}")


def _release_staging(batch: decisions_api.StagedBatch, keep: bool) -> str | None:
    if keep:
        print(f"staging root kept at {batch.root}")
        return str(batch.root)
    shutil.rmtree(batch.root, ignore_errors=True)
    return None


def _cmd_apply(args: argparse.Namespace) -> int:
    if args.allow_dirty_targets and not args.commit:
        raise ConsoleExit(EXIT_USAGE, "--allow-dirty-targets forfeits recovery and requires --commit")
    path = Path(args.decisions)
    raw = _read_json_file(path, "decisions document")
    if not isinstance(raw, Mapping):
        raise ConsoleExit(EXIT_VALIDATION, f"{path}: decisions document must be a JSON object")
    violations = decisions_api.validate_document(raw)
    if violations:
        _fail_validation(violations)
    try:
        decisions = decisions_api.load(path)
    except decisions_api.ApplyError as exc:
        raise ConsoleExit(EXIT_VALIDATION, f"{path}: {exc}") from exc

    # The rank clock and model come from the snapshot so the witness is
    # reproducible; anything else that drifted shows up as a V10/V19 failure.
    live = _collect(
        project_root=_project_root(args.project_root),
        model=decisions.snapshot.model,
        context_window=decisions.snapshot.context_window,
        now_ms=decisions.snapshot.now_ms,
    )
    for warning in live.warnings:
        _warn(warning)
    predicted = _predict(decisions, live)
    violations = decisions_api.validate_against_live(decisions, live.snapshot, live.rows, predicted)
    if args.allow_stale:
        violations = [violation for violation in violations if violation.code != STALE_VIOLATION]
    if violations:
        _fail_validation(violations)

    try:
        apply_plan = decisions_api.plan(decisions, live.rows, REPO_ROOT)
    except decisions_api.ApplyError as exc:
        raise ConsoleExit(EXIT_VALIDATION, str(exc)) from exc
    targets = [edit.relpath for edit in apply_plan.edits]
    dirty = _dirty_paths(REPO_ROOT, targets)
    if dirty and not args.allow_dirty_targets:
        raise ConsoleExit(
            EXIT_VALIDATION,
            f"target paths are dirty in git, refusing to overwrite: {', '.join(dirty)}",
            {"dirty_targets": dirty},
        )
    if dirty:
        _warn(f"overwriting dirty target paths; git restore cannot recover them: {', '.join(dirty)}")
    for warning in apply_plan.warnings:
        _warn(warning)

    staging_parent = CONSOLE_STATE / "staging"
    staging_parent.mkdir(parents=True, exist_ok=True)
    staging_root = Path(tempfile.mkdtemp(prefix=f"{_utc_stamp()}-", dir=staging_parent))
    try:
        batch = decisions_api.stage(apply_plan, REPO_ROOT, staging_root)
    except decisions_api.ApplyError as exc:
        raise ConsoleExit(EXIT_STAGED, f"staging failed: {exc}", {"staging_root": str(staging_root)}) from exc
    ok, reason = decisions_api.validate_staged(batch)
    if not ok:
        raise ConsoleExit(
            EXIT_STAGED,
            f"staged tree failed validation: {reason}",
            {"staging_root": str(batch.root), "edits": [_jsonable(edit) for edit in apply_plan.edits]},
        )

    result: dict[str, object] = {
        "ok": True,
        "dry_run": not args.commit,
        "predicted": predicted,
        "edits": [
            {
                "relpath": edit.relpath,
                "kind": edit.kind,
                "before_sha256": edit.before_sha256,
                "after_sha256": edit.after_sha256,
            }
            for edit in apply_plan.edits
        ],
        "warnings": list(apply_plan.warnings),
        "dirty_targets": dirty,
        "applied": [],
        "unapplied": targets,
        "staging_root": None,
    }

    if not args.commit:
        if args.json:
            result["staging_root"] = _release_staging(batch, args.keep_staged)
            _dump_json(result)
            return EXIT_OK
        print(f"skill-console apply {path}  (dry run)")
        _print_predicted(predicted)
        print(f"operations {len(decisions.operations)}, target paths {len(targets)}, staged tree validated")
        print()
        _print_plan_diff(apply_plan, REPO_ROOT)
        print()
        print("dry run: nothing written. Re-run with --commit to apply these edits.")
        result["staging_root"] = _release_staging(batch, args.keep_staged)
        return EXIT_OK

    report = decisions_api.commit(batch, REPO_ROOT, allow_dirty=args.allow_dirty_targets)
    result["applied"] = list(report.applied)
    result["unapplied"] = list(report.unapplied)
    result["staging_root"] = str(batch.root)
    if report.failure:
        recovery = f"git restore -- {' '.join(report.applied)}" if report.applied else None
        result.update({"ok": False, "code": EXIT_PARTIAL, "failure": report.failure, "recovery": recovery})
        if not args.json:
            print(f"applied ({len(report.applied)}):")
            for relpath in report.applied:
                print(f"  {relpath}")
            print(f"not applied ({len(report.unapplied)}):")
            for relpath in report.unapplied:
                print(f"  {relpath}")
            if recovery:
                print(f"recover with: {recovery}")
            print(f"staging root kept at {batch.root}")
        raise ConsoleExit(EXIT_PARTIAL, f"partial commit: {report.failure}", result)

    if args.json:
        result["staging_root"] = _release_staging(batch, args.keep_staged)
        _dump_json(result)
        return EXIT_OK
    print(f"skill-console apply {path}  (committed)")
    _print_predicted(predicted)
    print(f"changed {len(report.applied)} path(s):")
    for relpath in report.applied:
        print(f"  {relpath}")
    print("review with: git diff -- " + " ".join(report.applied))
    print("next: chezmoi diff, then chezmoi apply when it looks right (skill-console never runs it)")
    result["staging_root"] = _release_staging(batch, args.keep_staged)
    return EXIT_OK


# --- budget -----------------------------------------------------------------


def _fixture_entry(item: Mapping[str, object]) -> ListingEntry:
    if "listing_text" in item:
        text = str(item["listing_text"])
    else:
        when_to_use = item.get("when_to_use")
        text = listing_text(str(item["description"]), None if when_to_use is None else str(when_to_use))
    return ListingEntry(
        name=str(item["name"]),
        listing_text=text,
        protected=bool(item.get("protected", False)),
        forced_name_only=bool(item.get("forced_name_only", False)),
        rank=float(item.get("rank", 0.0)),
    )


def _cmd_budget(args: argparse.Namespace) -> int:
    path = Path(args.fixture)
    fixture = _read_json_file(path, "fixture")
    try:
        inputs = BudgetInputs(**{"env_budget": None, **fixture["inputs"]})
        entries = [_fixture_entry(item) for item in fixture["entries"]]
    except (KeyError, TypeError, ValueError) as exc:
        raise ConsoleExit(EXIT_USAGE, f"{path}: malformed fixture: {exc!r}") from exc
    measure = utf16_length if args.measure == "utf16" else display_width
    admission = admit(entries, inputs, measure=measure)
    if args.json:
        # The listing text always comes from the serializer's own measure, so a
        # byte-for-byte check against a capture works whatever --measure says.
        _dump_json({**_jsonable(admission), "listing": render_listing(entries, inputs)})
        return EXIT_OK
    print(f"skill-console budget {path}  (measure: {args.measure})")
    print(f"budget    {_budget_line(inputs, admission)}")
    for line in _admission_summary(admission):
        print(line)
    print()
    for line in _admission_table(admission, entries):
        print(line)
    return EXIT_OK


# --- entrypoint -------------------------------------------------------------


def _build_parser() -> _Parser:
    parser = _Parser(prog="skill-console", description=__doc__.split("\n\n")[0])
    subparsers = parser.add_subparsers(dest="command", required=True)

    render = subparsers.add_parser("render", help="simulate the listing and write the HTML console")
    render.add_argument("--out", help="HTML output path (default: under $XDG_STATE_HOME/dotfiles/skill-console)")
    render.add_argument(
        "--open", dest="open_browser", action=argparse.BooleanOptionalAction, default=True,
        help="open the HTML in the browser (default: yes)",
    )
    render.add_argument("--json", action="store_true", help="machine-readable output instead of the report")
    render.add_argument("--model", help="concrete model id; bare aliases like opus are rejected")
    render.add_argument("--context-window", type=int, help="context window in tokens")
    render.add_argument("--project-root", help="project root for project-scoped listing inputs")
    render.add_argument("--now-ms", type=int, help="pin the rank clock (ms since epoch)")
    render.set_defaults(func=_cmd_render)

    apply_ = subparsers.add_parser("apply", help="validate a decisions document and apply it to the source tree")
    apply_.add_argument("decisions", metavar="DECISIONS.json")
    apply_.add_argument("--commit", action="store_true", help="write to the worktree (default: dry run)")
    apply_.add_argument(
        "--allow-dirty-targets", action="store_true",
        help="overwrite target paths that are dirty in git; requires --commit",
    )
    apply_.add_argument("--allow-stale", action="store_true", help="accept a snapshot older than 24 hours")
    apply_.add_argument("--keep-staged", action="store_true", help="keep the staging copy on success")
    apply_.add_argument("--json", action="store_true", help="machine-readable output")
    apply_.add_argument("--project-root", help="project root; must match the snapshot")
    apply_.set_defaults(func=_cmd_apply)

    budget = subparsers.add_parser("budget", help="recompute an admission from a fixture table")
    budget.add_argument("--fixture", required=True, help="JSON with {inputs, entries}")
    budget.add_argument("--json", action="store_true", help="print the Admission as JSON")
    budget.add_argument(
        "--measure", choices=("width", "utf16"), default="width",
        help="width reproduces the serializer, utf16 the /context estimator",
    )
    budget.set_defaults(func=_cmd_budget)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    arguments = list(sys.argv[1:] if argv is None else argv)
    json_mode = "--json" in arguments
    try:
        args = _build_parser().parse_args(arguments)
        return args.func(args)
    except ConsoleExit as exc:
        print(f"skill-console: {exc.reason}", file=sys.stderr)
        if json_mode:
            payload = {"ok": False, "code": exc.code, "reason": exc.reason, "violations": []}
            payload.update(exc.payload)
            _dump_json(payload)
        return exc.code


if __name__ == "__main__":
    raise SystemExit(main())
