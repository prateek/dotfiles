#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.14"
# dependencies = []
# ///
from __future__ import annotations

import sys
from collections import defaultdict
from re import fullmatch

from agent_skill_lib import (
    AGENTS,
    MAX_SKILL_DESCRIPTION_CHARS,
    VALID_RENDER_VALUES,
    iter_package_skill_dirs,
    iter_skill_metadata,
    load_packages,
)


# chezmoi source-state attribute prefixes. A vendored file or directory whose
# name starts with one of these would be reinterpreted by chezmoi when
# home/dot_agents/packages materializes into ~/.agents/packages (`run_` even
# executes the file as a script). `literal_` is the escape hatch: chezmoi and
# the plugin projector both strip it so the target keeps its real name.
CHEZMOI_ATTRIBUTE_PREFIXES = (
    "after_",
    "before_",
    "create_",
    "dot_",
    "empty_",
    "encrypted_",
    "exact_",
    "executable_",
    "external_",
    "modify_",
    "once_",
    "onchange_",
    "private_",
    "readonly_",
    "remove_",
    "run_",
    "symlink_",
)


def apm_dependencies(path):
    """Yield each apm dependency entry as (line, pinned_ref)."""
    in_dependencies = False
    in_apm = False
    for line in path.read_text().splitlines():
        stripped = line.strip()
        if stripped == "dependencies:":
            in_dependencies = True
            in_apm = False
            continue
        if not in_dependencies:
            continue
        if stripped and not line.startswith(" "):
            break
        if stripped == "apm: []":
            return
        if stripped == "apm:":
            in_apm = True
            continue
        if in_apm and stripped.startswith("- "):
            entry = stripped.removeprefix("- ").strip()
            pinned_ref = entry.rsplit("#", 1)[1] if "#" in entry else None
            yield entry, pinned_ref


def main() -> int:
    errors: list[str] = []
    skill_locations: dict[str, list[str]] = defaultdict(list)
    skill_name_locations: dict[str, list[str]] = defaultdict(list)

    try:
        packages = load_packages()
    except Exception as exc:
        print(f"validate-agent-packages: {exc}", file=sys.stderr)
        return 1

    for package in packages:
        for agent in AGENTS:
            value = package.render.get(agent, "none")
            if value not in VALID_RENDER_VALUES:
                errors.append(f"{package.package_id}: invalid render.{agent}={value!r}")
        apm = package.path / "apm.yml"
        if not apm.exists():
            errors.append(f"{package.package_id}: missing apm.yml")
        else:
            name_line = next(
                (line.strip() for line in apm.read_text().splitlines() if line.startswith("name:")),
                None,
            )
            if name_line != f"name: {package.package_id}":
                errors.append(f"{package.package_id}: apm.yml name must match package id")
            deps = list(apm_dependencies(apm))
            for dependency, pinned_ref in deps:
                if pinned_ref and not fullmatch(r"[0-9a-fA-F]{40}", pinned_ref):
                    errors.append(
                        f"{package.package_id}: apm.yml dependency ref pins must be "
                        f"full commit SHAs; got {dependency}"
                    )
            if deps and not (package.path / "apm.lock.yaml").exists():
                errors.append(f"{package.package_id}: missing apm.lock.yaml for APM dependencies")
        if not package.skills:
            errors.append(f"{package.package_id}: package has no skills")
        for _kind, child in iter_package_skill_dirs(package.path):
            if not (child / "SKILL.md").exists():
                errors.append(f"{child}: missing SKILL.md")
        for path in sorted(package.path.rglob("*")):
            if path.name.startswith(CHEZMOI_ATTRIBUTE_PREFIXES):
                errors.append(
                    f"{path}: chezmoi treats the "
                    f"{path.name.split('_', 1)[0]}_ filename prefix as a "
                    f"source-state attribute; rename with a literal_ prefix"
                )
        for skill in package.skills:
            skill_locations[skill.skill_id].append(str(skill.path))
            if skill.kind == "vendor" and not (skill.path / "SOURCE.md").exists():
                errors.append(f"{skill.path}: missing SOURCE.md")
        try:
            for skill_dir, meta in iter_skill_metadata(package.path / "skills"):
                skill_name_locations[meta["name"]].append(str(skill_dir))
                description = meta["description"]
                if len(description) > MAX_SKILL_DESCRIPTION_CHARS:
                    errors.append(
                        f"{skill_dir / 'SKILL.md'}: description exceeds "
                        f"{MAX_SKILL_DESCRIPTION_CHARS} chars ({len(description)})"
                    )
        except Exception as exc:
            errors.append(str(exc))

    for skill_id, locations in sorted(skill_locations.items()):
        if len(locations) > 1:
            errors.append(f"duplicate skill id {skill_id}: {locations}")

    for skill_name, locations in sorted(skill_name_locations.items()):
        if len(locations) > 1:
            errors.append(f"duplicate skill name {skill_name}: {locations}")

    if errors:
        for error in errors:
            print(f"validate-agent-packages: {error}", file=sys.stderr)
        return 1
    print("OK validate-agent-packages")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
