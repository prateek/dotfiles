#!/usr/bin/env python3
"""Validate an offline build and its explicit host activation policy."""
from __future__ import annotations

import sys
from agent_skill_lib import load_packages


def main() -> int:
    try:
        packages = load_packages()
        if not packages:
            raise ValueError("marketplace has no packages")
    except (OSError, ValueError, KeyError) as error:
        print(f"validate-agent-packages: {error}", file=sys.stderr)
        return 1
    print("OK validate-agent-packages")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
