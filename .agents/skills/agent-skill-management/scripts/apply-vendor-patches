#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.14"
# dependencies = []
# ///
"""Apply (or verify) local deltas to vendored skills, stored as git patches.

Re-vendoring replaces a vendored skill tree wholesale, so any local edit has to
be re-applied afterwards. Storing each delta as a patch rather than a prose
"remember to re-do this" note in SOURCE.md means the re-apply is mechanical and
a stale delta fails loudly instead of silently disappearing.

Patches live at packages/<pkg>/patches/<skill-id>/*.patch and are authored
against UPSTREAM paths, so the same file both applies here and opens as an
upstream pull request without editing.
"""
from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT = SCRIPT_DIR.parents[3]
PACKAGES_ROOT = Path(
    os.environ.get(
        "AGENT_SKILL_PACKAGES_ROOT",
        str(REPO_ROOT / "home/dot_agents/packages"),
    )
)

TARGET_RE = re.compile(r"^(?:\+\+\+|---) (?:[ab]/)?(\S+)", re.MULTILINE)


def git_root(start: Path) -> Path:
    # Asked of git rather than derived from this script's location: the tool has
    # to work against a copy of the tree, and macOS's /var -> /private/var
    # symlink otherwise desyncs the two paths and breaks relative_to.
    result = subprocess.run(
        ["git", "-C", str(start), "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        raise RuntimeError(
            f"{start} is not inside a git worktree; patches are applied with "
            f"git apply and need one"
        )
    return Path(result.stdout.strip()).resolve()


def strip_depth(patch_text: str, skill_id: str, patch: Path) -> int:
    depths = set()
    for target in TARGET_RE.findall(patch_text):
        if target == "/dev/null":
            continue
        parts = Path(target).parts
        if skill_id not in parts:
            raise RuntimeError(
                f"{patch}: target {target!r} has no {skill_id!r} component, so the "
                f"patch cannot be mapped onto the vendored skill"
            )
        # +1 for git's a/ b/ prefix, +1 to consume the skill-id component itself.
        depths.add(parts.index(skill_id) + 2)
    if not depths:
        raise RuntimeError(f"{patch}: no target paths found")
    if len(depths) > 1:
        raise RuntimeError(
            f"{patch}: targets sit at differing depths {sorted(depths)}; split the patch"
        )
    return depths.pop()


def git_apply(root: Path, depth: int, directory: Path, patches: list[Path], *extra: str) -> bool:
    result = subprocess.run(
        [
            "git",
            "apply",
            f"-p{depth}",
            "--directory",
            str(directory),
            *extra,
            *[str(p) for p in patches],
        ],
        cwd=root,
        capture_output=True,
        text=True,
    )
    return result.returncode == 0


def all_applied(root: Path, target: Path, depth: int, patches: list[Path]) -> bool:
    """True when every patch is present, checked newest-first on a scratch copy.

    Sequential rather than one git-apply call: two patches on the same file build
    on each other, and git validates every patch against the tree as it stands
    rather than against the result of the previous one.
    """
    with tempfile.TemporaryDirectory() as tmp:
        scratch = Path(tmp)
        dest = scratch / target
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copytree(root / target, dest)
        subprocess.run(["git", "init", "-q", "."], cwd=scratch, capture_output=True)
        for patch in reversed(patches):
            done = subprocess.run(
                ["git", "apply", f"-p{depth}", "--directory", str(target),
                 "--reverse", str(patch)],
                cwd=scratch, capture_output=True, text=True,
            )
            if done.returncode != 0:
                return False
    return True


def discover(packages_root: Path, only: str | None) -> list[tuple[Path, Path, Path]]:
    found: list[tuple[Path, Path, Path]] = []
    candidates = sorted(p for p in packages_root.iterdir() if p.is_dir())
    if only:
        candidates = [p for p in candidates if p.name == only]
    for package in candidates:
        patches_root = package / "patches"
        if not patches_root.is_dir():
            continue
        for skill_dir in sorted(p for p in patches_root.iterdir() if p.is_dir()):
            vendor_dir = package / "skills/vendor" / skill_dir.name
            # rglob so a change can be one directory holding a patch per upstream
            # harness variant, which is the shape an upstream PR needs.
            for patch in sorted(skill_dir.rglob("*.patch")):
                found.append((patch, skill_dir, vendor_dir))
    return found


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--check",
        action="store_true",
        help="verify every patch is already applied; change nothing",
    )
    parser.add_argument("--packages-root", type=Path, default=PACKAGES_ROOT)
    parser.add_argument("--package", default=None,
                        help="limit to one package id (a vendor run must not "
                             "touch, or fail on, another package's patches)")
    args = parser.parse_args()

    packages_root = args.packages_root.resolve()
    if not packages_root.exists():
        print(f"apply-vendor-patches: no packages root at {packages_root}", file=sys.stderr)
        return 1
    work = discover(packages_root, args.package)
    if not work:
        # No patches means no git needed: a synthetic or exported packages tree
        # outside a worktree is a legitimate caller.
        print("OK apply-vendor-patches (no patches)")
        return 0

    try:
        root = git_root(packages_root)
    except RuntimeError as error:
        print(f"apply-vendor-patches: {error}", file=sys.stderr)
        return 1

    failures: list[str] = []
    applied = skipped = 0

    # Group by vendored skill and treat each group as one ordered set. Two
    # patches on the same file are sequential, not independent: the later one's
    # context can include text the earlier one added, so checking either alone
    # gives a false answer. git apply takes the whole group in one call.
    groups: dict[Path, list[tuple[Path, Path, int]]] = {}
    for patch, skill_dir, vendor_dir in work:
        rel = patch.relative_to(packages_root)
        if not vendor_dir.is_dir():
            failures.append(f"{rel}: no vendored skill is present at {vendor_dir}")
            continue
        try:
            depth = strip_depth(patch.read_text(), skill_dir.name, rel)
        except RuntimeError as error:
            failures.append(str(error))
            continue
        groups.setdefault(vendor_dir, []).append((patch, rel, depth))

    for vendor_dir, entries in groups.items():
        target = vendor_dir.resolve().relative_to(root)
        depths = {d for _, _, d in entries}
        if len(depths) > 1:
            failures.append(f"{target}: patches disagree on strip depth {sorted(depths)}")
            continue
        depth = depths.pop()
        forward = [p for p, _, _ in entries]
        names = ", ".join(str(r) for _, r, _ in entries)

        if all_applied(root, target, depth, forward):
            skipped += len(entries)
            continue
        if args.check:
            failures.append(f"{names}: not applied to {target}")
            continue
        # Apply one at a time, in order, for the same reason the check is
        # sequential: a later patch's context can include an earlier one's lines.
        for patch, rel, _ in entries:
            if git_apply(root, depth, target, [patch]):
                applied += 1
                continue
            # A half-patched tree is the normal state after an interrupted run,
            # so skip what is already there rather than stalling on it. At this
            # point nothing later in the group is applied, which makes a
            # single-patch reverse check meaningful again.
            if git_apply(root, depth, target, [patch], "--reverse", "--check"):
                skipped += 1
                continue
            failures.append(
                f"{rel}: does not apply to {target}. Upstream moved: rebase the "
                f"patch, or delete it if the change landed upstream."
            )
            break

    for failure in failures:
        print(f"apply-vendor-patches: {failure}", file=sys.stderr)
    if failures:
        return 1

    verb = "verified" if args.check else "applied"
    print(f"OK apply-vendor-patches ({applied} {verb}, {skipped} already present)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
