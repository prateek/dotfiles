#!/usr/bin/env python3
"""Converge owned native plugin state from a validated artifact and host policy.

--overlay converges a hand-maintained second marketplace instead (the work
overlay): its catalogs name the marketplace, and each client loads every plugin
its own catalog lists.
"""
from __future__ import annotations

import argparse
import json
import os
import re
from pathlib import Path
import subprocess
import sys

from agent_skill_lib import POLICY_PATH, load_overlay_packages, load_published_packages
from codex_rpc import enabled_edit, requests

DRY_RUN = False


def slug(name: str, marketplace: str) -> str:
    return f"{name}@{marketplace}"


def command(args: list[str], *, read: bool = False, text: bool = False):
    if not read:
        print(("[dry-run] " if DRY_RUN else "") + " ".join(args), flush=True)
        if DRY_RUN:
            return None
    result = subprocess.run(args, cwd=Path.home(), text=True, capture_output=True, timeout=90)
    if result.returncode:
        raise RuntimeError(f"{' '.join(args)} failed ({result.returncode}): {(result.stdout + result.stderr).strip()}")
    if not read:
        return None
    return result.stdout if text else json.loads(result.stdout)


def reconcile_claude(packages, root: Path, marketplace: str) -> None:
    registered = {entry["name"]: Path(entry.get("installLocation") or entry.get("path") or "")
                  for entry in command(["claude", "plugin", "marketplace", "list", "--json"], read=True)}
    installed = {entry["id"]: entry for entry in command(["claude", "plugin", "list", "--json"], read=True)
                 if entry.get("scope") == "user"}
    desired = {slug(p.package_id, marketplace): p for p in packages if p.render["claude"] == "plugin"}
    moved = marketplace in registered and registered[marketplace].resolve() != root.resolve()
    if marketplace not in registered or moved:
        command(["claude", "plugin", "marketplace", "add", str(root), "--scope", "user"])
    changed = any(key in installed and installed[key].get("version") != p.version for key, p in desired.items())
    if changed or moved:
        command(["claude", "plugin", "marketplace", "update", marketplace])
    for key, package in desired.items():
        entry = installed.get(key)
        enabled = bool(entry and entry.get("enabled"))
        if entry is None:
            command(["claude", "plugin", "install", key, "--scope", "user"])
            enabled = True
        elif entry.get("version") != package.version or moved:
            # Native remove/install also supports downgrade and drops stale cache files.
            command(["claude", "plugin", "uninstall", key, "--scope", "user"])
            command(["claude", "plugin", "install", key, "--scope", "user"])
            enabled = True
        if enabled != package.default_loaded:
            command(["claude", "plugin", "enable" if package.default_loaded else "disable", key, "--scope", "user"])
    for key in sorted(installed.keys() - desired.keys()):
        if key.endswith(f"@{marketplace}"):
            command(["claude", "plugin", "uninstall", key, "--scope", "user"])


def reconcile_codex(packages, root: Path, marketplace: str, refresh_disabled: set[str]) -> None:
    installed = {entry["pluginId"]: entry for entry in command(["codex", "plugin", "list", "--json"], read=True)["installed"]}
    registered = {entry["name"]: Path(entry["root"]) for entry in
                  command(["codex", "plugin", "marketplace", "list", "--json"], read=True)["marketplaces"]}
    desired = {slug(p.package_id, marketplace): p for p in packages if p.render["codex"] == "plugin"}
    moved = marketplace in registered and registered[marketplace].resolve() != root.resolve()
    if moved:
        command(["codex", "plugin", "marketplace", "remove", marketplace])
    if marketplace not in registered or moved:
        command(["codex", "plugin", "marketplace", "add", str(root)])
    def disable(key):
        edit = enabled_edit(key, False)
        if DRY_RUN:
            print(f"[dry-run] codex config/value/write {edit[1]['keyPath']} = false")
        else:
            requests([edit])

    for key, package in desired.items():
        refresh = package.default_loaded or (key in installed and (moved or package.package_id in refresh_disabled))
        if refresh:
            try:
                command(["codex", "plugin", "add", key])
            finally:
                if not package.default_loaded:
                    disable(key)
        elif not package.default_loaded and installed.get(key, {}).get("enabled"):
            disable(key)
    for key in sorted(installed.keys() - desired.keys()):
        if key.endswith(f"@{marketplace}"):
            command(["codex", "plugin", "remove", key])


def omp_marketplaces() -> dict[str, Path]:
    # omp plugin marketplace list ignores --json.
    listing = command(["omp", "plugin", "marketplace", "list"], read=True, text=True)
    if "No marketplaces configured" in listing:
        return {}
    if not listing.startswith("Configured Marketplaces:"):
        raise ValueError(f"unrecognized omp marketplace listing: {listing!r}")
    entries: dict[str, Path] = {}
    for line in listing.splitlines()[1:]:
        if not line.strip():
            continue
        parts = line.strip().split(maxsplit=1)
        if len(parts) != 2 or not re.fullmatch(r"[a-z0-9][a-z0-9.-]*", parts[0]):
            raise ValueError(f"unrecognized omp marketplace listing line: {line!r}")
        entries[parts[0]] = Path(parts[1])
    return entries


def reconcile_omp(packages, root: Path, marketplace: str) -> None:
    registered = omp_marketplaces()
    installed = {}
    for plugin in command(["omp", "plugin", "list", "--json"], read=True)["marketplace"]:
        entries = [entry for entry in plugin["entries"] if entry.get("scope") == "user"]
        if len(entries) > 1:
            raise ValueError(f"ambiguous omp user-scope install: {plugin['id']}")
        if entries:
            installed[plugin["id"]] = {**entries[0], "enabled": entries[0].get("enabled", True)}
    desired = {slug(p.package_id, marketplace): p for p in packages if p.render["claude"] == "plugin"}
    moved = marketplace in registered and registered[marketplace].resolve() != root.resolve()
    if moved:
        command(["omp", "plugin", "marketplace", "remove", marketplace])
    if marketplace not in registered or moved:
        command(["omp", "plugin", "marketplace", "add", str(root)])
    if moved or any(key not in installed or installed[key].get("version") != p.version
                    for key, p in desired.items()):
        command(["omp", "plugin", "marketplace", "update", marketplace])
    for key, package in desired.items():
        entry = installed.get(key)
        if entry is None or entry.get("version") != package.version or moved:
            # --force refreshes in place; it preserves an existing disabled flag.
            command(["omp", "plugin", "install", key, "--scope", "user", "--force"])
        prior = entry["enabled"] if entry is not None else True
        if prior != package.default_loaded:
            command(["omp", "plugin", "enable" if package.default_loaded else "disable", key, "--scope", "user"])
    for key in sorted(installed.keys() - desired.keys()):
        if key.endswith(f"@{marketplace}"):
            command(["omp", "plugin", "uninstall", key, "--scope", "user"])


def reconcile_cursor(packages, root: Path) -> None:
    """Link each Claude-loaded skill into ~/.cursor/skills, the user skill root cursor-agent scans.

    Cursor's CLI loads plugins only from its server-side marketplaces, so a local
    marketplace reaches it as plain skill directories. A link is owned when it
    points under ``root``; anything else in the directory is left alone.
    """
    skills_dir = Path.home() / ".cursor/skills"
    desired: dict[str, Path] = {}
    for package in sorted(packages, key=lambda p: p.package_id):
        if package.render.get("claude") != "plugin" or not package.default_loaded:
            continue
        for skill in package.skills:
            if skill.skill_id in desired:
                print(f"reconcile-agent-plugins: cursor: {skill.skill_id} is shipped by more than one loaded plugin; "
                      f"keeping {desired[skill.skill_id]}", file=sys.stderr)
                continue
            desired[skill.skill_id] = skill.path
    existing = {entry.name: entry for entry in skills_dir.iterdir()} if skills_dir.is_dir() else {}

    def owned(entry: Path) -> bool:
        return entry.is_symlink() and Path(os.path.abspath(os.readlink(entry))).is_relative_to(root)

    def act(description: str, change) -> None:
        print(("[dry-run] " if DRY_RUN else "") + description, flush=True)
        if not DRY_RUN:
            change()

    for name, target in desired.items():
        entry = skills_dir / name
        if name in existing and not owned(entry):
            print(f"reconcile-agent-plugins: cursor: {entry} is not a link this reconciler owns; leaving it", file=sys.stderr)
            continue
        if name in existing and os.readlink(entry) == str(target):
            continue

        def link(entry=entry, target=target):
            skills_dir.mkdir(parents=True, exist_ok=True)
            entry.unlink(missing_ok=True)
            entry.symlink_to(target)

        act(f"cursor: link {entry} -> {target}", link)
    for name in sorted(existing.keys() - desired.keys()):
        entry = skills_dir / name
        if owned(entry):
            act(f"cursor: unlink {entry}", entry.unlink)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--agent", action="append", choices=["claude", "codex", "omp", "cursor-agent"], default=[])
    parser.add_argument("--plugins-root", type=Path, default=Path.home() / ".agents/plugins")
    parser.add_argument("--policy", type=Path, default=POLICY_PATH)
    parser.add_argument("--refresh-disabled", action="append", default=[], metavar="PACKAGE")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--overlay", action="store_true",
                        help="--plugins-root is a hand-maintained overlay marketplace; --policy is ignored")
    parser.add_argument("--json", action="store_true",
                        help="print the marketplace name and each client's eligible plugins, then exit")
    args = parser.parse_args()
    global DRY_RUN
    DRY_RUN = args.dry_run
    try:
        root = args.plugins_root.expanduser().absolute()
        if args.overlay:
            marketplace, packages = load_overlay_packages(root)
        else:
            marketplace, packages = "prateek-local", load_published_packages(root, args.policy)
        if set(args.refresh_disabled) - {p.package_id for p in packages if p.render["codex"] == "plugin"}:
            raise ValueError("--refresh-disabled must name an eligible published package")
        if args.json:
            print(json.dumps({"marketplace": marketplace, **{
                f"{agent}_plugins": [p.package_id for p in packages if p.render[agent] == "plugin"]
                for agent in ("claude", "codex")}}))
            return 0
        if not args.apply:
            for package in packages:
                print(f"{package.package_id}: version {package.version}, default_loaded={package.default_loaded}, eligibility={package.render}")
            return 0
        if not args.agent:
            parser.error("--apply needs at least one --agent")
        if "claude" in args.agent:
            reconcile_claude(packages, root, marketplace)
        if "codex" in args.agent:
            reconcile_codex(packages, root, marketplace, set(args.refresh_disabled))
        if "omp" in args.agent:
            reconcile_omp(packages, root, marketplace)
        if "cursor-agent" in args.agent:
            reconcile_cursor(packages, root)
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.TimeoutExpired) as error:
        print(f"reconcile-agent-plugins: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
