#!/usr/bin/env python3
"""Converge owned native plugin state from a validated artifact and host policy."""
from __future__ import annotations

import argparse
import json
from pathlib import Path
import subprocess
import sys

from agent_skill_lib import POLICY_PATH, load_published_packages
from codex_rpc import enabled_edit, requests

MARKETPLACE = "prateek-local"
DRY_RUN = False


def slug(name: str) -> str:
    return f"{name}@{MARKETPLACE}"


def command(args: list[str], *, read: bool = False):
    if not read:
        print(("[dry-run] " if DRY_RUN else "") + " ".join(args), flush=True)
        if DRY_RUN:
            return None
    result = subprocess.run(args, cwd=Path.home(), text=True, capture_output=True, timeout=90)
    if result.returncode:
        raise RuntimeError(f"{' '.join(args)} failed ({result.returncode}): {(result.stdout + result.stderr).strip()}")
    return json.loads(result.stdout) if read else None


def reconcile_claude(packages, root: Path) -> None:
    registered = {entry["name"]: Path(entry.get("installLocation") or entry.get("path") or "")
                  for entry in command(["claude", "plugin", "marketplace", "list", "--json"], read=True)}
    installed = {entry["id"]: entry for entry in command(["claude", "plugin", "list", "--json"], read=True)
                 if entry.get("scope") == "user"}
    desired = {slug(p.package_id): p for p in packages if p.render["claude"] == "plugin"}
    moved = MARKETPLACE in registered and registered[MARKETPLACE].resolve() != root.resolve()
    if MARKETPLACE not in registered or moved:
        command(["claude", "plugin", "marketplace", "add", str(root), "--scope", "user"])
    changed = any(key in installed and installed[key].get("version") != p.version for key, p in desired.items())
    if changed or moved:
        command(["claude", "plugin", "marketplace", "update", MARKETPLACE])
    for key, package in desired.items():
        entry = installed.get(key)
        enabled = bool(entry and entry.get("enabled"))
        if entry is None:
            command(["claude", "plugin", "install", key, "--scope", "user"])
            enabled = True
        elif entry.get("version") != package.version or moved:
            # Native remove/install also supports downgrade and drops stale cache files.
            command(["claude", "plugin", "uninstall", key, "--scope", "user"])
            command(["claude", "plugin", "install", key, "--scope", "user"])
            enabled = True
        if enabled != package.default_loaded:
            command(["claude", "plugin", "enable" if package.default_loaded else "disable", key, "--scope", "user"])
    for key in sorted(installed.keys() - desired.keys()):
        if key.endswith(f"@{MARKETPLACE}"):
            command(["claude", "plugin", "uninstall", key, "--scope", "user"])


def reconcile_codex(packages, root: Path, refresh_disabled: set[str]) -> None:
    installed = {entry["pluginId"]: entry for entry in command(["codex", "plugin", "list", "--json"], read=True)["installed"]}
    registered = {entry["name"]: Path(entry["root"]) for entry in
                  command(["codex", "plugin", "marketplace", "list", "--json"], read=True)["marketplaces"]}
    desired = {slug(p.package_id): p for p in packages if p.render["codex"] == "plugin"}
    moved = MARKETPLACE in registered and registered[MARKETPLACE].resolve() != root.resolve()
    if moved:
        command(["codex", "plugin", "marketplace", "remove", MARKETPLACE])
    if MARKETPLACE not in registered or moved:
        command(["codex", "plugin", "marketplace", "add", str(root)])
    def disable(key):
        edit = enabled_edit(key, False)
        if DRY_RUN:
            print(f"[dry-run] codex config/value/write {edit[1]['keyPath']} = false")
        else:
            requests([edit])

    for key, package in desired.items():
        refresh = package.default_loaded or (key in installed and (moved or package.package_id in refresh_disabled))
        if refresh:
            try:
                command(["codex", "plugin", "add", key])
            finally:
                if not package.default_loaded:
                    disable(key)
        elif not package.default_loaded and installed.get(key, {}).get("enabled"):
            disable(key)
    for key in sorted(installed.keys() - desired.keys()):
        if key.endswith(f"@{MARKETPLACE}"):
            command(["codex", "plugin", "remove", key])


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--agent", action="append", choices=["claude", "codex"], default=[])
    parser.add_argument("--plugins-root", type=Path, default=Path.home() / ".agents/plugins")
    parser.add_argument("--policy", type=Path, default=POLICY_PATH)
    parser.add_argument("--refresh-disabled", action="append", default=[], metavar="PACKAGE")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    global DRY_RUN
    DRY_RUN = args.dry_run
    try:
        root = args.plugins_root.expanduser().absolute()
        packages = load_published_packages(root, args.policy)
        if set(args.refresh_disabled) - {p.package_id for p in packages if p.render["codex"] == "plugin"}:
            raise ValueError("--refresh-disabled must name an eligible published package")
        if not args.apply:
            for package in packages:
                print(f"{package.package_id}: version {package.version}, default_loaded={package.default_loaded}, eligibility={package.render}")
            return 0
        if not args.agent:
            parser.error("--apply needs at least one --agent")
        if "claude" in args.agent:
            reconcile_claude(packages, root)
        if "codex" in args.agent:
            reconcile_codex(packages, root, set(args.refresh_disabled))
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.TimeoutExpired) as error:
        print(f"reconcile-agent-plugins: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
