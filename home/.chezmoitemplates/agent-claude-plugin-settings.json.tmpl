{{- $plugins := dict -}}
{{- range $name, $policy := .agent_plugins -}}
{{- if $policy.claude -}}
{{- $_ := set $plugins (printf "%s@prateek-local" $name) $policy.default_loaded -}}
{{- end -}}
{{- end -}}
{{- dict "extraKnownMarketplaces" (dict "prateek-local" (dict "source" (dict "source" "directory" "path" (printf "%s/.agents/plugins" .chezmoi.homeDir)))) "enabledPlugins" $plugins | toPrettyJson -}}
