{{- /* Desired keys for ~/.cursor/cli-config.json, deep-merged by
       home/dot_cursor/modify_private_cli-config.json.tmpl. Cursor writes auth,
       model, approval, and sandbox state into the same file, so name only what
       dotfiles owns. cursor-agent 2026.07.01 ignores `marketplaces`: it reads
       $XDG_CONFIG_HOME/cursor/cli-config.json, has no such key, and loads
       plugins only from Cursor's server. Skills reach it as links in
       ~/.cursor/skills (reconcile-agent-plugins --agent cursor-agent). */ -}}
{
  "marketplaces": {
    "prateek-local": {
      "source": "directory",
      "path": "{{ .chezmoi.homeDir }}/.agents/plugins"
    }
{{- $wo := includeTemplate "work-overlay.tmpl" . | fromJson }}
{{- if $wo.marketplace }},
    {{ $wo.marketplace | toJson }}: {
      "source": "directory",
      "path": {{ $wo.plugins | toJson }}
    }
{{- end }}
  }
}
