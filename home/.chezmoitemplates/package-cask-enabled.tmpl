{{- /*
  package-cask-enabled.tmpl — returns "true" when cask `name` is in the cask
  union of the selected machine type's groups, else "false". Used by
  home/.chezmoiignore (and the raycast extensions script) to gate app config on
  whether the app is actually installed for this machine type.

  Package groups come from the machines.toml resolver (features.tmpl), mirroring
  brewfile.tmpl.
*/ -}}
{{- $root := .root -}}
{{- $name := .name -}}
{{- $f := includeTemplate "features.tmpl" $root | fromJson -}}
{{- $groups := $f.groups -}}
{{- $enabled := false -}}
{{- /* Casks install only on macOS (brewfile.tmpl), so off macOS no cask is enabled. */ -}}
{{- if eq $f.os "darwin" -}}
{{- range $gname := $groups -}}
{{-   if not (hasKey $root.packages.groups $gname) -}}{{- fail (printf "package-cask-enabled.tmpl: machine type references undefined group %q" $gname) -}}{{- end -}}
{{-   $g := index $root.packages.groups $gname -}}
{{-   range default (list) (dig "casks" (list) $g) -}}
{{-     if eq .name $name -}}{{- $enabled = true -}}{{- end -}}
{{-   end -}}
{{- end -}}
{{- end -}}
{{- $enabled -}}
