[rerere]
	enabled = true

[checkout]
	# Parallelize working-tree checkout across cores. Cuts `git worktree add`
	# time on large repos (~3x on the monorepo); Orca inherits it because it
	# shells a plain `git worktree add` with no config overrides.
	workers = 4

[spice "branchCreate"]
	prefix = prateek/

[spice "submit"]
	draft = true

[spice "repoSync"]
	restack = upstack

[spice "rebaseContinue"]
	edit = false

[spice "experiment"]
	commitFixup = true
	commitPick = true

{{ $workRepo := dig "work_overlay" "repo" "" . -}}
{{ $workOrg := regexReplaceAll `^.*github\.com[:/]([^/]+)/.*$` (regexFind `github\.com[:/][^/]+/` $workRepo | default "") "${1}" -}}
{{ if and (includeTemplate "features.tmpl" . | fromJson).work_github_https $workOrg -}}
{{- $gh := lookPath "gh" | default "/opt/homebrew/bin/gh" -}}
# The work org's repos go over HTTPS with gh's SSO-authorized token (see
# work_github_https in machines.toml); every other GitHub remote keeps SSH. The
# empty helper drops osxkeychain for github.com. The absolute gh path serves git
# spawned without Homebrew on PATH (GUI apps, launchd).
[url "https://github.com/{{ $workOrg }}/"]
	insteadOf = git@github.com:{{ $workOrg }}/
	insteadOf = ssh://git@github.com/{{ $workOrg }}/

[credential "https://github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential

# The corporate web filter rejects HTTPS git to openclaw repos while SSH works.
[url "git@github.com:openclaw/"]
	insteadOf = https://github.com/openclaw/

{{ end -}}
# Host-local overrides (machine- and work-specific). This file is created per
# machine and is NOT managed by chezmoi, so nothing host-specific is synced.
[include]
	path = ~/.config/git/config.local
