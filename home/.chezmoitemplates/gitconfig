[rerere]
	enabled = true

[checkout]
	# Parallelize working-tree checkout across cores. Cuts `git worktree add`
	# time on large repos (~3x on the monorepo); Orca inherits it because it
	# shells a plain `git worktree add` with no config overrides.
	workers = 4

[spice "branchCreate"]
	prefix = prateek/

[spice "submit"]
	draft = true

[spice "repoSync"]
	restack = upstack

[spice "rebaseContinue"]
	edit = false

[spice "experiment"]
	commitFixup = true
	commitPick = true

# Host-local overrides (machine- and work-specific). This file is created per
# machine and is NOT managed by chezmoi, so nothing host-specific is synced.
[include]
	path = ~/.config/git/config.local
