{{- $f := includeTemplate "features.tmpl" . | fromJson -}}
{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "skillListingBudgetFraction": 0.04,
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": []
      }
    ]
  }{{ if eq $f.machine_type "work" }},
  "enabledPlugins": {
    "git-spice@chronosphere-claude-plugins": false
  }{{ end }}
}
