{{- $f := includeTemplate "features.tmpl" . | fromJson -}}
{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "skillListingBudgetFraction": 0.04,
  "autoUpdatesChannel": "latest",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": []
      }
    ]
  }{{ if eq $f.machine_type "work" }},
  "enabledPlugins": {
    "git-spice@chronosphere-claude-plugins": false
  }{{ end }}
}
