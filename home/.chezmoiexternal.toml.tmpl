[".local/share/zinit/zinit.git"]
type = "git-repo"
url = "https://github.com/zdharma-continuum/zinit.git"
refreshPeriod = "168h"
{{- $wo := includeTemplate "work-overlay.tmpl" . | fromJson }}
{{- if $wo.enabled }}
{{/* Work overlay: employer-specific docs and agent plugins, composed in by
     run_onchange_after_37-agent-slack-doc and registered as a second plugin
     marketplace by run_onchange_after_39-agent-work-overlay. The repo is a
     large shared work repo, so clone only the tip of the overlay's branch,
     sparse; run_after_36a-work-overlay-sparse narrows the checkout to the
     overlay directory.
     See docs/adr/0039-work-overlay-in-work-repo.md. */}}
[{{ $wo.clone | trimPrefix (printf "%s/" .chezmoi.homeDir) | quote }}]
type = "git-repo"
url = {{ $wo.repo | quote }}
refreshPeriod = "168h"
clone.args = ["--depth", "1", "--single-branch", "--filter=blob:none", "--sparse"{{ with $wo.ref }}, "--branch", {{ . | quote }}{{ end }}]
pull.args = ["--ff-only"]
{{- end }}
