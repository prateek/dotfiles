{{- /* acpx shortcuts gated by this machine's agent CLIs (machines.toml
       agent_clis, via features.tmpl): a shortcut is emitted only when a backing
       CLI is present. cursor-agent and codex both offer the GPT tier; the merge
       order below (cursor-agent first) lets it win the shared shortcuts.
       cursor-agent has no latest-tracking model aliases (the bare ones like
       "opus"/"gpt" resolve to stale generations), so ids are pinned here;
       scripts/audit/acpx-model-drift.sh checks them against the live catalog.
       cursor-agent's ACP mode ignores the plugin marketplaces its print mode
       loads, so its shortcuts reach skills only as files, through --add-dir.
       Each root must exist: cursor-agent refuses to start when --add-dir names
       a missing directory. run_onchange_after_36-agent-plugins.sh guarantees
       the prateek-local root, so it is unconditional; the Claude one holds
       git-marketplace checkouts a machine may never install, so it is probed.
       A root that appears later lands on the next apply.
       See docs/plans/crit-agent-bridge-plan.md. */ -}}

{{- $clis := (includeTemplate "features.tmpl" . | fromJson).agent_clis | default (list) -}}

{{- $roots := list (printf "%s/.agents/plugins" .chezmoi.homeDir) -}}
{{- $claudeMarketplaces := printf "%s/.claude/plugins/marketplaces" .chezmoi.homeDir -}}
{{- if stat $claudeMarketplaces -}}{{ $roots = append $roots $claudeMarketplaces }}{{- end -}}
{{- $addDirs := list -}}
{{- range $roots -}}{{ $addDirs = concat $addDirs (list "--add-dir" .) }}{{- end -}}

{{- /* Shortcuts each backend provides. */ -}}
{{- $byCli := dict
    "cursor-agent" (dict
        "agpt"    (dict "command" "cursor-agent" "args" (concat (list "--model" "gpt-5.6-sol-high-fast") $addDirs (list "acp")))
        "agptx"   (dict "command" "cursor-agent" "args" (concat (list "--model" "gpt-5.6-sol-xhigh-fast") $addDirs (list "acp")))
        "agptw"   (dict "command" "cursor-agent" "args" (concat (list "--model" "gpt-5.6-luna-high") $addDirs (list "acp")))
        "aopus"   (dict "command" "cursor-agent" "args" (concat (list "--model" "claude-opus-5-thinking-xhigh-fast") $addDirs (list "acp")))
        "aopusx"  (dict "command" "cursor-agent" "args" (concat (list "--model" "claude-opus-5-thinking-max-fast") $addDirs (list "acp")))
        "agemini" (dict "command" "cursor-agent" "args" (concat (list "--model" "gemini-3.1-pro") $addDirs (list "acp"))))
    "codex" (dict
        "agpt"    (dict "command" "codex-acp" "args" (list "-c" "model_reasoning_effort=high"))
        "agptx"   (dict "command" "codex-acp" "args" (list "-c" "model_reasoning_effort=xhigh")))
    "claude" (dict
        "afable"  (dict "command" "env" "args" (list "ANTHROPIC_MODEL=fable" "CLAUDE_CODE_EFFORT_LEVEL=xhigh" "claude-agent-acp"))
        "afablex" (dict "command" "env" "args" (list "ANTHROPIC_MODEL=fable" "CLAUDE_CODE_EFFORT_LEVEL=max" "claude-agent-acp")))
-}}

{{- $agents := dict -}}
{{- range $cli := list "cursor-agent" "codex" "claude" -}}
{{-   if has $cli $clis -}}{{ $agents = merge $agents (get $byCli $cli) }}{{- end -}}
{{- end -}}

{{ dict "agents" $agents | toPrettyJson }}
