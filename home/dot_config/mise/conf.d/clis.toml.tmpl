{{- $a := includeTemplate "agents.tmpl" . | fromJson -}}
# Standalone CLIs installed via mise.
#
# Sections group CLIs by purpose, not by install backend. Within a section,
# entries are sorted alphabetically by full key. Add an inline comment when
# the binary name, install source, or skill pairing is non-obvious.
#
# Promotion rule: when a section grows to ~3+ stable entries that share env,
# settings, or hooks, promote it to its own `conf.d/<category>.toml`. Until
# then, keep it inline so the whole CLI surface fits in one file.
#
# Future work: split "dotfiles dev dependencies" (only needed when authoring
# or maintaining this repo) from production CLIs (needed on every machine
# that runs the dotfiles). Tracked at the dev-deps section header below.

[tools]
# === Dotfiles dev dependencies ===
# Required to author / maintain this repo, not to run it. When we have a
# module system that gates installs by role, mark these as dev-only and
# skip on machines that just consume the dotfiles.
"pipx:apm-cli" = "0.29.1"  # agent-marketplace/ also pins its own build environment

# === AI coding harnesses ===
# Interactive AI coding tools the human runs directly. Which ones a machine
# gets is agent_clis in machines.toml, described by .chezmoidata/agents.toml
# (ADR 0041); run_onchange_after_20-mise-install uninstalls a delisted one.
# The desktop `claude` app is a Homebrew cask in packages.toml; the Claude Code
# CLI installs from run_after_06-claude-native.sh (ADR 0029), not here.
{{- range $id, $agent := $a.selected }}
{{- if eq $agent.install "mise" }}
{{ $agent.mise | quote }} = "latest"  # {{ $id }}
{{- end }}
{{- range default (list) (dig "adapters" (list) $agent) }}
{{- if hasPrefix "mise:" . }}
{{ trimPrefix "mise:" . | quote }} = "latest"  # {{ $id }} ACP adapter; routes declared in acpx_harnesses.toml
{{- end }}
{{- end }}
{{- end }}

# === Agent skill backends ===
# CLIs the agent reaches for, either via a SKILL.md wrapper or via the
# convention docs in ~/.agents/docs/. Inline comment names the consumer
# when the package name doesn't make it obvious.
"github:openclaw/gogcli" = { version = "latest", exe = "gog" } # Google Workspace CLI (gogcli.sh, formerly steipete/gogcli); see ~/.agents/docs/google-workspace.md
"github:rootlyhq/rootly-cli" = { version = "latest", exe = "rootly" } # Rootly incident CLI; standalone release binary
"npm:@pleaseai/ask" = "latest"                             # ask skill (utils-agent); see [env] below
"npm:@shortcut-cli/shortcut-cli" = "latest"                # shortcut skill; binary is `short`
"npm:@steipete/bird" = "latest"                            # twitter; see ~/.agents/docs/twitter.md
"npm:@tobilu/qmd" = "latest"                               # qmd; local wiki and session-history search
"npm:acpx" = "latest"                                      # acpx CLI; acpx + acpx-cli skills (utils-agent), headless ACP client
"npm:agent-browser" = "latest"                             # browser skill (utils-agent); terminal page driver
"npm:agent-slack" = "latest"                               # agent-slack CLI; slack skill (utils-agent), see ~/.agents/docs/slack.md
"pipx:absurdctl" = "latest"                                # durable-workflow CLI for agent use
"pipx:obsidian-wiki" = "latest"                            # obsidian-wiki plugin pkg + wiki-agent-sessions repo (sessions-build/query, lint)

# === Secrets & encryption ===
sops = "latest"                                            # aqua:getsops/sops; SOPS secrets editor

[env]
# ask: cache lives under XDG_CACHE_HOME so it stays out of $HOME root.
ASK_HOME = "{{ "{{" }} get_env(name='XDG_CACHE_HOME', default='~/.cache') {{ "}}" }}/ask"
# crit: integrations are APM-vendored (ADR 0013); silence the startup tip that
# tells agents to run `crit install`, which would clobber renderer-owned roots.
CRIT_NO_INTEGRATION_CHECK = "1"
