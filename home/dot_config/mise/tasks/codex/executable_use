#!/usr/bin/env bash
#MISE description="Switch Codex between the standalone default, releases, main, and PR builds"
#MISE dir="{{cwd}}"
#USAGE flag "--local" help="Write selection to mise.local.toml in the current repo"
#USAGE flag "--global" help="Write selection to the global mise config"
#USAGE arg "<channel>" help="Codex channel" default="latest" {
#USAGE   choices "standalone" "latest" "release" "main" "pr"
#USAGE }
#USAGE arg "[value]" help="Release version or PR number"
set -euo pipefail

# `standalone` is the machine default that chezmoi owns
# (run_after_07-codex-standalone.sh): the only layout whose fixed
# CODEX_HOME/packages/standalone/current/codex path lets `/agents` and the
# app-server daemon run. It installs to ~/.local/bin, which zprofile puts ahead
# of the mise shims, so the mise-selected channels below are explicit builds to
# run through `mise exec`, not replacements for the command on PATH.

scope="global"
if [[ "${usage_local:-false}" == "true" ]]; then
  scope="local"
elif [[ "${usage_global:-false}" == "true" ]]; then
  scope="global"
elif [[ "${1:-}" == "--local" ]]; then
  scope="local"
  shift
elif [[ "${1:-}" == "--global" ]]; then
  scope="global"
  shift
fi

channel="${usage_channel:-${1:-latest}}"
value="${usage_value:-${2:-}}"

data_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}"
external_dir="$data_dir/external"

usage() {
  cat >&2 <<'USAGE'
usage:
  mise run codex:use standalone [version]
  mise run codex:use [--global|--local] latest
  mise run codex:use [--global|--local] release <version>
  mise run codex:use [--global|--local] main
  mise run codex:use [--global|--local] pr <number>
USAGE
}

select_codex() {
  local spec="$1"

  if [[ "$scope" == "local" ]]; then
    mise use --env local "$spec"
  else
    # Host-local overlay, not `mise use -g`: chezmoi owns the global
    # config.toml (kept empty) and conf.d/*.toml loads after it, so a global
    # write there is both drift and a no-op. zz-local.toml sorts last in
    # conf.d and wins; chezmoi leaves it unmanaged.
    mise use --path "${MISE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/mise}/conf.d/zz-local.toml" "$spec"
  fi
}

install_source() {
  local label="$1"
  local repo="$2"
  local git_arg="$3"
  local git_value="$4"
  local prefix="$external_dir/codex-$label"

  mkdir -p "$external_dir"

  cargo install \
    --git "$repo" \
    "$git_arg" "$git_value" \
    codex-cli \
    --bin codex \
    --root "$prefix" \
    --locked \
    --force

  mise link --force "codex@$label" "$prefix"
  select_codex "codex@$label"
}

case "$channel" in
  standalone)
    installer="$(mktemp "${TMPDIR:-/tmp}/codex-install.XXXXXX")"
    trap 'rm -f "$installer"' EXIT
    curl -fsSL https://chatgpt.com/codex/install.sh -o "$installer"
    # Same sanitized PATH the chezmoi hook uses: the installer's own bin dir
    # and the system paths, so it neither edits managed shell startup files nor
    # offers to uninstall another Codex it finds on PATH.
    env PATH="$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
      CODEX_HOME="$HOME/.codex" \
      CODEX_NON_INTERACTIVE=1 \
      CODEX_RELEASE="${value:-latest}" \
      sh "$installer"
    ;;

  latest)
    select_codex "codex@latest"
    ;;

  release)
    if [[ -z "$value" ]]; then
      usage
      exit 2
    fi
    select_codex "codex@$value"
    ;;

  main)
    install_source "main" "https://github.com/openai/codex" "--branch" "main"
    ;;

  pr)
    if [[ -z "$value" ]]; then
      usage
      exit 2
    fi

    read -r head_repo head_sha < <(
      gh pr view "$value" \
        --repo openai/codex \
        --json headRepository,headRefOid \
        --template '{{.headRepository.nameWithOwner}} {{.headRefOid}}'
    )

    if [[ -z "$head_repo" || "$head_repo" == "null" || -z "$head_sha" || "$head_sha" == "null" ]]; then
      echo "Could not resolve openai/codex PR $value" >&2
      exit 1
    fi

    install_source "pr-$value" "https://github.com/$head_repo" "--rev" "$head_sha"
    ;;

  -h|--help|help)
    usage
    ;;

  *)
    echo "unknown Codex channel: $channel" >&2
    usage
    exit 2
    ;;
esac
