{{- $f := includeTemplate "features.tmpl" . | fromJson -}}
{{- $routes := deepCopy .acpx_harnesses.routes -}}
{{- $declared := list -}}
{{- range $id := $f.agent_clis -}}
{{-   range $name, $route := $routes -}}
{{-     $machine := dig "machine" "any" $route -}}
{{-     if and (eq $route.agent $id) (or (eq $machine "any") (and (eq $machine "work") (eq $f.machine_type "work")) (and (eq $machine "non-work") (ne $f.machine_type "work"))) -}}
{{-       $declared = append $declared $name -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{ dict
  "models" .acpx_models
  "routes" $routes
  "declared" $declared
  "agent_clis" $f.agent_clis
  "machine" (printf "%s:%s" .chezmoi.hostname $f.machine_type)
  "home" .chezmoi.homeDir
  "launcher" (printf "%s/.agents/bin/acpx-routing" .chezmoi.homeDir)
  | toPrettyJson }}
