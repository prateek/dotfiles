;; Karabiner-Elements config, authored in Goku EDN and compiled to
;; ~/.config/karabiner/karabiner.json by `goku` at `chezmoi apply` time
;; (see run_onchange_after_45-karabiner-goku). Edit THIS file, never the JSON.
;;
;; Left ⌘: tap it alone to open Tuna combo mode — Karabiner sends F18, which is set as
;; Tuna's comboMode hotkey (see ~/.config/tuna/config.toml and the app's
;; KeyboardShortcuts_comboMode pref). Hold ⌘ with any other key and it stays a normal ⌘.
;; See the "Tap left ⌘" rule near the bottom of :main.
;;
;; Nav layer (every keyboard): ⌃Space toggles a sticky left-hand navigation layer and shows a
;; "NAV" notification; ⌃Space again, Esc, or a copy leaves it. On the internal keyboard ⌃ is
;; Caps held, so the toggle is Caps+Space and a Caps tap (normally Esc) also leaves. Layer keys:
;;
;;     1 line start   2 line end
;;     q word left    w ↑           e word right   r page up     t tab
;;     a ←            s ↓           d →            f page down   g backspace
;;     z undo         x cut         c copy         v paste       b forward delete
;;     space = return; ` shows or hides the generated cheatsheet; every other key types normally
;;
;; ⇧ and ⌥ held with a layer key pass through (⇧+d extends the selection, ⌥+a moves a word);
;; ⌘ or ⌃ held bypasses the layer, so ⌘A / ⌘W / ⌃C keep their normal meaning. Tapping left ⇧
;; inside the layer toggles select mode ("NAV · SELECT"): moves are sent with ⇧ until ⇧ is
;; tapped again, or a cut, paste or delete ends it.
;;
;; NOTE to future agents: don't guess goku or Karabiner syntax/behavior from memory — use
;; the `ask` skill against the real sources. `ask src github:yqrashawn/GokuRakuJoudo@master`
;; for goku internals (e.g. :condi in-rule conditions, simlayers, :set/:noti/:mkey to-event
;; shortcuts — features the tutorial omits), and the Karabiner docs at
;; karabiner-elements.pqrs.org for manipulator semantics like mouse_key wheel signs. When in
;; doubt, compile with `goku --dry-run-all` and diff the JSON before/after.
;;
;; 8BitDo Zero 2 (keyboard mode), held rotated 90° left so the A button points up.
;; Start toggles a sticky mouse layer (press once to enter — shows a "🖱 Mouse mode"
;; notification — press again to exit). The pad emits letter keycodes; the only templated
;; value is the dictation path.
;;
;; Each :rules block opens with a [:condi …] marker — a Goku in-rule condition that gets
;; merged into every following rule in that block (and reset at the block's end). So the
;; device scope (:zero2) and the layer gate (:pad_mouse_mode) are stated once per block
;; instead of on every rule.
;;
;; Buttons -> emitted keycode (controller's native orientation; rotate 90° left to hold):
;;
;;     [L] k                                       m [R]
;;     ─────────────────────────────────────────────────
;;
;;             (f) Up                      (h) X
;;     (c) Left      (d) Right         (i) Y     (g) A
;;             (e) Down                    (j) B
;;
;;                  (n) Select   (o) Start
;;
;;           └──── D-PAD ────┘        └──── FACE ────┘
;;
;; Overlays in priority order — Karabiner takes the first matching manipulator. The mouse
;; overlay (gated on pad_mouse_mode) is listed FIRST so it wins when the toggle is on. Next
;; come the per-app overlays (each gated on a frontmost app), so their bumper remaps beat the
;; base layer but still yield to mouse mode. The base layer is the unconditional default and
;; falls through last. Held rotated, the face diamond reads A=up, B=right, Y=down, X=left:
;;
;;   key        base layer (default)          mouse layer (toggle on)
;;   ─────────  ───────────────────────────   ────────────────────────
;;   f  D-up    ↑ arrow                        scroll up
;;   e  D-down  ↓ arrow                        scroll down
;;   c  D-left  ← arrow                        scroll left
;;   d  D-right → arrow                        scroll right
;;   g  A       dictation (sidekick + F19)     move cursor up
;;   j  B       return / enter                 move cursor right
;;   i  Y       escape                         move cursor down
;;   h  X       delete / backspace             move cursor left
;;   m  R       —                              left click  (button1)
;;   k  L       —                              right click (button2)
;;   n  Select  —                              —
;;   o  Start   toggle on (🖱 notification)    toggle off
;;
;; Per-app overlays (frontmost app, mouse toggle off) remap just the two bumpers, keeping R =
;; "previous" and L = "next" (R sits above L when held):
;;
;;   app   R bumper (m)            L bumper (k)
;;   ────  ─────────────────────   ─────────────────
;;   Orca  ⌘⇧↑ previous worktree   ⌘⇧↓ next worktree
;;   Arc   ⌘⇧[ previous tab        ⌘⇧] next tab

{:devices {:zero2    [{:vendor_id 11720 :product_id 36888}]
           :internal [{:is_built_in_keyboard true}]}

 :applications {:orca ["^com\\.stablyai\\.orca$"]
                :arc  ["^company\\.thebrowser\\.Browser$"]}

 ;; Named action sequences. Every way out of the nav layer runs :nav_off, so none can leave
 ;; the banner or the cheatsheet overlay behind.
 :tos {:nav_off        [{:set ["nav_mode" 0]} {:set ["nav_select" 0]} {:noti {:id :nav_mode :text ""}} {:shell "pkill -x keymap-overlay"}]
       :nav_select_off [{:set ["nav_select" 0]} {:noti {:id :nav_mode :text "NAV"}}]}

 :main
 [{:des "8BitDo: Start toggles the mouse layer (with notification)"
   :rules [[:condi :zero2]
           [:o [{:set ["pad_mouse_mode" 0]} {:noti {:id :pad_mouse_mode :text ""}}]              :pad_mouse_mode]
           [:o [{:set ["pad_mouse_mode" 1]} {:noti {:id :pad_mouse_mode :text "🖱 Mouse mode"}}] :!pad_mouse_mode]]}

  {:des "8BitDo mouse overlay (toggle on): d-pad scrolls, face moves cursor, R/L click"
   :rules [[:condi :zero2 :pad_mouse_mode]
           [:f {:mkey {:vwheel -40}}]
           [:e {:mkey {:vwheel 40}}]
           [:c {:mkey {:hwheel 40}}]
           [:d {:mkey {:hwheel -40}}]
           [:g {:mkey {:y -1536}}]
           [:j {:mkey {:x 1536}}]
           [:i {:mkey {:y 1536}}]
           [:h {:mkey {:x -1536}}]
           [:m {:pkey :button1}]
           [:k {:pkey :button2}]]}

  {:des "8BitDo Orca overlay (base layer, Orca frontmost): bumpers navigate worktrees"
   :rules [[:condi :zero2 :orca]
           [:m {:key :up_arrow   :modi [:left_command :left_shift]}]
           [:k {:key :down_arrow :modi [:left_command :left_shift]}]]}

  {:des "8BitDo Arc overlay (base layer, Arc frontmost): bumpers switch tabs"
   :rules [[:condi :zero2 :arc]
           [:m {:key :open_bracket  :modi [:left_command :left_shift]}]
           [:k {:key :close_bracket :modi [:left_command :left_shift]}]]}

  {:des "8BitDo base layer (default): d-pad arrows, A dictation, X bksp, B enter, Y esc"
   :rules [[:condi :zero2]
           [:f :up_arrow]
           [:e :down_arrow]
           [:c :left_arrow]
           [:d :right_arrow]
           [:g [{:shell "{{ .chezmoi.homeDir }}/.local/bin/dictation-sidekick"} :f19]]
           [:j :return_or_enter]
           [:i :escape]
           [:h :delete_or_backspace]
           [:m :vk_none]
           [:k :vk_none]
           [:n :vk_none]]}

  {:des "Nav layer: ⌃Space toggles (with notification); Esc or a Caps tap leaves"
   :rules [[:!Tspacebar :nav_off :nav_mode]
           [:!Tspacebar [{:set ["nav_mode" 1]} {:noti {:id :nav_mode :text "NAV"}}] :!nav_mode]
           [:escape :nav_off :nav_mode]
           [:##caps_lock :left_control [:internal :nav_mode] {:alone :nav_off}]
           ;; The leader tap leaves first, so the keys typed into Tuna combo mode are not
           ;; rewritten by the layer.
           [:##left_command {:key :left_command} [:nav_mode]
            {:alone [:nav_off :f18] :params {:alone 200}}]]}

  {:des "Nav layer select mode (left ⇧ tap toggles): moves extend the selection; cut, paste and delete end it"
   :rules [[:condi :nav_mode :nav_select]
           [:left_shift {:key :left_shift} nil
            {:alone :nav_select_off :params {:alone 200}}]
           [{:key :w :modi {:optional [:shift :option]}} {:key :up_arrow :modi [:left_shift]}]
           [{:key :a :modi {:optional [:shift :option]}} {:key :left_arrow :modi [:left_shift]}]
           [{:key :s :modi {:optional [:shift :option]}} {:key :down_arrow :modi [:left_shift]}]
           [{:key :d :modi {:optional [:shift :option]}} {:key :right_arrow :modi [:left_shift]}]
           [{:key :q :modi {:optional [:shift :option]}} {:key :left_arrow :modi [:left_option :left_shift]}]
           [{:key :e :modi {:optional [:shift :option]}} {:key :right_arrow :modi [:left_option :left_shift]}]
           [{:key :r :modi {:optional [:shift :option]}} {:key :page_up :modi [:left_shift]}]
           [{:key :f :modi {:optional [:shift :option]}} {:key :page_down :modi [:left_shift]}]
           [{:key :1 :modi {:optional [:shift :option]}} {:key :left_arrow :modi [:left_command :left_shift]}]
           [{:key :2 :modi {:optional [:shift :option]}} {:key :right_arrow :modi [:left_command :left_shift]}]
           [:x [{:key :x :modi [:left_command]} :nav_select_off]]
           [:v [{:key :v :modi [:left_command]} :nav_select_off]]
           [{:key :g :modi {:optional [:shift :option]}} [:delete_or_backspace :nav_select_off]]
           [{:key :b :modi {:optional [:shift :option]}} [:delete_forward :nav_select_off]]]}

  {:des "Nav layer (toggle on): left-hand arrows, word/line/page moves, clipboard, editing keys"
   ;; ⇧/⌥ are optional on the moves so they pass through; no rule here accepts ⌘ or ⌃, so
   ;; those chords fall through to their normal meaning.
   :rules [[:condi :nav_mode]
           [:left_shift {:key :left_shift} nil
            {:alone [{:set ["nav_select" 1]} {:noti {:id :nav_mode :text "NAV · SELECT"}}] :params {:alone 200}}]
           [{:key :w :modi {:optional [:shift :option]}} :up_arrow]
           [{:key :a :modi {:optional [:shift :option]}} :left_arrow]
           [{:key :s :modi {:optional [:shift :option]}} :down_arrow]
           [{:key :d :modi {:optional [:shift :option]}} :right_arrow]
           [{:key :q :modi {:optional [:shift :option]}} {:key :left_arrow :modi [:left_option]}]
           [{:key :e :modi {:optional [:shift :option]}} {:key :right_arrow :modi [:left_option]}]
           [{:key :r :modi {:optional [:shift :option]}} :page_up]
           [{:key :f :modi {:optional [:shift :option]}} :page_down]
           [{:key :1 :modi {:optional [:shift :option]}} {:key :left_arrow :modi [:left_command]}]
           [{:key :2 :modi {:optional [:shift :option]}} {:key :right_arrow :modi [:left_command]}]
           [{:key :z :modi {:optional [:shift]}} {:key :z :modi [:left_command]}]
           [:x {:key :x :modi [:left_command]}]
           [:c [{:key :c :modi [:left_command]} :nav_off]]
           [:v {:key :v :modi [:left_command]}]
           [{:key :g :modi {:optional [:shift :option]}} :delete_or_backspace]
           [{:key :b :modi {:optional [:shift :option]}} :delete_forward]
           [{:key :t :modi {:optional [:shift]}} :tab]
           [:spacebar :return_or_enter]
           ;; Float the sheet scripts/macos/render-keymap draws from the compiled rules; a second
           ;; press closes it, and so does leaving the layer. --opacity sets how see-through it is.
           [:grave_accent_and_tilde {:shell "pkill -x keymap-overlay || '{{ .chezmoi.homeDir }}/.local/bin/keymap-overlay' --opacity 0.85 '{{ .chezmoi.homeDir }}/.local/share/dotfiles/keymap/nav-layer.svg' >/dev/null 2>&1 &"}]]}

  {:des "Tap left ⌘ opens Tuna combo mode (F18); hold ⌘ + key/click stays ⌘"
   ;; Ungated (every keyboard), left hand only. ⌘ is sent as a REAL held modifier
   ;; (deliberately NOT :lazy) so ⌘-click / ⌘-drag and ⌘+key shortcuts all see the modifier.
   ;; :alone fires F18 only on a clean tap-and-release within 200ms, after ⌘ is released, so
   ;; the combo trigger stays clean (a bare ⌘ tap is inert). Anything held longer never
   ;; fires F18 and is just ⌘. ⇧ is deliberately not a trigger: it is tapped by accident.
   :rules [[:##left_command {:key :left_command} nil {:alone :f18 :params {:alone 200}}]]}

  {:des "Apple internal: modifier remaps"
   :rules [[:##caps_lock    :left_control [:internal] {:alone :escape}]
           [:##fn           :left_option  [:internal]]
           [:##left_control {:key :left_shift :modi [:left_control :left_option] :lazy true}
            [:internal] {:alone :f19 :params {:alone 200}}]
           [:##left_option  {:key :left_shift :modi [:left_command :left_control :left_option] :lazy true}
            [:internal]]]}]}
