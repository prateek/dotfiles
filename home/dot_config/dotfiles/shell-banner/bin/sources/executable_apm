#!/usr/bin/env zsh

set -uo pipefail

source "${0:A:h:h:h}/lib/source_runner.sh"

apm_check() {
  local bin="${DOTFILES_BANNER_APM_BIN:-apm}"
  if ! whence -p "$bin" >/dev/null 2>&1; then
    BANNER_SOURCE_DISABLED_REASON='apm not installed'
    return 1
  fi

  # The apm binary is often a mise shim that errors when no version is pinned.
  # Probe with --version first; treat any failure as "not configured" rather
  # than an error, otherwise the row stays red forever on machines that don't
  # use apm.
  if ! "$bin" --version >/dev/null 2>&1; then
    BANNER_SOURCE_DISABLED_REASON='apm not configured'
    return 1
  fi

  local stderr_file outdated_output apm_stdout parse_mode='text'
  stderr_file="$(banner_mktemp banner-apm)" || {
    BANNER_SOURCE_ERROR='mktemp failed'
    return 2
  }

  if apm_stdout="$("$bin" outdated --format json 2>"$stderr_file")"; then
    outdated_output="$apm_stdout"
    parse_mode='json'
  elif apm_stdout="$("$bin" outdated 2>"$stderr_file")"; then
    outdated_output="$apm_stdout"
    parse_mode='text'
  else
    # apm exits non-zero with "[x] No lockfile found in current directory" on
    # *stdout* when run outside a project. Treat that as "not configured here"
    # rather than a hard error so the row isn't perma-red on machines that
    # don't drive apm from $HOME.
    if [[ "$apm_stdout" == *'No lockfile'* ]]; then
      BANNER_SOURCE_DISABLED_REASON='no apm lockfile in cwd'
      /bin/rm -f "$stderr_file"
      return 1
    fi
    BANNER_SOURCE_ERROR="apm outdated failed: $(<"$stderr_file")"
    /bin/rm -f "$stderr_file"
    return 2
  fi
  /bin/rm -f "$stderr_file"

  local outdated=0
  case "$parse_mode" in
    json)
      if whence -p jq >/dev/null 2>&1; then
        outdated="$(print -r -- "$outdated_output" | jq '[.[] | select(.status == "outdated")] | length' 2>/dev/null)"
      else
        outdated="$(print -r -- "$outdated_output" | /usr/bin/grep -c '"status"[[:space:]]*:[[:space:]]*"outdated"' 2>/dev/null || true)"
      fi
      ;;
    text)
      outdated="$(print -r -- "$outdated_output" | /usr/bin/awk '$0 ~ /[[:space:]]outdated([[:space:]]|$)/ { count += 1 } END { print count + 0 }')"
      ;;
  esac
  banner_is_uint "$outdated" || outdated=0
  BANNER_SOURCE_OUTDATED="$outdated"
  BANNER_SOURCE_RAW="$outdated_output"

  # Total: try `apm list`. The runner clamps total >= outdated so a missing
  # list output still renders coherently.
  local list_output
  if list_output="$("$bin" list 2>/dev/null)"; then
    BANNER_SOURCE_TOTAL="$(banner_count_lines "$list_output")"
  fi
  return 0
}

banner_source_runner apm outdated apm_check "$@"
