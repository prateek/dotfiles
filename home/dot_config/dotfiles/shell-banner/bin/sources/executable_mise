#!/usr/bin/env zsh

set -uo pipefail

source "${0:A:h:h:h}/lib/source_runner.sh"

mise_check() {
  local bin="${DOTFILES_BANNER_MISE_BIN:-mise}"
  if ! whence -p "$bin" >/dev/null 2>&1; then
    BANNER_SOURCE_DISABLED_REASON='mise not installed'
    return 1
  fi

  cd "$HOME" || { BANNER_SOURCE_ERROR="cannot enter HOME"; return 2; }

  local stderr_file outdated_output installed_output
  stderr_file="$(banner_mktemp banner-mise)" || {
    BANNER_SOURCE_ERROR='mktemp failed'
    return 2
  }

  if ! outdated_output="$("$bin" outdated --no-header 2>"$stderr_file")"; then
    BANNER_SOURCE_ERROR="mise outdated failed: $(<"$stderr_file")"
    /bin/rm -f "$stderr_file"
    return 2
  fi
  /bin/rm -f "$stderr_file"

  BANNER_SOURCE_OUTDATED="$(banner_count_lines "$outdated_output")"
  BANNER_SOURCE_RAW="$outdated_output"

  if installed_output="$("$bin" ls --current --installed --no-header 2>/dev/null)"; then
    BANNER_SOURCE_TOTAL="$(banner_count_lines "$installed_output")"
  fi
  return 0
}

banner_source_runner mise outdated mise_check "$@"
