#!/usr/bin/env zsh
# vim:syntax=zsh
# vim:filetype=zsh

# zsh reads exactly one .zshenv, chosen by whether ZDOTDIR is set at startup:
# ZDOTDIR set -> this file; ZDOTDIR unset -> $HOME/.zshenv (which then sources
# this file). Inherited-ZDOTDIR shells (agent tool-shells, make children,
# nested subshells) only ever reach this file, so per-shell env that must apply
# everywhere lives here rather than in $HOME/.zshenv.

{{- $f := includeTemplate "features.tmpl" . | fromJson }}
{{- if hasKey $f "tart_home" }}
# Keep the configured destination when the SSD is absent; VM scripts check the mount.
if [[ -z "${TART_HOME:-}" ]]; then
  export TART_HOME={{ $f.tart_home | quote }}
fi
{{- end }}
{{- if hasKey $f "winmux_e2e_artifact_root" }}
if [[ -z "${WINMUX_E2E_ARTIFACT_ROOT:-}" ]]; then
  export WINMUX_E2E_ARTIFACT_ROOT={{ $f.winmux_e2e_artifact_root | quote }}
fi
{{- end }}
{{- if $f.tls_inspection }}
# Node ignores the macOS keychain, so behind the TLS-inspecting proxy every Node
# client needs the corporate roots exported to a file. GUI apps get this from
# the launchd GUI domain (com.prateek.gui-corp-ca); shells need it here because
# .zshenv is the one startup file every shell reads. The bundle is regenerated
# on each apply by run_after_19-corp-ca-bundle.sh; guard on readability so a
# fresh checkout before the first apply does not point Node at nothing.
if [[ -z "${NODE_EXTRA_CA_CERTS:-}" && -r "$HOME/.config/certs/corp-ca-bundle.pem" ]]; then
  export NODE_EXTRA_CA_CERTS="$HOME/.config/certs/corp-ca-bundle.pem"
fi
{{- end }}

# acpx withholds Claude user settings from the claude-agent-acp sessions it
# spawns, which drops extraKnownMarketplaces and enabledPlugins and leaves
# afable* seeing only Claude Code's built-in skills. That guard is for plugins
# claiming singleton external resources; nothing in the enabled set does, so
# opt those sessions back into the full skill listing.
export ACPX_CLAUDE_INCLUDE_USER_SETTINGS=1

# Ensure that a non-login, non-interactive shell has a defined environment.
if [[ ( "$SHLVL" -eq 1 && ! -o LOGIN ) && -s "$ZDOTDIR/.zprofile" ]]; then
  source "$ZDOTDIR/.zprofile"
fi
