# `ghc`: github-checkout -- quick checkout and directory switcher
# usage (1) `$ ghc <github-user>/<github-repo>`
# usage (2) `$ ghc github.com/<github-user>/<github-repo>(/.*)?`
# usage (3) `$ ghc https://github.com/<github-user>/<github-repo>(/.*)?`
# `--large` makes a new clone partial (blobs on demand), without
# tags, tracking only the default branch and your git-spice branch prefix, and
# registers it for background maintenance.
function ghc() {
  setopt localoptions pipefail no_aliases 2> /dev/null

  local large=0 arg
  local -a rest
  for arg in "$@"; do
    if [[ "$arg" == "--large" ]]; then
      large=1
    else
      rest+=("$arg")
    fi
  done
  set -- "${rest[@]}"

  if [[ $# -lt 1 ]]; then
    echo "usage: ghc [--large] <owner>/<repo>  (or [https://]github.com/<owner>/<repo>)" >&2
    return 2
  fi

  _ghc_parse_slug() {
    local raw="${1:-}"

    raw="${raw%%#*}"
    raw="${raw%%\?*}"
    raw="${raw%.git}"

    # scp-like: git@github.com:owner/repo(.git)
    if [[ "$raw" == *@*:* && "$raw" != *://* ]]; then
      raw="${raw#*:}"
    fi

    # URL-like: https://github.com/owner/repo(.git)
    raw="${raw#http://}"
    raw="${raw#https://}"
    raw="${raw#ssh://}"

    if [[ "$raw" == *github.com/* ]]; then
      raw="${raw##*github.com/}"
    fi

    local owner repo
    owner="${raw%%/*}"
    repo="${raw#*/}"
    repo="${repo%%/*}"

    if [[ -z "$owner" || -z "$repo" || "$owner" == "$raw" ]]; then
      echo ""
      return 0
    fi

    echo "${owner}/${repo}"
  }

  # Never --depth: a thin push from a shallow partial clone lazily fetches the
  # root tree of every ref the remote advertises. --no-tags also sets
  # remote.origin.tagOpt, so later fetches skip tags too.
  _ghc_clone_large() {
    local url="$1" dir="$2" prefix
    git clone --filter=blob:none --no-tags --single-branch "$url" "$dir" || return 1
    prefix="$(git -C "$dir" config --get spice.branchCreate.prefix)" || prefix=""
    if [[ -n "$prefix" ]]; then
      git -C "$dir" remote set-branches --add origin "${prefix}*" &&
        git -C "$dir" fetch origin ||
        echo "ghc: could not fetch ${prefix}* branches into $dir" >&2
    fi
    # Chezmoi renders ~/.gitconfig, where a plain register would land, so the
    # entry goes to the unmanaged include. start then sees the repo registered.
    git -C "$dir" maintenance register --config-file "$HOME/.config/git/config.local" &&
      git -C "$dir" maintenance start ||
      echo "ghc: maintenance not scheduled for $dir" >&2
    return 0
  }

  # Normalize to owner/repo.
  local slug
  slug="$(_ghc_parse_slug "$1")"
  if [[ "$slug" != */* ]]; then
    echo "ghc: could not parse repo slug from: $1" >&2
    return 2
  fi

  local ghpath
  ghpath="${GHPATH:-$HOME/code/github.com}"

  local target="$ghpath/$slug"

  if [[ ! -d "$target/.git" ]]; then
    mkdir -p "$(dirname "$target")"

    local clone_url="git@github.com:${slug}.git"
    if (( large )); then
      _ghc_clone_large "$clone_url" "$target" || return 1
    else
      git clone "$clone_url" "$target" || return 1
    fi
  elif (( large )); then
    echo "ghc: $target already exists; --large applies only to new clones" >&2
  fi

  cd "$target" || return 1

  if [[ -n "$(git status --porcelain)" ]]; then
    echo "WARNING: git status is not clean"
    return 0
  fi

  local default_branch
  default_branch="$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')"
  if [[ -z "$default_branch" ]]; then
    if git show-ref --verify --quiet refs/heads/main; then
      default_branch="main"
    else
      default_branch="master"
    fi
  fi

  git checkout "$default_branch" >/dev/null 2>&1 || true
  git pull --ff-only origin "$default_branch" >/dev/null 2>&1 || true
}

ghc "$@"
