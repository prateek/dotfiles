#!/bin/sh
# Thaw trigger: exits 0 while a com.prateek.* launch agent is stopped after a
# failed run. A running job's last status is ignored because KeepAlive jobs
# report the failure they restarted from.
launchctl list | awk '
  NR > 1 && $3 ~ /^com\.prateek\./ && $1 == "-" && $2 != "0" { found = 1 }
  END { exit !found }
'
