"""Machine package operations; implementation is installed alongside this entrypoint."""
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'lib/dotpkgs'))
from cli import main

if __name__ == '__main__':
    raise SystemExit(main())
