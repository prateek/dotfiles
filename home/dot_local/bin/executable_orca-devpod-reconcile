#!/usr/bin/env bash
set -euo pipefail

readonly ORCA_VERSION="1.4.193"
readonly ORCA_DEB_SHA256="207439dad48f24f569f2732ee85b117ef0c2e84b0cff006f62e0fedba5b7967f"
readonly ORCA_DEB_URL="https://github.com/stablyai/orca/releases/download/v${ORCA_VERSION}/orca-ide_${ORCA_VERSION}_amd64.deb"
readonly ORCA_PORT="6768"
readonly ORCA_PAIRING_ADDRESS="127.0.0.1:16768"
readonly ORCA_SESSION="orca-headless"

# Orca 1.4.193 binds the serving endpoint to all interfaces. Cloud
# Workstations IAM limits who can reach the workstation, Orca authenticates
# clients, and gcp.sh tunnel supplies the laptop route. Pairing stays on the
# loopback-only address. See docs/runbooks/linux-work-devpod-orca.md.
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/orca/$ORCA_VERSION"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/orca-headless"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/orca"
deb="$cache_dir/orca-ide_${ORCA_VERSION}_amd64.deb"
log="$state_dir/serve.log"
run_script="$state_dir/run"
pairing_marker="$config_dir/pairing-complete"

log_info() {
  printf 'orca-devpod: %s\n' "$*"
}

die() {
  printf 'orca-devpod: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

checksum_matches() {
  [[ -f "$1" ]] &&
    printf '%s  %s\n' "$ORCA_DEB_SHA256" "$1" | sha256sum --check --status
}

stop_server() {
  if tmux has-session -t "$ORCA_SESSION" 2>/dev/null; then
    tmux kill-session -t "$ORCA_SESSION"
  fi

  rm -f "$run_script"

  for _ in {1..20}; do
    if ! ss -ltn "sport = :$ORCA_PORT" | grep -q LISTEN; then
      log_info "stopped"
      return
    fi
    sleep 1
  done

  die "port $ORCA_PORT is still listening after tmux session stopped"
}

install_orca() {
  local -a apt_args=(install -y --allow-downgrades)
  local architecture
  local installed_version=""
  local tmp

  architecture="$(dpkg --print-architecture)"
  [[ "$architecture" == "amd64" ]] ||
    die "unsupported architecture: $architecture"

  if ! checksum_matches "$deb"; then
    rm -f "$deb"
    tmp="$deb.tmp.$$"
    trap 'rm -f "${tmp:-}"' EXIT
    curl --fail --location --retry 3 --output "$tmp" "$ORCA_DEB_URL"
    chmod 600 "$tmp"
    checksum_matches "$tmp" || die "checksum mismatch for downloaded Orca package"
    mv -f "$tmp" "$deb"
    trap - EXIT
  fi

  installed_version="$(dpkg-query -W -f='${Version}' orca-ide 2>/dev/null || true)"
  if [[ "$installed_version" == "$ORCA_VERSION" && -x /usr/bin/orca-ide ]]; then
    return
  fi

  log_info "installing Orca $ORCA_VERSION"
  if [[ -n "$installed_version" ]]; then
    apt_args+=(--reinstall)
  fi
  sudo -n env DEBIAN_FRONTEND=noninteractive apt-get "${apt_args[@]}" "$deb"

  [[ "$(dpkg-query -W -f='${Version}' orca-ide 2>/dev/null)" == "$ORCA_VERSION" ]] ||
    die "Orca $ORCA_VERSION was not installed"
  [[ -x /usr/bin/orca-ide ]] || die "/usr/bin/orca-ide is not executable"
}

write_runner() {
  local pairing_flag=""

  if [[ -f "$pairing_marker" ]]; then
    pairing_flag=" --no-pairing"
  fi

  {
    printf '#!/usr/bin/env bash\n'
    printf 'exec env LIBGL_ALWAYS_SOFTWARE=1 /usr/bin/orca-ide serve'
    printf ' --port %q --pairing-address %q%s --json' \
      "$ORCA_PORT" "$ORCA_PAIRING_ADDRESS" "$pairing_flag"
    printf ' >>%q 2>&1\n' "$log"
  } >"$run_script"
  chmod 700 "$run_script"
}

ready() {
  python3 - "$log" "$ORCA_PORT" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
expected = f"ws://0.0.0.0:{sys.argv[2]}"
if not path.exists():
    raise SystemExit(1)

for line in path.read_text(errors="replace").splitlines():
    try:
        event = json.loads(line)
    except Exception:
        continue
    if event.get("type") != "orca_server_ready":
        continue
    if event.get("boundEndpoint") != expected:
        print(
            f"orca-devpod: unexpected bound endpoint: {event.get('boundEndpoint')}",
            file=sys.stderr,
        )
        raise SystemExit(2)
    raise SystemExit(0)

raise SystemExit(1)
PY
}

start_server() {
  local ready_rc

  install_orca
  stop_server

  : >"$log"
  chmod 600 "$log"
  write_runner
  tmux new-session -d -s "$ORCA_SESSION" "$run_script" 9>&-

  for _ in {1..60}; do
    if ready; then
      chmod 700 "$config_dir" 2>/dev/null || true
      log_info "ready on remote port $ORCA_PORT"
      if [[ ! -f "$pairing_marker" ]]; then
        log_info "pairing offer is available only in $log"
      fi
      return
    else
      ready_rc=$?
    fi
    if [[ "$ready_rc" -eq 2 ]]; then
      tmux kill-session -t "$ORCA_SESSION" 2>/dev/null || true
      die "Orca selected an unexpected port; inspect $log"
    fi
    if ! tmux has-session -t "$ORCA_SESSION" 2>/dev/null; then
      die "Orca exited before becoming ready; inspect $log"
    fi
    sleep 1
  done

  tmux kill-session -t "$ORCA_SESSION" 2>/dev/null || true
  die "Orca did not become ready on port $ORCA_PORT; inspect $log"
}

status() {
  if tmux has-session -t "$ORCA_SESSION" 2>/dev/null && ready; then
    log_info "ready on remote port $ORCA_PORT"
    exit 0
  fi
  log_info "stopped"
  exit 1
}

[[ "$(uname -s)" == "Linux" ]] || die "this reconciler supports Linux only"

mkdir -p "$cache_dir" "$state_dir" "$config_dir"
chmod 700 "${XDG_CACHE_HOME:-$HOME/.cache}/orca" "$cache_dir" "$state_dir" "$config_dir"

require_command flock
require_command grep
require_command python3
require_command ss
require_command tmux

exec 9>"$state_dir/reconcile.lock"
flock -w 10 9 || die "another reconcile is still running"

action="${1:-}"
case "$action" in
  start|disable-pairing)
    for command in curl apt-get dpkg dpkg-query sha256sum sudo; do
      require_command "$command"
    done
    if [[ "$action" == "disable-pairing" ]]; then
      : >"$pairing_marker"
      chmod 600 "$pairing_marker"
    fi
    start_server
    ;;
  stop)
    stop_server
    ;;
  status)
    status
    ;;
  *)
    die "usage: orca-devpod-reconcile start|stop|status|disable-pairing"
    ;;
esac
