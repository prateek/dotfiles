#!/usr/bin/env bash
set -euo pipefail

readonly ORCA_VERSION="1.4.217"
readonly ORCA_DEB_SHA256="dc84039c473833cab6f22dc911927f4ce14d7869b1a5d2e604636976ec4b71bd"
readonly ORCA_DEB_URL="https://github.com/stablyai/orca/releases/download/v${ORCA_VERSION}/orca-ide_${ORCA_VERSION}_amd64.deb"
readonly ORCA_PORT="6768"
readonly ORCA_PAIRING_ADDRESS="127.0.0.1:16768"
readonly ORCA_SESSION="orca-headless"

# Headless Orca server for the Linux devbox, driven by the devbox onstart hook:
# start installs the pinned .deb (a stop/start discards /usr) and serves in tmux.
# Keep ORCA_VERSION in step with desktop Orca on the Mac.
#
# Orca binds the serving endpoint to all interfaces and has no bind flag. The
# IAM gateway restricts reachability; Orca authenticates each paired device.
# start always serves with --no-pairing. `pair` restarts the server with a
# pairing offer on the loopback-only address and prints only the pairing code
# on stdout, for the caller to capture; run start again after pairing. Never
# print the serve log or the code. See the devbox-orca-pair skill and
# docs/plans/linux-devbox-plan.md.
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/orca/$ORCA_VERSION"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/orca-headless"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/orca"
deb="$cache_dir/orca-ide_${ORCA_VERSION}_amd64.deb"
log="$state_dir/serve.log"
run_script="$state_dir/run"
orca_ide="${ORCA_IDE_BIN:-/usr/bin/orca-ide}"
pairing=0

# Status goes to stderr so stdout carries only the pairing code.
log_info() {
  printf 'orca-devpod: %s\n' "$*" >&2
}

die() {
  printf 'orca-devpod: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

checksum_matches() {
  [[ -f "$1" ]] &&
    printf '%s  %s\n' "$ORCA_DEB_SHA256" "$1" | sha256sum --check --status
}

stop_server() {
  if tmux has-session -t "$ORCA_SESSION" 2>/dev/null; then
    tmux kill-session -t "$ORCA_SESSION"
  fi

  rm -f "$run_script"
  # The PTY daemon detaches from the server and would keep the old version and
  # environment across a restart. Stopping it ends live Orca terminals.
  pkill -u "$(id -u)" -f '/opt/Orca/.*daemon-entry\.js' 2>/dev/null || true

  # Wait for every Orca process, not just the port: a server still tearing
  # down holds the single-instance lock, and the next launch exits at once.
  for _ in {1..20}; do
    if ! orca_running; then
      log_info "stopped"
      return
    fi
    sleep 1
  done
  pkill -KILL -u "$(id -u)" -f '^/opt/Orca/orca-ide' 2>/dev/null || true
  sleep 2
  orca_running && die "Orca processes are still running after SIGKILL"
  log_info "stopped"
}

orca_running() {
  pgrep -u "$(id -u)" -f '^/opt/Orca/orca-ide' >/dev/null
}

install_orca() {
  installed=0
  local -a apt_args=(install -y --allow-downgrades)
  local architecture
  local installed_version=""
  local tmp

  architecture="$(dpkg --print-architecture)"
  [[ "$architecture" == "amd64" ]] ||
    die "unsupported architecture: $architecture"

  if ! checksum_matches "$deb"; then
    rm -f "$deb"
    tmp="$deb.tmp.$$"
    trap 'rm -f "${tmp:-}"' EXIT
    curl --fail --location --retry 3 --connect-timeout 20 --max-time 900 --output "$tmp" "$ORCA_DEB_URL"
    chmod 600 "$tmp"
    checksum_matches "$tmp" || die "checksum mismatch for downloaded Orca package"
    mv -f "$tmp" "$deb"
    trap - EXIT
  fi

  installed_version="$(dpkg-query -W -f='${Version}' orca-ide 2>/dev/null || true)"
  if [[ "$installed_version" == "$ORCA_VERSION" && -x "$orca_ide" ]]; then
    return
  fi

  log_info "installing Orca $ORCA_VERSION"
  if [[ -n "$installed_version" ]]; then
    apt_args+=(--reinstall)
  fi
  # The .deb pulls dependencies, and the image's package lists can be stale.
  timeout 900 sudo -n env DEBIAN_FRONTEND=noninteractive apt-get update -qq
  timeout 900 sudo -n env DEBIAN_FRONTEND=noninteractive apt-get "${apt_args[@]}" "$deb"
  installed=1

  [[ "$(dpkg-query -W -f='${Version}' orca-ide 2>/dev/null)" == "$ORCA_VERSION" ]] ||
    die "Orca $ORCA_VERSION was not installed"
  [[ -x "$orca_ide" ]] || die "$orca_ide is not executable"
}

render_runner() {
  local pairing_flag="" login_shell

  if [[ "$pairing" -eq 0 ]]; then
    pairing_flag=" --no-pairing"
  fi
  # Orca terminals open $SHELL, and a tmux server started by another session
  # hands down that session's shell, so name the login shell explicitly.
  login_shell="$(getent passwd "$(id -un)" | cut -d: -f7 || true)"
  [[ -x "$login_shell" ]] || login_shell=/bin/bash

  {
    printf '#!/usr/bin/env bash\n'
    printf 'exec env LIBGL_ALWAYS_SOFTWARE=1 SHELL=%q %q serve' "$login_shell" "$orca_ide"
    printf ' --port %q --pairing-address %q%s --json' \
      "$ORCA_PORT" "$ORCA_PAIRING_ADDRESS" "$pairing_flag"
    printf ' >>%q 2>&1\n' "$log"
  }
}

# True when the server already runs the installed package with the runner that
# start would write now, so a repeat start changes nothing.
serving_current() {
  [[ "$installed" -eq 0 && -f "$run_script" ]] &&
    tmux has-session -t "$ORCA_SESSION" 2>/dev/null &&
    ready 2>/dev/null &&
    [[ "$(render_runner)" == "$(<"$run_script")" ]]
}

# Reads the first orca_server_ready event from the serve log: exit 1 until it
# arrives, 2 when Orca bound an unexpected endpoint. --pairing-url also prints
# the offered pairing URL, and fails when the server made no offer.
ready() {
  python3 - "$log" "$ORCA_PORT" "$@" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
expected = f"ws://0.0.0.0:{sys.argv[2]}"
pairing_url = sys.argv[3:] == ["--pairing-url"]
if not path.exists():
    raise SystemExit(1)

for line in path.read_text(errors="replace").splitlines():
    try:
        event = json.loads(line)
    except Exception:
        continue
    if event.get("type") != "orca_server_ready":
        continue
    if event.get("boundEndpoint") != expected:
        print(
            f"orca-devpod: unexpected bound endpoint: {event.get('boundEndpoint')}",
            file=sys.stderr,
        )
        raise SystemExit(2)
    if pairing_url:
        url = (event.get("pairing") or {}).get("url")
        if not url:
            print("orca-devpod: the server made no pairing offer", file=sys.stderr)
            raise SystemExit(1)
        print(url)
    raise SystemExit(0)

raise SystemExit(1)
PY
}

start_server() {
  local ready_rc

  install_orca
  if serving_current; then
    log_info "already ready on remote port $ORCA_PORT"
    return
  fi
  stop_server

  : >"$log"
  chmod 600 "$log"
  render_runner >"$run_script"
  chmod 700 "$run_script"
  tmux new-session -d -s "$ORCA_SESSION" "$run_script" 9>&-

  for _ in {1..60}; do
    if ready; then
      chmod 700 "$config_dir" 2>/dev/null || true
      log_info "ready on remote port $ORCA_PORT"
      return
    else
      ready_rc=$?
    fi
    if [[ "$ready_rc" -eq 2 ]]; then
      tmux kill-session -t "$ORCA_SESSION" 2>/dev/null || true
      die "Orca selected an unexpected port; inspect $log"
    fi
    if ! tmux has-session -t "$ORCA_SESSION" 2>/dev/null; then
      die "Orca exited before becoming ready; inspect $log"
    fi
    sleep 1
  done

  tmux kill-session -t "$ORCA_SESSION" 2>/dev/null || true
  die "Orca did not become ready on port $ORCA_PORT; inspect $log"
}

status() {
  if tmux has-session -t "$ORCA_SESSION" 2>/dev/null && ready; then
    log_info "ready on remote port $ORCA_PORT"
    exit 0
  fi
  log_info "stopped"
  exit 1
}

[[ "$(uname -s)" == "Linux" ]] || die "this reconciler supports Linux only"

mkdir -p "$cache_dir" "$state_dir" "$config_dir"
chmod 700 "${XDG_CACHE_HOME:-$HOME/.cache}/orca" "$cache_dir" "$state_dir" "$config_dir"

require_command flock
require_command python3
require_command pgrep
require_command tmux

exec 9>"$state_dir/reconcile.lock"
flock -w 10 9 || die "another reconcile is still running"

action="${1:-}"
case "$action" in
  start|pair)
    for command in curl apt-get dpkg dpkg-query sha256sum sudo timeout getent pkill; do
      require_command "$command"
    done
    if [[ "$action" == "pair" ]]; then
      pairing=1
      start_server
      ready --pairing-url
    else
      start_server
    fi
    ;;
  stop)
    stop_server
    ;;
  status)
    status
    ;;
  *)
    die "usage: orca-devpod-reconcile start|stop|status|pair"
    ;;
esac
