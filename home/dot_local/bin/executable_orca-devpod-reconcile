#!/usr/bin/env bash
set -euo pipefail

readonly ORCA_RELEASES_URL="https://github.com/stablyai/orca/releases"
readonly ORCA_UPDATE_SCHEDULE="0 9 * * *"
readonly ORCA_UPDATE_TAG="# orca-devpod-reconcile daily update"
readonly ORCA_PORT="6768"
readonly ORCA_PAIRING_ADDRESS="127.0.0.1:16768"
readonly ORCA_SESSION="orca-headless"
# Every Orca process by command line: the packaged Electron app, and the orcad
# server, PTY daemon and helpers that newer releases unpack under the data root.
readonly ORCA_PROCESSES='^/opt/Orca/orca-ide|/orca/orcad-artifacts/'

# Headless Orca server for the Linux devbox, driven by the devbox onstart hook:
# start installs the latest released .deb (a stop/start discards /usr) and
# serves in tmux. Desktop Orca on the Mac updates itself, so the box follows
# the latest release instead of a pin: start also schedules itself daily in
# cron, and a run that finds a newer release restarts the server, which ends
# live Orca terminals. stop removes the schedule.
#
# The release manifest names the version and the package's SHA-512. Both come
# from the release itself, so the checksum proves an intact download, not a
# reviewed one. When the manifest cannot be fetched, the last one is reused.
#
# Orca binds the serving endpoint to all interfaces by default. The
# IAM gateway restricts reachability; Orca authenticates each paired device.
# start always serves with --no-pairing. `pair` restarts the server with a
# pairing offer on the loopback-only address and prints only the pairing code
# on stdout, for the caller to capture; run start again after pairing. The
# runner redacts pairing URLs before they reach the serve log and hands the
# offer to `pair` through a one-shot 0600 file, so the log never holds a code.
# Never print the code. See the devbox-orca-pair skill and
# docs/plans/linux-devbox-plan.md.
cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/orca"
manifest="$cache_root/latest-linux.yml"
fetched_manifest="$manifest.new"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/orca-headless"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/orca"
log="$state_dir/serve.log"
offer="$state_dir/pairing-offer"
run_script="$state_dir/run"
orca_ide="${ORCA_IDE_BIN:-/usr/bin/orca-ide}"
pairing=0

# Status goes to stderr so stdout carries only the pairing code.
log_info() {
  printf 'orca-devpod: %s\n' "$*" >&2
}

die() {
  printf 'orca-devpod: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

# Prints "<version> <sha512>" for the amd64 .deb a release manifest names.
read_manifest() {
  python3 - "$1" <<'PY'
import re
import sys

try:
    text = open(sys.argv[1]).read()
except OSError:
    raise SystemExit(1)
version = re.search(r"^version:\s*(\d+(?:\.\d+)+)\s*$", text, re.M)
package = re.search(
    r"^\s*-\s*url:\s*(orca-ide_\S+_amd64\.deb)\s*\n\s*sha512:\s*([A-Za-z0-9+/]{86}==)\s*$",
    text,
    re.M,
)
if not version or not package:
    raise SystemExit(1)
if package.group(1) != f"orca-ide_{version.group(1)}_amd64.deb":
    raise SystemExit(1)
print(version.group(1), package.group(2))
PY
}

# Sets orca_version, orca_sha512, and deb from the latest release. A fetched
# manifest waits in $fetched_manifest until its package passes the checksum,
# so the cached manifest always names a package that was once on disk.
resolve_release() {
  local release

  rm -f "$fetched_manifest"
  if curl --fail --silent --show-error --location --proto '=https' --retry 3 \
    --connect-timeout 20 --max-time 120 --output "$fetched_manifest" \
    "$ORCA_RELEASES_URL/latest/download/latest-linux.yml" &&
    release="$(read_manifest "$fetched_manifest")"; then
    :
  else
    rm -f "$fetched_manifest"
    release="$(read_manifest "$manifest")" ||
      die "cannot read the latest Orca release, and no earlier manifest is cached"
    log_info "could not fetch the release manifest; reusing the cached one"
  fi
  read -r orca_version orca_sha512 <<<"$release"
  deb="$cache_root/$orca_version/orca-ide_${orca_version}_amd64.deb"
}

checksum_matches() {
  [[ -f "$1" ]] && python3 - "$1" "$orca_sha512" <<'PY'
import base64
import hashlib
import sys

digest = hashlib.sha512()
with open(sys.argv[1], "rb") as f:
    for chunk in iter(lambda: f.read(1 << 20), b""):
        digest.update(chunk)
raise SystemExit(base64.b64encode(digest.digest()).decode() != sys.argv[2])
PY
}

# Rewrites the crontab without this script's entry, then adds $1 when given.
# Other entries survive: a crontab that cannot be read is left untouched.
set_update_schedule() {
  local current="" errors="$state_dir/crontab.err" existed=1 reason

  if ! current="$(crontab -l 2>"$errors")"; then
    reason="$(<"$errors")"
    rm -f "$errors"
    [[ "$reason" == *"no crontab for"* ]] ||
      die "cannot read the crontab, so it is unchanged: $reason"
    current=""
    existed=0
  fi
  rm -f "$errors"

  current="$(grep -vF "$ORCA_UPDATE_TAG" <<<"$current" || true)"
  if [[ -n "$current$1" ]]; then
    printf '%s\n' ${current:+"$current"} ${1:+"$1"} | crontab -
  elif [[ "$existed" -eq 1 ]]; then
    crontab -r
  fi
}

# The account's login shell. A tmux server or cron hands down another one.
login_shell() {
  local shell

  shell="$(getent passwd "$(id -un)" | cut -d: -f7 || true)"
  [[ -x "$shell" ]] || shell=/bin/bash
  printf '%s\n' "$shell"
}

schedule_update() {
  local command

  command="$(printf '%q start' "$(realpath "${BASH_SOURCE[0]}")")"
  # Through the login shell, so a scheduled restart serves with the login
  # PATH, as a start from a terminal does, instead of cron's bare one.
  set_update_schedule "$(printf '%s %q -lc %q >>%q 2>&1 %s' "$ORCA_UPDATE_SCHEDULE" \
    "$(login_shell)" "$command" "$state_dir/update.log" "$ORCA_UPDATE_TAG")"
}

unschedule_update() {
  if command -v crontab >/dev/null 2>&1; then
    set_update_schedule ""
  fi
}

stop_server() {
  if tmux has-session -t "$ORCA_SESSION" 2>/dev/null; then
    tmux kill-session -t "$ORCA_SESSION"
  fi

  rm -f "$run_script" "$offer"
  # The server and its PTY daemon outlive the tmux session. A surviving server
  # holds the data-root lock, so the next launch exits at once; a surviving
  # daemon would keep the old version and environment across a restart.
  # Stopping the daemon ends live Orca terminals.
  pkill -u "$(id -u)" -f "$ORCA_PROCESSES" 2>/dev/null || true

  # Wait for every Orca process, not just the port: one still tearing down
  # holds the lock too.
  for _ in {1..20}; do
    if ! orca_running; then
      log_info "stopped"
      return
    fi
    sleep 1
  done
  pkill -KILL -u "$(id -u)" -f "$ORCA_PROCESSES" 2>/dev/null || true
  sleep 2
  orca_running && die "Orca processes are still running after SIGKILL"
  log_info "stopped"
}

orca_running() {
  pgrep -u "$(id -u)" -f "$ORCA_PROCESSES" >/dev/null
}

# Removes a failed download and the directory made for it, then exits.
discard_download() {
  rm -f "$deb.tmp" "$fetched_manifest"
  rmdir "${deb%/*}" 2>/dev/null || true
  die "$1"
}

# Each release is a new 200 MB package; keep only the one now serving.
prune_cache() {
  local stale

  for stale in "$cache_root"/*/orca-ide_*_amd64.deb*; do
    if [[ -f "$stale" && "$stale" != "$deb" ]]; then
      rm -f "$stale"
      rmdir "${stale%/*}" 2>/dev/null || true
    fi
  done
}

install_orca() {
  local -a apt_args=(install -y)
  local architecture
  local installed_version=""

  architecture="$(dpkg --print-architecture)"
  [[ "$architecture" == "amd64" ]] ||
    die "unsupported architecture: $architecture"

  resolve_release
  installed_version="$(dpkg-query -W -f='${Version}' orca-ide 2>/dev/null || true)"
  # Never downgrade unattended: an older build would start on state the newer
  # one wrote. When upstream withdraws a release, keep serving the installed
  # one until a newer release appears.
  if [[ -x "$orca_ide" && -n "$installed_version" ]] &&
    dpkg --compare-versions "$orca_version" lt "$installed_version"; then
    log_info "latest release $orca_version is older than installed $installed_version; keeping it"
    rm -f "$fetched_manifest"
    orca_version="$installed_version"
    deb="$cache_root/$orca_version/orca-ide_${orca_version}_amd64.deb"
    return
  fi

  mkdir -p "${deb%/*}"
  chmod 700 "${deb%/*}"
  if ! checksum_matches "$deb"; then
    rm -f "$deb"
    curl --fail --silent --show-error --location --proto '=https' --retry 3 \
      --connect-timeout 20 --max-time 900 --output "$deb.tmp" \
      "$ORCA_RELEASES_URL/download/v$orca_version/${deb##*/}" ||
      discard_download "could not download Orca $orca_version"
    chmod 600 "$deb.tmp"
    checksum_matches "$deb.tmp" ||
      discard_download "checksum mismatch for downloaded Orca package"
    mv -f "$deb.tmp" "$deb"
  fi
  if [[ -f "$fetched_manifest" ]]; then
    mv -f "$fetched_manifest" "$manifest"
  fi

  if [[ "$installed_version" != "$orca_version" || ! -x "$orca_ide" ]]; then
    log_info "installing Orca $orca_version${installed_version:+ over $installed_version}"
    if [[ -n "$installed_version" ]]; then
      apt_args+=(--reinstall)
    fi
    # The .deb pulls dependencies, and the image's package lists can be stale.
    timeout 900 sudo -n env DEBIAN_FRONTEND=noninteractive apt-get update -qq
    timeout 900 sudo -n env DEBIAN_FRONTEND=noninteractive apt-get "${apt_args[@]}" "$deb"

    [[ "$(dpkg-query -W -f='${Version}' orca-ide 2>/dev/null)" == "$orca_version" ]] ||
      die "Orca $orca_version was not installed"
    [[ -x "$orca_ide" ]] || die "$orca_ide is not executable"
  fi
}

render_runner() {
  local pairing_flag="" shell

  if [[ "$pairing" -eq 0 ]]; then
    pairing_flag=" --no-pairing"
  fi
  # Orca terminals open $SHELL, and a tmux server started by another session
  # hands down that session's shell, so name the login shell explicitly.
  shell="$(login_shell)"

  {
    printf '#!/usr/bin/env bash\n'
    # Names the package this server runs, so a start after an upgrade, even
    # one whose install failed partway, sees a different runner and restarts.
    printf '# orca-ide %s\n' "$orca_version"
    cat <<'RUNNER'
# Every line passes through this filter before the serve log. The ready
# event's pairing URL goes to the offer file instead, and any pairing URL or
# code in other output, such as a browser link, is redacted.
redact=$(cat <<'PY'
import json
import os
import re
import sys

offer = sys.argv[1]
patterns = [
    (re.compile(r"orca%3A%2F%2F[^\s\"'<>&]+", re.I), "<redacted>"),
    (re.compile(r"orca://[^\s\"'<>]+"), "orca://<redacted>"),
    (re.compile(r"([?#&;](?:code|pairing|token)=)[^\s\"'<>&]+"), r"\1<redacted>"),
]

def save_offer(url):
    tmp = f"{offer}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(url + "\n")
    os.replace(tmp, offer)

for line in sys.stdin:
    try:
        event = json.loads(line)
    except ValueError:
        event = None
    if isinstance(event, dict) and isinstance(event.get("pairing"), dict):
        url = event["pairing"].get("url")
        if url:
            save_offer(url)
            event["pairing"]["url"] = "<redacted>"
            line = json.dumps(event, separators=(",", ":")) + "\n"
    for pattern, replacement in patterns:
        line = pattern.sub(replacement, line)
    sys.stdout.write(line)
    sys.stdout.flush()
PY
)
RUNNER
    printf 'env LIBGL_ALWAYS_SOFTWARE=1 SHELL=%q %q serve' "$shell" "$orca_ide"
    printf ' --port %q --pairing-address %q%s --json 2>&1' \
      "$ORCA_PORT" "$ORCA_PAIRING_ADDRESS" "$pairing_flag"
    # shellcheck disable=SC2016 # $redact belongs to the runner, not this shell
    printf ' | python3 -u -c "$redact" %q >>%q\n' "$offer" "$log"
  }
}

# True when the server already runs the runner that start would write now,
# which names the installed package, so a repeat start changes nothing.
serving_current() {
  [[ -f "$run_script" ]] &&
    tmux has-session -t "$ORCA_SESSION" 2>/dev/null &&
    ready 2>/dev/null &&
    [[ "$(render_runner)" == "$(<"$run_script")" ]]
}

# Reads the first orca_server_ready event from the serve log: exit 1 until it
# arrives, 2 when Orca bound an unexpected endpoint.
ready() {
  python3 - "$log" "$ORCA_PORT" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
expected = f"ws://0.0.0.0:{sys.argv[2]}"
if not path.exists():
    raise SystemExit(1)

for line in path.read_text(errors="replace").splitlines():
    try:
        event = json.loads(line)
    except Exception:
        continue
    if event.get("type") != "orca_server_ready":
        continue
    if event.get("boundEndpoint") != expected:
        print(
            f"orca-devpod: unexpected bound endpoint: {event.get('boundEndpoint')}",
            file=sys.stderr,
        )
        raise SystemExit(2)
    raise SystemExit(0)

raise SystemExit(1)
PY
}

# Prints the offered pairing URL once and deletes it, so the code exists on
# disk only until the caller captures it.
claim_offer() {
  [[ -s "$offer" ]] || die "the server made no pairing offer"
  cat "$offer"
  rm -f "$offer"
}

start_server() {
  local ready_rc

  install_orca
  if serving_current; then
    prune_cache
    log_info "already ready on remote port $ORCA_PORT"
    return
  fi
  stop_server

  : >"$log"
  chmod 600 "$log"
  render_runner >"$run_script"
  chmod 700 "$run_script"
  tmux new-session -d -s "$ORCA_SESSION" "$run_script" 9>&-

  for _ in {1..60}; do
    if ready; then
      chmod 700 "$config_dir" 2>/dev/null || true
      # Only now, so a release that fails to start leaves its predecessor.
      prune_cache
      log_info "ready on remote port $ORCA_PORT"
      return
    else
      ready_rc=$?
    fi
    if [[ "$ready_rc" -eq 2 ]]; then
      tmux kill-session -t "$ORCA_SESSION" 2>/dev/null || true
      die "Orca selected an unexpected port; inspect $log"
    fi
    if ! tmux has-session -t "$ORCA_SESSION" 2>/dev/null; then
      die "Orca exited before becoming ready; inspect $log"
    fi
    sleep 1
  done

  tmux kill-session -t "$ORCA_SESSION" 2>/dev/null || true
  die "Orca did not become ready on port $ORCA_PORT; inspect $log"
}

status() {
  if tmux has-session -t "$ORCA_SESSION" 2>/dev/null && ready; then
    log_info "ready on remote port $ORCA_PORT"
    exit 0
  fi
  log_info "stopped"
  exit 1
}

[[ "$(uname -s)" == "Linux" ]] || die "this reconciler supports Linux only"

mkdir -p "$cache_root" "$state_dir" "$config_dir"
chmod 700 "$cache_root" "$state_dir" "$config_dir"

require_command flock
require_command python3
require_command pgrep
require_command tmux

exec 9>"$state_dir/reconcile.lock"
flock -w 10 9 || die "another reconcile is still running"

action="${1:-}"
case "$action" in
  start|pair)
    for command in curl apt-get dpkg dpkg-query sudo timeout getent pkill realpath; do
      require_command "$command"
    done
    if [[ "$action" == "pair" ]]; then
      pairing=1
      start_server
      claim_offer
    else
      require_command crontab
      log_info "start at $(date -u +%FT%TZ)"
      # Close an open pairing window first: the install below can fail, and
      # start must not leave the window open when it does.
      if [[ -f "$run_script" ]] && ! grep -q -- '--no-pairing' "$run_script"; then
        log_info "closing the pairing window"
        stop_server
      fi
      start_server
      schedule_update
    fi
    ;;
  stop)
    stop_server
    unschedule_update
    ;;
  status)
    status
    ;;
  *)
    die "usage: orca-devpod-reconcile start|stop|status|pair"
    ;;
esac
