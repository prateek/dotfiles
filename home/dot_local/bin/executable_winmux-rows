#!/bin/sh
# Toggle a Columns workspace between its Columns and the same containers
# stacked as rows. Rows last until the next toggle or config reload.
#   winmux-rows [workspace]     defaults to the focused workspace
set -eu
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

ws=${1:-$(winmux list-workspaces --focused)}
state="${XDG_STATE_HOME:-$HOME/.local/state}/winmux/rows-$ws"
count=$(winmux list-columns --workspace "$ws" | wc -l | tr -d ' ')

if [ "$count" -eq 0 ]; then
  [ -f "$state" ] || { echo "winmux-rows: workspace $ws has no Columns to restore" >&2; exit 1; }
  winmux column-count "$(cat "$state")" --workspace "$ws"
  rm -f "$state"
  exit 0
fi

winmux column-count off --workspace "$ws"
restore() {
  winmux column-count "$count" --workspace "$ws"
  echo "winmux-rows: $1; kept $count Columns on workspace $ws" >&2
  exit 1
}

# The top-level split's direction is only reachable through a layout rewrite:
# `layout --window-id` flips the window's parent, a tab group when a Column
# held several windows. Without Columns the root must be a split of two or more
# containers; one occupied Column collapses to a single node with nothing to
# stack.
dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
winmux agent query --path "$dir/q.json" || restore "couldn't read the layout"
jq -e --arg ws "$ws" '[.reasoning.rawTrees[] | select(.workspace == $ws and .tree.kind == "split")] | length == 1' \
  "$dir/q.json" >/dev/null || restore "nothing to stack (one occupied Column)"
jq --arg ws "$ws" '.edit = {operations: [], layout: {workspaces: [
  {name: $ws,
   layout: (.reasoning.rawTrees[] | select(.workspace == $ws) | .tree | .direction = "vertical"),
   floating: [.inventory.windows[] | select(.workspace == $ws and .layout == "floating") | {windowId}]}
]}}' "$dir/q.json" >"$dir/edit.json"
winmux agent apply --path "$dir/edit.json" >/dev/null || restore "WinMux rejected the rows layout"
mkdir -p "${state%/*}"
echo "$count" >"$state"
