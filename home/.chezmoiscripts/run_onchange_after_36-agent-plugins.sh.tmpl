{{ template "script_lib.sh" . }}

# render-agent-plugin-marketplace sha256: {{ include (printf "%s/../.agents/skills/agent-skill-management/scripts/render-agent-plugin-marketplace" .chezmoi.sourceDir) | sha256sum }}
# reconcile-agent-plugins sha256: {{ include (printf "%s/../.agents/skills/agent-skill-management/scripts/reconcile-agent-plugins" .chezmoi.sourceDir) | sha256sum }}
# agent_skill_lib.py sha256: {{ include (printf "%s/../.agents/skills/agent-skill-management/scripts/agent_skill_lib.py" .chezmoi.sourceDir) | sha256sum }}
# dot_agents/packages tree sha256: {{ includeTemplate "agent-packages-tree-hash.tmpl" . }}

set -euo pipefail

{{- $f := includeTemplate "features.tmpl" . | fromJson }}

generator="{{ .chezmoi.sourceDir }}/../.agents/skills/agent-skill-management/scripts/render-agent-plugin-marketplace"
reconciler="{{ .chezmoi.sourceDir }}/../.agents/skills/agent-skill-management/scripts/reconcile-agent-plugins"

[ -x "$generator" ] || die "Agent plugin renderer is missing or not executable: $generator"
[ -x "$reconciler" ] || die "Agent plugin reconciler is missing or not executable: $reconciler"
have uv || die "uv is required to render agent plugins."

# The renderer resets the marketplace destination before copying package-selected plugins.
run_timed "render agent plugins" \
  "$generator" \
  --plugins-root "$HOME/.agents/plugins" \
  --skip-config-templates

# Each CLI owns its install records, so the reconciler drives them through
# `claude plugin` / `codex plugin`: a new package becomes installable and a
# disabled one stays disabled without a manual step after apply.
agents=""
{{- range $f.agent_clis }}
{{- if or (eq . "claude") (eq . "codex") }}
have {{ . }} || die "{{ . }} is listed in agent_clis but not on PATH; install it before agent plugins can reconcile."
agents="$agents --agent {{ . }}"
{{- end }}
{{- end }}
if [ -z "$agents" ]; then
  log "no claude or codex CLI in agent_clis for this machine; skipping plugin install reconcile."
else
  # shellcheck disable=SC2086
  run_timed "reconcile agent plugin installs" \
    "$reconciler" --apply --plugins-root "$HOME/.agents/plugins" $agents
fi
