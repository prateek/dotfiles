{{ template "script_lib.sh" . }}

# materialize-agent-plugins sha256: {{ include (printf "%s/../.agents/skills/agent-skill-management/scripts/materialize-agent-plugins" .chezmoi.sourceDir) | sha256sum }}
# reconcile-agent-plugins sha256: {{ include (printf "%s/../.agents/skills/agent-skill-management/scripts/reconcile-agent-plugins" .chezmoi.sourceDir) | sha256sum }}
# agent_skill_lib.py sha256: {{ include (printf "%s/../.agents/skills/agent-skill-management/scripts/agent_skill_lib.py" .chezmoi.sourceDir) | sha256sum }}
# policy sha256: {{ include ".chezmoidata/agent_plugins.toml" | sha256sum }}
# codex_rpc.py sha256: {{ include (printf "%s/../.agents/skills/agent-skill-management/scripts/codex_rpc.py" .chezmoi.sourceDir) | sha256sum }}
# retire-legacy-agent-packages sha256: {{ include (printf "%s/../.agents/skills/agent-skill-management/scripts/retire-legacy-agent-packages" .chezmoi.sourceDir) | sha256sum }}
# agent-marketplace tree sha256: {{ includeTemplate "agent-marketplace-tree-hash.tmpl" . }}

set -euo pipefail

{{- $f := includeTemplate "features.tmpl" . | fromJson }}

generator="{{ .chezmoi.sourceDir }}/../.agents/skills/agent-skill-management/scripts/materialize-agent-plugins"
reconciler="{{ .chezmoi.sourceDir }}/../.agents/skills/agent-skill-management/scripts/reconcile-agent-plugins"

[ -x "$generator" ] || die "Agent plugin materializer is missing or not executable: $generator"
[ -x "$reconciler" ] || die "Agent plugin reconciler is missing or not executable: $reconciler"
have uv || die "uv is required to build agent plugins. Run just tools in agent-marketplace first."
have just || die "just is required to build agent plugins. Install the core package group, or brew install just."

# `just build` defaults to `uv run --offline`, and nothing in apply syncs the
# project venv, so a cold uv cache fails the build. Default to an online runner
# without overriding a caller's; the consumer suite passes an empty one.
export MARKETPLACE_RUN="${MARKETPLACE_RUN-uv run --frozen}"

run_timed "materialize agent plugins" \
  "$generator" \
  --plugins-root "$HOME/.agents/plugins"

agents=""
{{- range $f.agent_clis }}
{{- if or (eq . "claude") (eq . "codex") }}
have {{ . }} || die "{{ . }} is listed in agent_clis but not on PATH; install it before agent plugins can reconcile."
agents="$agents --agent {{ . }}"
{{- end }}
{{- end }}
if [ -z "$agents" ]; then
  log "no claude or codex CLI in agent_clis for this machine; skipping plugin install reconcile."
else
  # shellcheck disable=SC2086
  run_timed "reconcile agent plugin installs" \
    "$reconciler" --apply --plugins-root "$HOME/.agents/plugins" $agents
fi

"{{ .chezmoi.sourceDir }}/../.agents/skills/agent-skill-management/scripts/retire-legacy-agent-packages"
