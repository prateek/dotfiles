{{ template "script_lib.sh" . }}

# machines.toml sha256: {{ include ".chezmoidata/machines.toml" | sha256sum }}
# register-wiki-automations sha256: {{ include (printf "%s/../scripts/agent-sessions/register-wiki-automations" .chezmoi.sourceDir) | sha256sum }}
# sync launch agent sha256: {{ include "Library/LaunchAgents/com.prateek.wiki-sessions-sync.plist.tmpl" | sha256sum }}
# agentsview modify template sha256: {{ include "private_dot_agentsview/modify_private_config.toml.tmpl" | sha256sum }}

set -euo pipefail

{{- $f := includeTemplate "features.tmpl" . | fromJson }}

helper="{{ .chezmoi.sourceDir }}/../scripts/agent-sessions/register-wiki-automations"
sync_label="com.prateek.wiki-sessions-sync"
sync_plist="$HOME/Library/LaunchAgents/$sync_label.plist"
clone="$HOME/code/github.com/prateek/wiki-agent-sessions"
remote="git@github.com:prateek/wiki-agent-sessions.git"

{{- if not $f.agent_session_wiki }}

# Kill switch: leaving the feature means disabling the scheduled automations
# and unloading the sync launch agent, not just skipping registration.
# Chezmoi ignores (but does not delete) the plist once the feature is off.
launchctl bootout "gui/$(id -u)/$sync_label" 2>/dev/null || true
rm -f "$sync_plist"
if command -v orca >/dev/null 2>&1 && [ -x "$helper" ]; then
  "$helper" --disable || warn "could not disable wiki automations; run: $helper --disable"
else
  log "agent_session_wiki disabled; nothing to do."
fi

{{- else if not $f.run_install_scripts }}

# run_install_scripts off is a pause, not the kill switch: leave the loaded
# launch agent and automations alone.
log "install scripts disabled; skipping session-wiki bootstrap."

{{- else }}

if [ -d "$clone/.git" ]; then
  actual="$(git -C "$clone" remote get-url origin 2>/dev/null || true)"
  case "$actual" in
    "$remote"|"https://github.com/prateek/wiki-agent-sessions"*) ;;
    *) die "clone at $clone has unexpected remote '$actual'; refusing to touch it" ;;
  esac
else
  if ! git ls-remote --heads "$remote" >/dev/null 2>&1; then
    warn "cannot reach $remote (missing SSH credentials?); skipping session-wiki bootstrap."
    warn "recover with: git clone $remote $clone && $helper --enable"
    exit 0
  fi
  mkdir -p "$(dirname "$clone")"
  run_timed "clone wiki-agent-sessions" git clone --quiet "$remote" "$clone"
fi

# The plist sha comment above makes plist edits refire this script; launchd
# creates the log file but not its directory.
mkdir -p "$HOME/.local/state/dotfiles/wiki-sessions-sync"
chmod 700 "$HOME/.local/state/dotfiles/wiki-sessions-sync"
# bootout SIGTERMs a live instance mid-commit/push; runs take ~15s, so wait
# out an in-flight sync before reloading.
tries=0
while launchctl print "gui/$(id -u)/$sync_label" 2>/dev/null | grep -q 'state = running' \
    && [ "$tries" -lt 18 ]; do
  sleep 5
  tries=$((tries + 1))
done
launchctl bootout "gui/$(id -u)/$sync_label" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$sync_plist" 2>/dev/null || true
if launchctl print "gui/$(id -u)/$sync_label" >/dev/null 2>&1; then
  log "loaded launch agent $sync_label"
  # First fire would otherwise wait for the next :00; an immediate run also
  # smoke-tests PATH/auth on this machine.
  launchctl kickstart "gui/$(id -u)/$sync_label" 2>/dev/null || true
else
  # Safe to continue: the helper keeps the legacy Orca automation until the
  # agent loads.
  warn "could not load $sync_label (no GUI session?); load manually: launchctl bootstrap gui/\$(id -u) $sync_plist"
fi

{{- if $f.agent_session_wiki_ingest }}
run_timed "reconcile wiki automations (ingest)" "$helper" --enable --ingest || \
  warn "automation reconcile incomplete; re-run: $helper --enable --ingest"
{{- else }}
run_timed "reconcile wiki automations" "$helper" --enable || \
  warn "automation reconcile incomplete; re-run: $helper --enable"
{{- end }}

# The agentsview modify template regenerates [[session_sources]] on every
# apply; a restart is how the daemon picks the file up.
if have agentsview; then
  run_timed "restart agentsview daemon" agentsview serve --background --replace || \
    warn "agentsview restart failed; restart manually: agentsview serve --background --replace"
else
  warn "agentsview not installed; cross-host session browsing is off until it is (then: agentsview serve --background --replace)"
fi

{{- end }}
