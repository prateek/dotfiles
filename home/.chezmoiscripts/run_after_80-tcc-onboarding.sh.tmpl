{{- $f := includeTemplate "features.tmpl" . | fromJson -}}
{{- if and (eq .chezmoi.os "darwin") $f.run_install_scripts $f.tcc_onboarding -}}
{{ template "script_lib.sh" . }}

installer={{ printf "%s/../scripts/macos/install-tcc-onboarding" .chezmoi.sourceDir | replace "'" "'\\''" | printf "'%s'" }}
manifest={{ printf "%s/.config/dotfiles/tcc.json" .chezmoi.homeDir | replace "'" "'\\''" | printf "'%s'" }}
if app=$("$installer"); then
  :
else
  status=$?
  if [ "$status" = 75 ]; then
    warn "Permission helper update deferred; quit it (⌘Q) and rerun chezmoi apply to update."
    [ -n "$app" ] || exit 0
  elif [ "$status" = 73 ]; then
    warn "Permission helper installation is already in progress; retry chezmoi apply later."
    exit 0
  elif [ "$status" = 69 ]; then
    warn "Permission helper unavailable without a Swift toolchain; review expected grants from $manifest in System Settings → Privacy & Security."
    exit 0
  else
    die "Permission helper installation failed (exit $status)."
  fi
fi
binary="$app/Contents/MacOS/DotfilesPermissions"
resume() { printf 'Review permissions: open -a %q %q\n' "$app" "$manifest"; }
# Never send unknown flags to legacy helpers: they enter the GUI event loop.
audit_version=$(plutil -extract DotfilesPermissionsAuditVersion raw "$app/Contents/Info.plist" 2>/dev/null || true)
if [ "$audit_version" != 1 ]; then
  warn "Permission audit unavailable: installed helper needs a CLI update. Quit it (⌘Q) and rerun chezmoi apply."
  resume
  exit 0
fi
if "$binary" --audit "$manifest"; then
  exit 0
else
  status=$?
fi
case "$status" in
  2|3) resume ;;
  64) die "Invalid or unreadable permission manifest: $manifest" ;;
  *) die "Permission audit failed (exit $status); recorded access remains unknown." ;;
esac
{{- end -}}
