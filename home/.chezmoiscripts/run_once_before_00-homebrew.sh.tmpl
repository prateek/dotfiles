{{ template "script_lib.sh" . }}

{{- $f := includeTemplate "features.tmpl" . | fromJson -}}
{{- if $f.run_install_scripts }}
brew_shellenv
if have brew; then
  exit 0
fi

log "Installing Homebrew."
dotfiles_sudo_start "Homebrew install needs administrator access. Enter your password if prompted."
if [ "$(uname -s)" = "Linux" ] && have apt-get; then
  # Homebrew on Linux needs a compiler and file(1); the installer does not add
  # them. A fresh image can carry stale package lists, so refresh them first.
  run_timed "apt update" sudo env DEBIAN_FRONTEND=noninteractive apt-get update -qq
  run_timed "apt prerequisites" sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq build-essential procps curl file git
fi
NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
brew_shellenv
have brew || die "Homebrew install finished but brew is not on PATH."
{{- else }}
log "Install scripts disabled; skipping Homebrew setup."
{{- end }}
