{{ template "script_lib.sh" . }}

# zshenv sha256: {{ include "dot_zshenv.tmpl" | sha256sum }}
# zshrc sha256: {{ include "dot_config/zsh/dot_zshrc" | sha256sum }}
# packages.toml sha256: {{ include ".chezmoidata/packages.toml" | sha256sum }}

checks_failed=0

check_file() {
  local path="$1"
  if [ -e "$path" ]; then
    log "ok: $path"
  else
    warn "missing: $path"
    checks_failed=$((checks_failed + 1))
  fi
}

check_file "$HOME/.zshenv"
check_file "${ZDOTDIR:-$HOME/.config/zsh}/.zshrc"

if [ {{ (includeTemplate "features.tmpl" . | fromJson).secrets_enabled | quote }} != "true" ]; then
  log "secrets disabled; sign in to 1Password and enable [data.machines_local] secrets_enabled = true when needed."
fi

{{- if eq (includeTemplate "package-cask-enabled.tmpl" (dict "root" . "name" "tartelet")) "true" }}
check_file "/Applications/Tartelet.app"
check_file "$HOME/Library/LaunchAgents/com.prateek.tartelet-runner.plist"
check_file "$HOME/Library/Preferences/dk.shape.Tartelet.plist"
# Golden VM and credentials are not chezmoi-managed: the VM is built on demand
# (scripts/vm/build-runner-image.sh) and credentials are entered once in Tartelet's
# UI. Surface their status without failing the apply.
if command -v tart >/dev/null 2>&1; then
  if tart list --quiet --source local 2>/dev/null | grep -qx {{ (includeTemplate "features.tmpl" . | fromJson).runner_vm_name | quote }}; then
    log "ok: golden runner VM {{ (includeTemplate "features.tmpl" . | fromJson).runner_vm_name | quote }} present"
  else
    log "note: golden runner VM {{ (includeTemplate "features.tmpl" . | fromJson).runner_vm_name | quote }} not built yet — run scripts/vm/build-runner-image.sh on the runner host."
  fi
fi
log "reminder: enter Tartelet's GitHub App credentials once in the UI; see docs/runbooks/tartelet-runner-setup.md."
{{- end }}

{{- $f := includeTemplate "features.tmpl" . | fromJson }}
{{- if $f.agent_session_wiki }}
# Session-archive status. Registration failures never fail the apply (script 38
# warns and exits 0); surface them here so an incomplete bootstrap is visible.
# --check is read-only and compares the exact cone, filter, and stray paths,
# so the same helper both reports drift and repairs it.
wiki_reconcile=("{{ .chezmoi.sourceDir }}/../scripts/agent-sessions/reconcile-wiki-clone"
  --clone "$HOME/code/github.com/prateek/wiki-agent-sessions"
  --remote git@github.com:prateek/wiki-agent-sessions.git
  {{ if $f.agent_session_wiki_sparse }}--sparse --alias "{{ $f.wiki_host_alias | default "" }}"{{ else }}--full{{ end }})
if wiki_drift="$("${wiki_reconcile[@]}" --check 2>&1)"; then
  log "ok: wiki-agent-sessions clone in shape ({{ if $f.agent_session_wiki_sparse }}sparse{{ else }}full{{ end }})"
else
  log "wiki-agent-sessions clone drifted: ${wiki_drift:-unknown}; run: ${wiki_reconcile[*]}"
fi
if launchctl print "gui/$(id -u)/com.prateek.wiki-sessions-sync" >/dev/null 2>&1; then
  log "ok: hourly sync launch agent loaded (com.prateek.wiki-sessions-sync)"
else
  log "hourly sync launch agent not loaded; recover with: launchctl bootstrap gui/\$(id -u) $HOME/Library/LaunchAgents/com.prateek.wiki-sessions-sync.plist"
fi
if command -v orca >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  enabled="$(orca automations list --json 2>/dev/null | jq -r '(.result.automations // .automations // [])[] | select(.name | startswith("wiki-sessions-")) | "\(.name)=\(.enabled)"' | sort | tr '\n' ' ')"
{{- if $f.agent_session_wiki_ingest }}
  recover="{{ .chezmoi.sourceDir }}/../scripts/agent-sessions/register-wiki-automations --enable --ingest"
{{- else }}
  recover="{{ .chezmoi.sourceDir }}/../scripts/agent-sessions/register-wiki-automations --enable"
{{- end }}
  drift=""
  case "$enabled" in
    *wiki-sessions-sync=*) drift="legacy sync automation still registered (launchd owns the hourly sync)" ;;
  esac
{{- if $f.agent_session_wiki_ingest }}
  case "$enabled" in
    *wiki-sessions-ingest=true*) ;;
    *) drift="${drift:+$drift; }ingest automation not enabled" ;;
  esac
{{- else }}
  case "$enabled" in
    *wiki-sessions-ingest=true*) drift="${drift:+$drift; }ingest automation enabled but this host does not own the ingest role" ;;
  esac
{{- end }}
  if [ -z "$drift" ]; then
    log "ok: wiki automations as expected (${enabled:-none})"
  else
    log "wiki automations drifted ($drift; have: '${enabled:-none}'); run: $recover"
  fi
else
  log "cannot verify wiki automations (orca or jq missing); when installed, run: {{ .chezmoi.sourceDir }}/../scripts/agent-sessions/register-wiki-automations --enable"
fi
{{- end }}

if [ "$checks_failed" -gt 0 ]; then
  exit 1
fi
