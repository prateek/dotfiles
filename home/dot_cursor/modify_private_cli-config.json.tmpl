#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.14"
# dependencies = []
# ///
"""Deep-merge chezmoi's desired Cursor CLI keys into ~/.cursor/cli-config.json.

Desired wins on conflicts; unrelated keys pass through untouched. That matters
more here than for the other agent configs: Cursor writes auth, model, approval,
and team state into this same file, and a full rewrite would log the CLI out.
An already-correct file is echoed byte-for-byte so apply never churns Cursor's
own formatting. Pass-through only covers the snapshot chezmoi puts on stdin: a
Cursor write landing between that read and the write-back is lost, so applying
mid-login can drop a refreshed token. Malformed input propagates from
`json.loads` to chezmoi. See SKILL.md and ADR 0007 for the override model and
the stale-key trade-off.
"""
import base64
import json
import sys

desired = json.loads(
    base64.b64decode(
        "{{ includeTemplate "cursor-cli-config-managed.json.tmpl" . | b64enc }}"
    ).decode()
)


def deep_merge(base, overlay):
    """Deep-merge overlay into base in place; overlay wins on conflicts."""
    for key, value in overlay.items():
        existing = base.get(key)
        if isinstance(existing, dict) and isinstance(value, dict):
            deep_merge(existing, value)
        else:
            base[key] = value
    return base


def load(text):
    return json.loads(text) if text.strip() else {}


current_text = sys.stdin.read()
original = load(current_text)
merged = deep_merge(load(current_text), desired)

if original == merged:
    sys.stdout.write(current_text)
else:
    sys.stdout.write(json.dumps(merged, indent=2) + "\n")
