{{- $plugins := dict -}}
{{- range $name, $policy := .agent_plugins -}}
{{- if $policy.claude -}}
{{- $_ := set $plugins (printf "%s@prateek-local" $name) (dict "enabled" $policy.default_loaded) -}}
{{- end -}}
{{- end -}}
{{- dict "schemaVersion" 1 "marketplaces" (dict "prateek-local" (dict "source" (printf "%s/.agents/plugins" .chezmoi.homeDir) "autoupdate" false)) "plugins" $plugins | toPrettyJson -}}
