{{- $plugins := dict -}}
{{- range $name, $policy := .agent_plugins -}}
{{- if $policy.claude -}}
{{- $_ := set $plugins (printf "%s@prateek-local" $name) (dict "enabled" $policy.default_loaded) -}}
{{- end -}}
{{- end -}}
{{- $markets := dict "prateek-local" (dict "source" (printf "%s/.agents/plugins" .chezmoi.homeDir) "autoupdate" false) -}}
{{- range (get . "agent_upstream_plugins" | default (list)) -}}
{{- if .claude -}}
{{- $_ := set $markets .marketplace (dict "source" (printf "https://github.com/%s.git" .repository) "autoupdate" false) -}}
{{- $_ := set $plugins (printf "%s@%s" .plugin .marketplace) (dict "enabled" .default_loaded) -}}
{{- end -}}
{{- end -}}
{{- $wo := includeTemplate "work-overlay.tmpl" . | fromJson -}}
{{- if $wo.marketplace -}}
{{-   $_ := set $markets $wo.marketplace (dict "source" $wo.plugins "autoupdate" false) -}}
{{-   range $wo.claude_plugins -}}
{{-     $_ := set $plugins (printf "%s@%s" . $wo.marketplace) (dict "enabled" true) -}}
{{-   end -}}
{{- end -}}
{{- dict "schemaVersion" 1 "marketplaces" $markets "plugins" $plugins | toPrettyJson -}}
