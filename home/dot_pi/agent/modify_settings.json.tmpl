#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.14"
# dependencies = []
# ///
"""Merge durable pi package settings into ~/.pi/agent/settings.json.

The npm command and telemetry opt-outs are managed directly. Managed packages
come from the pi entry in .chezmoidata/agents.toml, in order, and replace live
entries for the same package; other live entries are kept. Unrelated live preferences
such as provider, model, theme, changelog state, and trust decisions pass through
untouched.
"""
import json
import sys

NPM_COMMAND = ["mise", "exec", "node", "--", "npm"]
REQUIRED_PACKAGES = {{ .agents.pi.packages | toJson }}
PI_VIM_SETTINGS = {
    "clipboardMirror": "yank",
    "modeColors": {
        "insert": "borderMuted",
        "normal": "borderAccent",
        "ex": "warning",
    },
    "syncBorderColorWithMode": True,
}
# Install telemetry also gates provider attribution headers; analytics is opt-in today.
TELEMETRY_SETTINGS = {"enableInstallTelemetry": False, "enableAnalytics": False}
STATUS_LINE_SETTINGS = {
    "type": "command",
    "command": "~/.pi/agent/statusline.sh",
    "placement": "footer",
    "debounceMs": 300,
}


def load_current(text: str) -> dict:
    if not text.strip():
        return {}
    value = json.loads(text)
    return value if isinstance(value, dict) else {}


def identity(entry) -> str:
    """Pi's package identity: npm name or git URL without the version or ref."""
    source = entry.get("source", "") if isinstance(entry, dict) else str(entry)
    if source.startswith("npm:"):
        name = source[4:]
        return "npm:" + (name[: name.index("@", 1)] if "@" in name[1:] else name)
    if source.startswith(("git:", "http://", "https://", "ssh://", "git@")):
        head, slash, tail = source.rpartition("/")
        return head + slash + tail.split("@", 1)[0]
    return source


def semantic_equal(left: str, right: str) -> bool:
    try:
        return json.loads(left) == json.loads(right)
    except Exception:
        return False


current_text = sys.stdin.read()
current = load_current(current_text)
current["npmCommand"] = NPM_COMMAND
current.update(TELEMETRY_SETTINGS)
packages = current.get("packages")
if not isinstance(packages, list):
    packages = []
managed = {identity(package) for package in REQUIRED_PACKAGES}
packages = REQUIRED_PACKAGES + [package for package in packages if identity(package) not in managed]
current["packages"] = packages
pi_vim = current.get("piVim")
if not isinstance(pi_vim, dict):
    pi_vim = {}
mode_colors = pi_vim.get("modeColors")
if not isinstance(mode_colors, dict):
    mode_colors = {}
mode_colors.update(PI_VIM_SETTINGS["modeColors"])
pi_vim.update({key: value for key, value in PI_VIM_SETTINGS.items() if key != "modeColors"})
pi_vim["modeColors"] = mode_colors
current["piVim"] = pi_vim
# Pi has one active command statusline; keep that renderer owned as a unit.
current["statusLine"] = STATUS_LINE_SETTINGS

merged_text = json.dumps(current, indent=2) + "\n"
sys.stdout.write(current_text if semantic_equal(current_text, merged_text) else merged_text)
