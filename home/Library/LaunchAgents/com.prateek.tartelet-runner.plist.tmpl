{{- $f := includeTemplate "features.tmpl" . | fromJson -}}
{{- $start := dig "runner_start_on_launch" false $f -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  runner_start_on_launch controls both this login service and Tartelet's
  startVirtualMachinesOnLaunch setting. Gated in .chezmoiignore on the tartelet
  cask. See the runner runbook for stopping or re-enabling an existing service.

  Runner-guest LAN isolation is not set here. Tartelet cannot pass networking flags
  to `tart run`, so the tart wrapper at /opt/homebrew/bin/tart adds --net-softnet
  instead (installed by run_after_18-tartelet-tart-softnet-wrapper). See the runbook.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.prateek.tartelet-runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Tartelet.app/Contents/MacOS/Tartelet</string>
  </array>
  <key>RunAtLoad</key>
  <{{ $start }}/>
  <key>KeepAlive</key>
  <{{ $start }}/>
  <key>Disabled</key>
  <{{ not $start }}/>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
</dict>
</plist>
