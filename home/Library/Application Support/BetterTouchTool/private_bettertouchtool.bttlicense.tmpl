{{- /*
  BetterTouchTool license file. Materialized only when secrets_enabled=true
  AND .secrets.refs.bettertouchtool_license is a real op:// reference.

  Verify the target path on first `chezmoi apply --dry-run`. BTT typically
  installs to ~/Library/Application Support/BetterTouchTool/bettertouchtool.bttlicense
  but new major versions sometimes relocate.

  Set the ref locally:
      chezmoi edit-config
  and add:
      [data.secrets.refs]
      bettertouchtool_license = "op://<vault>/<item>/<field>"
  Then enable [data.machines_local] secrets_enabled = true and run: chezmoi apply

  While the ref is empty, .chezmoiignore skips this target.
*/ -}}
{{- if (includeTemplate "features.tmpl" . | fromJson).secrets_enabled -}}
{{-   with .secrets.refs.bettertouchtool_license -}}
{{ onepasswordRead . }}
{{-   end -}}
{{- end -}}
