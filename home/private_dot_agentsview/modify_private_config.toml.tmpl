#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.14"
# dependencies = ["tomlkit>=0.13"]
# ///
"""Manage the dotfiles-owned keys in ~/.agentsview/config.toml.

Two managed surfaces, everything else round-trips untouched (auth_token,
cursor_secret, hand-written entries) preserved verbatim by tomlkit:

- [agents.codex] homes: Orca launches Codex with its own CODEX_HOME instead of
  ~/.codex (see home/dot_agents/docs/agentsview.md): codex-runtime-home/home,
  plus one codex-accounts/<id>/home per signed-in account. Each is registered
  as an agentsview alternate home, which scans sessions/ and
  archived_sessions/ and reads the home's title and history sidecars. dirs
  stays pinned to the stock ~/.codex roots: without it agentsview derives
  them from CODEX_HOME, which Orca exports into every terminal it launches,
  so a daemon started from one would drop ~/.codex. agentsview does not glob
  homes, so they are enumerated at script runtime. Only paths this generator
  produces are reconciled; every other home, including hand-added ones
  elsewhere under the Orca tree, keeps its place and comments. Generation and
  reconciliation must stay identical to the wiki repo's sync-sessions, which
  reconciles the same list hourly between applies; a fixture test enforces
  parity. agentsview 0.43 refuses to load a
  config that also sets the legacy top-level codex_sessions_dirs, so that key
  is removed.

- [[session_sources]]: cross-host roots from the wiki-agent-sessions clone
  (agentsview's documented topology for git-transported native layouts, with
  per-root machine labels). Entries are additive to agentsview defaults.
  Globbed at script runtime so a host added to the archive lands on the next
  apply with no source change; only entries whose dir is under the clone are
  reconciled, and the current host is excluded to avoid parsing local sessions
  twice. Generation must stay behaviorally identical to repo_session_sources()
  in the wiki repo's sync-sessions script; a fixture test enforces parity.
"""
import json
import os
import sys
from pathlib import Path

import tomlkit

STOCK_CODEX_DIRS = [
    "{{ .chezmoi.homeDir }}/.codex/sessions",
    "{{ .chezmoi.homeDir }}/.codex/archived_sessions",
]
APP_SUPPORT = Path("{{ .chezmoi.homeDir }}/Library/Application Support")
ORCA_BUILDS = ("orca", "orca-dev")
CLONE = Path(os.environ.get(
    "WIKI_SESSIONS_CLONE",
    "{{ .chezmoi.homeDir }}/code/github.com/prateek/wiki-agent-sessions",
))
SELF_HOST = os.environ.get(
    "WIKI_SESSIONS_HOST",
    "{{ dig "wiki_host_alias" "" (includeTemplate "features.tmpl" . | fromJson) }}",
)


def repo_session_sources(clone: Path, self_host: str) -> list[dict]:
    entries = []
    sessions = clone / "sessions"
    if not sessions.is_dir():
        return entries
    for host_dir in sorted(sessions.iterdir()):
        if not host_dir.is_dir() or host_dir.name == self_host:
            continue
        roots = [("claude", host_dir / "claude/projects"),
                 ("cursor", host_dir / "cursor/projects")]
        codex = host_dir / "codex"
        if codex.is_dir():
            roots += [("codex", d) for d in sorted(codex.iterdir()) if d.is_dir()]
        for agent, root in roots:
            if root.is_dir():
                entries.append({"agent": agent, "dir": str(root), "machine": host_dir.name})
    return entries


def orca_codex_homes(app_support: Path) -> list[str]:
    homes = []
    for build in ORCA_BUILDS:
        candidates = [app_support / build / "codex-runtime-home/home"]
        accounts = app_support / build / "codex-accounts"
        if accounts.is_dir():
            candidates += [d / "home" for d in sorted(accounts.iterdir()) if not d.name.startswith(".")]
        homes += [str(home) for home in candidates if home.is_dir()]
    return homes


def is_orca_home(home, app_support: Path) -> bool:
    path = Path(str(home)).expanduser()
    for build in ORCA_BUILDS:
        if path == app_support / build / "codex-runtime-home/home":
            return True
        account = path.parent
        if (path.name == "home" and account.parent == app_support / build / "codex-accounts"
                and not account.name.startswith(".")):
            return True
    return False


def reconcile_codex_homes(doc, app_support: Path) -> bool:
    desired = orca_codex_homes(app_support)
    raw = doc.get("agents", {}).get("codex", {}).get("homes")
    current = [raw] if isinstance(raw, str) else [str(h) for h in raw or []]
    kept = [h for h in current if not is_orca_home(h, app_support)]
    if isinstance(raw, tomlkit.items.Array):
        if kept + desired == current:
            return False
        # Edit in place so the other entries keep their order and comments.
        for i in reversed(range(len(raw))):
            if is_orca_home(raw[i], app_support):
                del raw[i]
        for home in desired:
            raw.append(home)
    elif raw is None and not desired:
        return False
    else:
        if "agents" not in doc:
            doc["agents"] = tomlkit.table(is_super_table=True)
        if "codex" not in doc["agents"]:
            doc["agents"]["codex"] = tomlkit.table()
        doc["agents"]["codex"]["homes"] = kept + desired
    codex = doc["agents"]["codex"]
    if not codex["homes"]:
        del codex["homes"]
    return True


def flag_args(flag: str, usage: str) -> list[str] | None:
    if flag not in sys.argv:
        return None
    count = len(usage.split())
    args = sys.argv[sys.argv.index(flag) + 1:][:count]
    if len(args) < count:
        sys.exit(f"usage: {Path(sys.argv[0]).name} {flag} {usage}")
    return args


def semantic_equal(left: str, right: str) -> bool:
    try:
        return tomlkit.loads(left).unwrap() == tomlkit.loads(right).unwrap()
    except Exception:
        return False


def is_repo_entry(entry) -> bool:
    try:
        return Path(str(entry.get("dir", ""))).is_relative_to(CLONE)
    except ValueError:
        return False


if (args := flag_args("--print-codex-homes", "<app-support-dir>")) is not None:
    print(json.dumps(orca_codex_homes(Path(args[0]))))
    sys.exit(0)

if (args := flag_args("--reconcile-codex-homes", "<app-support-dir>")) is not None:
    doc = tomlkit.loads(sys.stdin.read())
    reconcile_codex_homes(doc, Path(args[0]))
    sys.stdout.write(tomlkit.dumps(doc))
    sys.exit(0)

if (args := flag_args("--print-session-sources", "<clone> <self-host>")) is not None:
    print(json.dumps(repo_session_sources(Path(args[0]), args[1])))
    sys.exit(0)

current_text = sys.stdin.read()
doc = tomlkit.loads(current_text) if current_text.strip() else tomlkit.document()
doc.pop("codex_sessions_dirs", None)
agents = doc.get("agents") or tomlkit.table(is_super_table=True)
codex = agents.get("codex") or tomlkit.table()
codex["dirs"] = STOCK_CODEX_DIRS
agents["codex"] = codex
doc["agents"] = agents
reconcile_codex_homes(doc, APP_SUPPORT)

desired = repo_session_sources(CLONE, SELF_HOST)
existing = doc.get("session_sources")
# Hand-written entries are re-appended as their original tomlkit items so
# comments and formatting survive; only clone-owned entries are regenerated.
kept = [e for e in existing or [] if not is_repo_entry(e)]
if kept or desired:
    aot = tomlkit.aot()
    for entry in kept:
        aot.append(entry)
    for entry in desired:
        item = tomlkit.table()
        for key, value in entry.items():
            item[key] = value
        aot.append(item)
    doc["session_sources"] = aot
elif existing is not None:
    del doc["session_sources"]

merged_text = tomlkit.dumps(doc)
sys.stdout.write(current_text if semantic_equal(current_text, merged_text) else merged_text)
