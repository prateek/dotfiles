#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.14"
# dependencies = []
# ///
"""Set agent_cmd in ~/.crit.config.json.

crit's "send to agent" button runs the configured agent_cmd. Full-access claude
(upstream's recommended mode) answers the comment and can make the edit
directly; crit's file watching picks the change up. Machines whose
machines.toml agent_clis lacks claude get the key removed instead, so the
button never points at a missing binary.

Only agent_cmd is touched. crit's own keys (auth_token, share_consented,
auth_user_*, live_cookie, and anything else crit or the user has written)
round-trip untouched. crit honors agent_cmd only from this global file for
security, not from a project .crit.config.json.
"""
import json
import sys

AGENT_CMD = {{ if has "claude" ((includeTemplate "features.tmpl" . | fromJson).agent_clis | default (list)) }}"claude --dangerously-skip-permissions -p"{{ else }}None{{ end }}


def load_current(text: str) -> dict:
    if not text.strip():
        return {}
    value = json.loads(text)
    return value if isinstance(value, dict) else {}


def semantic_equal(left: str, right: str) -> bool:
    try:
        return json.loads(left) == json.loads(right)
    except Exception:
        return False


current_text = sys.stdin.read()
current = load_current(current_text)
if AGENT_CMD is None:
    current.pop("agent_cmd", None)
else:
    current["agent_cmd"] = AGENT_CMD

if not current and not current_text.strip():
    # A machine that sets nothing should not materialize the file.
    sys.stdout.write(current_text)
else:
    merged_text = json.dumps(current, indent=2, ensure_ascii=False) + "\n"
    sys.stdout.write(current_text if semantic_equal(current_text, merged_text) else merged_text)
