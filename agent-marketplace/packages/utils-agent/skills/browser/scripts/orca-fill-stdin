#!/usr/bin/env python3
"""Fill and verify one Orca input from stdin; leave the form unsubmitted."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import socket
import subprocess
import sys
import uuid
from urllib.parse import urlsplit


class Failure(Exception):
    pass


def rpc(method, params):
    root = Path(
        os.environ.get(
            "ORCA_USER_DATA_PATH", Path.home() / "Library/Application Support/orca"
        )
    )
    metadata = json.loads((root / "orca-runtime.json").read_text())
    endpoint = next(
        t["endpoint"] for t in metadata["transports"] if t["kind"] == "unix"
    )
    request_id = str(uuid.uuid4())
    request = {
        "id": request_id,
        "authToken": metadata["authToken"],
        "method": method,
        "params": params,
    }
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
        conn.settimeout(45)
        conn.connect(endpoint)
        conn.sendall((json.dumps(request) + "\n").encode())
        with conn.makefile("rb") as stream:
            for line in stream:
                if len(line) > 1024 * 1024:
                    raise Failure("oversized runtime reply")
                frame = json.loads(line)
                if frame.get("_keepalive"):
                    continue
                if frame.get("id") != request_id or frame.get("ok") is not True:
                    # Runtime errors may include the attempted value or page content.
                    raise Failure(f"{method} failed; response withheld")
                return frame["result"]
    raise Failure("runtime disconnected")


def evaluate(page, expression):
    return json.loads(
        rpc("browser.eval", {"page": page, "expression": expression})["result"]
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--page", required=True, help="owned browserPageId")
    parser.add_argument("--selector", required=True, help="unique input CSS selector")
    parser.add_argument(
        "--origin",
        required=True,
        help="expected exact origin, e.g. https://example.com",
    )
    parser.add_argument("--type", choices=("password", "text"), default="password")
    parser.add_argument("--enter", action="store_true", help="dispatch Enter keyup after filling")
    args = parser.parse_args()
    try:
        origin = urlsplit(args.origin)
        if (
            origin.scheme not in ("https", "http")
            or not origin.hostname
            or origin.username
            or origin.password
            or origin.path
            or origin.query
            or origin.fragment
        ):
            raise Failure("--origin must contain only scheme, host, and optional port")
        if origin.scheme == "http" and origin.hostname not in (
            "localhost",
            "127.0.0.1",
            "::1",
        ):
            raise Failure("HTTP is allowed only for local test forms")
        if any(
            os.environ.get(key)
            for key in ("ORCA_PAIRING_CODE", "ORCA_REMOTE_PAIRING", "ORCA_ENVIRONMENT")
        ):
            raise Failure("this helper supports only the local macOS runtime")
        if sys.stdin.isatty():
            raise Failure("pipe the value on stdin; interactive entry is disabled")
        value = sys.stdin.buffer.read(4097)
        if not value or len(value) > 4096:
            raise Failure("stdin must contain 1 to 4096 UTF-8 bytes")
        value = value.decode("utf-8")
        version = subprocess.run(
            ["orca", "--version"], capture_output=True, text=True, timeout=10
        )
        if version.returncode or version.stdout.strip() not in ("1.4.212", "1.4.214"):
            raise Failure("unsupported Orca version; revalidate helper before use")
        source = (Path(__file__).with_name("fill-input.js")).read_text()
        def expression(name, *items):
            return source + "\n" + name + "(" + ", ".join(
                json.dumps(item) for item in items
            ) + ")"
        target = (args.origin, args.selector, args.type)
        if evaluate(args.page, expression("prepareInput", *target)) is not True:
            raise Failure("origin or unique editable input check failed")
        rpc("browser.keyboardInsertText", {"page": args.page, "text": value})
        salt = uuid.uuid4().hex
        expected = hashlib.sha256((salt + value).encode("utf-8")).hexdigest()
        def retained():
            return evaluate(args.page, expression("inputDigest", *target, salt)) == expected
        if not retained():
            raise Failure("field did not retain the exact input; no submission attempted")
        if evaluate(args.page, expression("finishInput", *target, args.enter)) is not True:
            raise Failure("field did not retain the exact input; no submission attempted")
        if not args.enter and not retained():
            raise Failure("field did not retain the exact input; no submission attempted")
        print(json.dumps({"filled": True, "verified": True, "submitted": False}))
        return 0
    except Failure as error:
        print(f"orca-fill-stdin: {error}", file=sys.stderr)
        return 1
    except Exception:
        print(
            "orca-fill-stdin: operation failed; details withheld to protect stdin",
            file=sys.stderr,
        )
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
