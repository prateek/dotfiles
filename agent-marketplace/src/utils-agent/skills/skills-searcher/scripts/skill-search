#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.14"
# ///
"""Search for agent SKILL.md files across GitHub-oriented discovery backends."""

from __future__ import annotations

import argparse
import datetime as _dt
import json
import math
from pathlib import Path
import re
import shutil
import shlex
import subprocess
import sys
from typing import Any

BACKENDS = ("gh-skill", "sourcegraph", "github-code", "skills-cli")
TSV_COLUMNS = (
    "sources",
    "stars",
    "installs",
    "file_commits",
    "repo_commits",
    "repo",
    "path",
    "skill_name",
    "namespace",
    "description",
    "url",
    "preview_command",
    "install_command",
)
ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")
WORD_RE = re.compile(r"[A-Za-z0-9_.:/@+-]+")


def compact_error(text: str) -> str:
    text = ANSI_RE.sub("", text)
    lines = [line.strip() for line in text.splitlines() if line.strip()]
    if not lines:
        return ""
    return re.sub(r"\s+", " ", lines[0])[:500]


def parse_json(text: str) -> Any | None:
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        return None


def to_int(value: Any) -> int | None:
    if value is None or value == "":
        return None
    if isinstance(value, bool):
        return None
    if isinstance(value, int):
        return value
    if isinstance(value, float):
        return int(value)
    text = str(value).strip().replace(",", "")
    if not text:
        return None
    multiplier = 1
    if text[-1:].lower() == "k":
        multiplier = 1_000
        text = text[:-1]
    elif text[-1:].lower() == "m":
        multiplier = 1_000_000
        text = text[:-1]
    try:
        return int(float(text) * multiplier)
    except ValueError:
        return None


def strip_github_prefix(repo: str | None) -> str | None:
    if not repo:
        return None
    repo = repo.strip()
    for prefix in ("https://github.com/", "github.com/"):
        if repo.startswith(prefix):
            repo = repo[len(prefix) :]
    return repo.strip("/")


def repo_from_value(value: Any) -> str | None:
    if isinstance(value, str):
        return strip_github_prefix(value)
    if isinstance(value, dict):
        for key in ("full_name", "fullName", "nameWithOwner", "name", "slug"):
            repo = repo_from_value(value.get(key))
            if repo and "/" in repo:
                return repo
    return None


def skill_name_from_path(path: str | None) -> str | None:
    if not path:
        return None
    parts = [part for part in path.split("/") if part]
    if len(parts) < 2:
        return None
    return parts[-2]


def clean_frontmatter_value(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
        return value[1:-1]
    return value


def metadata_from_skill_content(content: str | None) -> dict[str, str]:
    if not content or not content.startswith("---"):
        return {}
    pieces = content.split("---", 2)
    if len(pieces) < 3:
        return {}

    metadata: dict[str, str] = {}
    for line in pieces[1].splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        key = key.strip()
        if key in {"name", "description"}:
            metadata[key] = clean_frontmatter_value(value)
    return metadata


def new_result(source: str, **fields: Any) -> dict[str, Any]:
    result: dict[str, Any] = {
        "sources": [source],
        "stars": None,
        "installs": None,
        "file_commits": None,
        "repo_commits": None,
        "repo": None,
        "path": None,
        "skill_name": None,
        "namespace": None,
        "description": None,
        "url": None,
        "preview_command": None,
        "install_command": None,
    }
    result.update(
        {key: value for key, value in fields.items() if value not in ("", None)}
    )
    fill_commands(result)
    return result


def ordered_sources(sources: list[str]) -> list[str]:
    backend_order = {name: index for index, name in enumerate(BACKENDS)}
    return sorted(
        dict.fromkeys(sources),
        key=lambda source: (backend_order.get(source, len(backend_order)), source),
    )


def fill_commands(result: dict[str, Any]) -> None:
    repo = result.get("repo")
    path = result.get("path")
    skill_name = result.get("skill_name")
    if repo and path:
        result["preview_command"] = (
            f"gh skill preview {shlex.quote(repo)} {shlex.quote(path)}"
        )
        result["install_command"] = (
            f'gh skill install {shlex.quote(repo)} {shlex.quote(path)} --allow-hidden-dirs --dir "$HOME/.agents/skills"'
        )
    elif repo and skill_name:
        target = f"{repo}@{skill_name}"
        result["install_command"] = f"npx skills add {shlex.quote(target)} -g -y"


def backend_status(
    status: str, *, count: int = 0, detail: str | None = None
) -> dict[str, Any]:
    record: dict[str, Any] = {"status": status, "count": count}
    if detail:
        record["detail"] = detail
    return record


def progress(enabled: bool, message: str) -> None:
    if enabled:
        print(f"progress\t{message}", file=sys.stderr, flush=True)


def progress_result(enabled: bool, source: str, result: dict[str, Any]) -> None:
    if not enabled:
        return
    cells = [
        source,
        str(result.get("stars") or ""),
        str(result.get("installs") or ""),
        str(result.get("repo") or ""),
        str(result.get("path") or ""),
        str(result.get("skill_name") or ""),
    ]
    print(
        "result\t" + "\t".join(clean_cell(cell) for cell in cells),
        file=sys.stderr,
        flush=True,
    )


def sourcegraph_query(query: str, limit: int, timeout: int) -> str:
    # Match the term in the SKILL.md path, the repo name, or the frontmatter
    # `name:` / `description:` lines. Body-content matches are excluded because
    # they surface skills that merely mention the term in passing.
    def clause(token: str) -> str:
        esc = re.escape(token)
        return (
            f"(file:{esc} OR repo:{esc} OR content:/(?m)^(name|description):.*{esc}/)"
        )

    tokens = WORD_RE.findall(query)
    terms = " ".join(clause(token) for token in tokens) if tokens else clause(query)
    return f"file:(?i)skill\\.md {terms} select:file count:{limit} timeout:{timeout}s"


def github_code_query(query: str) -> str:
    tokens = WORD_RE.findall(query)
    term = " ".join(tokens) if tokens else query
    return f"{term} filename:skill.md in:file,path"


def result_key(result: dict[str, Any]) -> tuple[str, str]:
    repo = str(result.get("repo") or "")
    path = str(result.get("path") or "")
    skill_name = str(result.get("skill_name") or "")
    if repo and path:
        return repo, path
    if repo and skill_name:
        return repo, f"skill:{skill_name}"
    return str(result.get("url") or ""), skill_name


def merge_results(results: list[dict[str, Any]]) -> list[dict[str, Any]]:
    merged: dict[tuple[str, str], dict[str, Any]] = {}
    for result in results:
        key = result_key(result)
        current = merged.get(key)
        if current is None:
            copied = dict(result)
            copied["sources"] = ordered_sources(copied.get("sources") or [])
            merged[key] = copied
            continue

        current["sources"] = ordered_sources(
            [*current.get("sources", []), *result.get("sources", [])]
        )
        for field in TSV_COLUMNS:
            if field == "sources":
                continue
            if field in {"stars", "installs", "file_commits", "repo_commits"}:
                values = [
                    value
                    for value in (current.get(field), result.get(field))
                    if value is not None
                ]
                current[field] = max(values) if values else None
            elif not current.get(field) and result.get(field):
                current[field] = result[field]
        fill_commands(current)
    return list(merged.values())


def sort_results(
    results: list[dict[str, Any]], sort_by: str, direction: str
) -> list[dict[str, Any]]:
    field = sort_by.replace("-", "_")
    reverse = direction == "desc"

    def value_for(result: dict[str, Any]) -> Any:
        value = result.get(field)
        if field == "sources":
            value = len(result.get("sources") or [])
        return value

    known = [result for result in results if value_for(result) is not None]
    unknown = [result for result in results if value_for(result) is None]

    def key(result: dict[str, Any]) -> tuple[Any, str, str]:
        return (
            value_for(result),
            str(result.get("repo") or ""),
            str(result.get("path") or ""),
        )

    known.sort(key=key, reverse=reverse)
    unknown.sort(
        key=lambda result: (
            str(result.get("repo") or ""),
            str(result.get("path") or ""),
        )
    )
    return [*known, *unknown]


def clean_cell(value: Any) -> str:
    if value is None:
        return ""
    if isinstance(value, list):
        value = ",".join(str(item) for item in value)
    return re.sub(r"\s+", " ", str(value)).strip()


def print_tsv(results: list[dict[str, Any]], *, include_header: bool) -> None:
    if include_header:
        print("\t".join(TSV_COLUMNS))
    for result in results:
        print("\t".join(clean_cell(result.get(column)) for column in TSV_COLUMNS))


def doctor_success_detail(name: str, stdout: str) -> str:
    text = stdout.strip()
    data = parse_json(text)
    if data is None:
        return (compact_error(text) or "ok")[:160]

    if name == "gh-api" and isinstance(data, dict):
        resources = data.get("resources")
        search = resources.get("search") if isinstance(resources, dict) else None
        if isinstance(search, dict):
            remaining = search.get("remaining")
            limit = search.get("limit")
            reset = to_int(search.get("reset"))
            suffix = ""
            if reset:
                reset_time = _dt.datetime.fromtimestamp(
                    reset, tz=_dt.datetime.now().astimezone().tzinfo
                )
                suffix = f"; reset {reset_time:%Y-%m-%d %H:%M:%S %Z}"
            return f"GitHub search remaining {remaining}/{limit}{suffix}"
    if isinstance(data, dict) and isinstance(data.get("Results"), list):
        return f"{len(data['Results'])} sample Sourcegraph result(s)"
    if isinstance(data, dict) and isinstance(data.get("items"), list):
        return f"{len(data['items'])} sample GitHub code result(s)"
    if isinstance(data, list):
        return f"{len(data)} sample result(s)"
    return "ok"


def positive_int(value: str) -> int:
    try:
        parsed = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("must be a positive integer") from exc
    if parsed <= 0:
        raise argparse.ArgumentTypeError("must be a positive integer")
    return parsed


def extract_global_json(argv: list[str]) -> tuple[bool, list[str]]:
    json_output = False
    cleaned: list[str] = []
    for item in argv:
        if item == "--json":
            json_output = True
        else:
            cleaned.append(item)
    return json_output, cleaned


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="skill-search",
        description="Search for agent SKILL.md files across gh skill, Sourcegraph, GitHub code search, and skills.sh.",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Emit structured JSON for search and doctor.",
    )

    subparsers = parser.add_subparsers(dest="command", required=True)

    search = subparsers.add_parser(
        "search", help="Search all available backends and merge results."
    )
    search.add_argument(
        "query", nargs="+", help="Search terms, for example: chezmoi management."
    )
    search.add_argument(
        "-L",
        "--limit",
        type=positive_int,
        default=25,
        help="Maximum merged results to print.",
    )
    search.add_argument(
        "--fetch-limit",
        type=positive_int,
        help="Per-backend fetch budget, independent of --limit (default 25).",
    )
    search.add_argument(
        "--candidate-limit",
        type=positive_int,
        default=30,
        help="Candidate page size in relevance mode (maximum 100).",
    )
    search.add_argument(
        "--relevance",
        action="store_true",
        help="Return candidates for host assessment; --limit sets final shortlist size.",
    )
    search.add_argument(
        "--max-opens",
        type=positive_int,
        default=8,
        help="Content inspection allowance in relevance mode.",
    )
    search.add_argument(
        "--intent",
        help="JSON object with original request, requirements and hard_constraints.",
    )
    search.add_argument(
        "--capabilities",
        help="Host manifest for later content inspections in this run.",
    )
    search.add_argument(
        "--state", help="Explicit private state path; default is automatic XDG storage."
    )
    search.add_argument(
        "--max-calls",
        type=positive_int,
        help="Cap discovery plus enrichment operations across this invocation.",
    )
    search.add_argument(
        "--all",
        action="store_true",
        help="Ask each backend for as many results as this CLI supports.",
    )
    search.add_argument(
        "-s",
        "--sort-by",
        choices=(
            "stars",
            "installs",
            "file-commits",
            "repo-commits",
            "sources",
            "skill-name",
        ),
        default="stars",
        help="Sort field.",
    )
    search.add_argument(
        "-d",
        "--direction",
        choices=("asc", "desc"),
        default="desc",
        help="Sort direction.",
    )
    search.add_argument(
        "--asc",
        dest="direction",
        action="store_const",
        const="asc",
        help="Sort ascending.",
    )
    search.add_argument(
        "--desc",
        dest="direction",
        action="store_const",
        const="desc",
        help="Sort descending.",
    )
    search.add_argument(
        "--timeout",
        type=positive_int,
        default=20,
        help="Per-backend timeout in seconds.",
    )
    search.add_argument(
        "--github-concurrency",
        type=positive_int,
        default=4,
        help="Maximum parallel GitHub API calls during enrichment.",
    )
    search.add_argument(
        "--no-enrich",
        dest="enrich",
        action="store_false",
        help="Skip GitHub stars and commit-count enrichment.",
    )
    search.add_argument("--no-header", action="store_true", help="Omit the TSV header.")
    progress_group = search.add_mutually_exclusive_group()
    progress_group.add_argument(
        "--progress",
        dest="progress",
        action="store_const",
        const="always",
        help="Print progress and incremental results to stderr.",
    )
    progress_group.add_argument(
        "--no-progress",
        dest="progress",
        action="store_const",
        const="never",
        help="Suppress progress output.",
    )
    search.set_defaults(func=command_search, enrich=True, progress="auto")

    raw = subparsers.add_parser(
        "raw", help="Print raw output from one backend for debugging."
    )
    raw.add_argument("backend", choices=BACKENDS)
    raw.add_argument("query", nargs="+")
    raw.add_argument("-L", "--limit", type=positive_int, default=25)
    raw.add_argument("--timeout", type=positive_int, default=20)
    raw.set_defaults(func=command_raw)

    doctor = subparsers.add_parser(
        "doctor", help="Validate local tools and backend connectivity."
    )
    doctor.add_argument("--timeout", type=positive_int, default=20)
    doctor.set_defaults(func=command_doctor)

    return parser


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    json_output, cleaned = extract_global_json(argv)
    parser = build_parser()
    args = parser.parse_args(cleaned)
    args.json = args.json or json_output
    return args.func(args)


ENGINE = Path(__file__).resolve().parents[2] / "search/scripts/agent-search"


def engine_run(
    jobs,
    *,
    discovery,
    enrichment=0,
    timeout=20,
    state=None,
    choices=None,
    intent=None,
    opens=None,
    capabilities=None,
):
    req = {
        "schema_version": 1,
        "prepared_jobs": jobs,
        "choices": choices
        or {"total_limit": sum(j.get("limit", 1) for j in jobs) or 1},
        "budget": {
            "calls": discovery + enrichment,
            "discovery": discovery,
            "enrichment": enrichment,
            "opens": enrichment if opens is None else opens,
            "wall_seconds": timeout * max(1, len(jobs) + enrichment) + 10,
        },
    }
    if intent:
        req["intent"] = intent
    response = subprocess.run(
        [
            sys.executable,
            str(ENGINE),
            "run",
            "--request",
            "-",
            "--no-defaults",
            "--json",
            *(["--state", str(state)] if state else []),
            *(["--capabilities", str(capabilities)] if capabilities else []),
        ],
        input=json.dumps(req),
        capture_output=True,
        text=True,
    )
    if response.returncode:
        raise RuntimeError(
            "Shared search engine rejected request: " + response.stderr[:500]
        )
    return json.loads(response.stdout)


def engine_extend(report, jobs):
    response = subprocess.run(
        [
            sys.executable,
            str(ENGINE),
            "extend",
            "--state",
            report["trace"]["state"],
            "--request",
            "-",
        ],
        input=json.dumps({"schema_version": 1, "prepared_jobs": jobs}),
        capture_output=True,
        text=True,
    )
    if response.returncode:
        raise RuntimeError("Shared search extension failed: " + response.stderr[:500])
    return json.loads(response.stdout)


def discovery_job(name, query, limit, timeout):
    if name == "sourcegraph":
        native = sourcegraph_query(query, limit, timeout)
    elif name == "github-code":
        native = github_code_query(query)
    else:
        native = query
    return {
        "id": name,
        "area": "code",
        "source": "skills" if name == "skills-cli" else "github",
        "operation": "code.discover",
        "provider": name,
        "native_query": {"dialect": name, "text": native},
        "limit": limit,
        "needs": [],
        "timeout": timeout + 10 if name == "sourcegraph" else timeout,
    }


def status_for(report, id):
    out = report["outcomes"].get(id)
    if out:
        mapped = {
            "success": "ok",
            "empty": "ok",
            "schema_error": "failed",
            "unavailable": "missing",
        }.get(out["status"], out["status"])
        return backend_status(mapped, count=out["count"], detail=out.get("detail"))
    coverage = next(c for c in report["coverage"] if c["facet_id"] == id)
    return backend_status(
        "missing" if coverage["outcome"] == "unavailable" else "partial",
        detail=coverage["outcome"],
    )


def skill_rows(name, outcome):
    result = []
    for row in outcome.get("results", []):
        f = row["fields"]
        meta = metadata_from_skill_content(f.get("content"))
        path = f.get("path")
        result.append(
            new_result(
                name,
                repo=f.get("repo"),
                path=path,
                skill_name=f.get("skillName")
                or f.get("skill_name")
                or f.get("name")
                or meta.get("name")
                or skill_name_from_path(path),
                namespace=f.get("namespace"),
                description=f.get("description") or meta.get("description"),
                stars=to_int(f.get("stars")),
                installs=to_int(f.get("installs")),
                url=row["url"],
            )
        )
    return result


def command_search(args):
    query = " ".join(args.query).strip()
    if not query:
        print("skill-search: query is required", file=sys.stderr)
        return 2
    enabled = (
        args.progress == "always" or args.progress == "auto" and sys.stderr.isatty()
    )
    if args.candidate_limit > 100:
        raise RuntimeError(
            "--candidate-limit must be <= 100; page through the saved run for more"
        )
    limit = 1000 if args.all else args.limit
    fetch_limit = args.fetch_limit or (1000 if args.all else 25)
    jobs = [discovery_job(name, query, fetch_limit, args.timeout) for name in BACKENDS]
    for name in BACKENDS:
        progress(enabled, f"backend\tname={name}\tstatus=started")
    discovery = 3 + math.ceil(fetch_limit / 100)
    if args.max_calls is not None:
        discovery = min(discovery, args.max_calls)
    candidate_limit = (
        args.candidate_limit if args.relevance else fetch_limit * len(BACKENDS)
    )
    metadata_calls = 3 * candidate_limit if args.enrich else 0
    inspection_calls = args.max_opens if args.relevance else 0
    enrichment = metadata_calls + inspection_calls
    if args.max_calls is not None:
        enrichment = min(enrichment, max(0, args.max_calls - discovery))
    report = engine_run(
        jobs,
        discovery=discovery,
        enrichment=enrichment,
        timeout=args.timeout,
        state=args.state,
        choices={"total_limit": candidate_limit, "result_limit": limit},
        intent=json.loads(Path(args.intent).read_text())
        if args.intent
        else {
            "request": query,
            "requirements": ["Installable skill with narrow task fit"],
            "hard_constraints": [],
        },
        opens=metadata_calls + inspection_calls,
        capabilities=args.capabilities,
    )
    gathered, statuses = [], {}
    for name in BACKENDS:
        rows = skill_rows(name, report["outcomes"].get(name, {}))
        statuses[name] = status_for(report, name)
        if statuses[name]["status"] == "ok" and name in ("sourcegraph", "github-code"):
            statuses[name]["detail"] = "query=" + next(
                j["native_query"]["text"] for j in jobs if j["id"] == name
            )
        progress(
            enabled,
            f"backend\tname={name}\tstatus={statuses[name]['status']}\tresults={len(rows)}",
        )
        for row in rows:
            progress_result(enabled, name, row)
        gathered.extend(rows)
    if args.relevance:
        merged = []
        for candidate in report["candidates"]:
            name = candidate["observations"][0]["provider"]
            row = skill_rows(name, {"results": [candidate]})[0]
            row.update(
                candidate_id=candidate["candidate_id"],
                evidence_digest=candidate["evidence_digest"],
                observations=candidate["observations"],
                assessment=candidate["assessment"],
            )
            row["sources"] = ordered_sources(
                [o["provider"] for o in candidate["observations"]]
            )
            merged.append(row)
    else:
        merged = merge_results(gathered)
    if args.enrich:
        jobs, targets = [], []
        repos = sorted({r["repo"] for r in merged if r.get("repo")})
        for repo in repos:
            progress(enabled, f"enrich-repo\trepo={repo}")
            targets.extend([(repo, None, "stars"), (repo, None, "repo_commits")])
        for index, row in enumerate(merged):
            if row.get("repo") and row.get("path"):
                progress(
                    enabled, f"enrich-file\trepo={row['repo']}\tpath={row['path']}"
                )
                targets.append((row["repo"], index, "file_commits"))
        for i, (repo, index, metric) in enumerate(targets):
            filters = {"repo": repo}
            if index is not None:
                filters["path"] = merged[index]["path"]
            jobs.append(
                {
                    "id": f"e{i}",
                    "area": "code",
                    "source": "github",
                    "provider": "github-meta",
                    "operation": "repo.inspect"
                    if metric == "stars"
                    else "repo.commits",
                    "filters": filters,
                    "needs": [],
                    "limit": 1,
                    "timeout": args.timeout,
                }
            )
        if jobs:
            # Keep inspection calls available after optional popularity enrichment.
            remaining = max(0, enrichment - inspection_calls)
            jobs = jobs[:remaining]
            targets = targets[:remaining]
            enriched = engine_extend(report, jobs) if jobs else report
            report = enriched
            failures, files = set(), 0
            for i, (repo, index, metric) in enumerate(targets):
                out = enriched["outcomes"].get(f"e{i}", {})
                value = (
                    out.get("results", [{}])[0]
                    .get("fields", {})
                    .get("stars" if metric == "stars" else "commits")
                    if out.get("results")
                    else None
                )
                if value is None:
                    failures.add(status_for(enriched, f"e{i}")["status"])
                if index is None:
                    for row in merged:
                        if row["repo"] == repo and (
                            metric != "stars" or row["stars"] is None
                        ):
                            row[metric] = value
                else:
                    merged[index][metric] = value
                    files += value is not None
            statuses["github-enrich"] = backend_status(
                "partial" if failures else "ok",
                count=files,
                detail=", ".join(sorted(failures)) or None,
            )
    rows = (
        merged
        if args.relevance
        else sort_results(merged, args.sort_by, args.direction)[:limit]
    )
    if args.json:
        print(
            json.dumps(
                {
                    "query": query,
                    "sort_by": "host-relevance-pending"
                    if args.relevance
                    else args.sort_by,
                    "run_id": report["run_id"],
                    "trace": report["trace"],
                    "diagnostics": report["diagnostics"],
                    "receipt": report["receipt"],
                    "fetch_limit": fetch_limit,
                    "result_limit": limit,
                    "view": "candidates" if args.relevance else "legacy-metric-sort",
                    "display_omitted": report["diagnostics"]["counts"]["not_visible"]
                    if args.relevance
                    else max(0, len(merged) - len(rows)),
                    "direction": args.direction,
                    "backends": statuses,
                    "results": rows,
                },
                indent=2,
                sort_keys=True,
            )
        )
    else:
        print_tsv(rows, include_header=not args.no_header)
        print(report["receipt"], file=sys.stderr)
    return 0 if {s["status"] for s in statuses.values()} & {"ok", "partial"} else 1


def command_raw(args):
    query = " ".join(args.query).strip()
    if not query:
        return 2
    job = {**discovery_job(args.backend, query, args.limit, args.timeout), "raw": True}
    report = engine_run([job], discovery=1, timeout=args.timeout)
    out = report["outcomes"].get(args.backend, {})
    raw = out.get("raw")
    if raw:
        sys.stdout.write(raw["stdout"])
        sys.stderr.write(raw["stderr"])
        return raw["rc"]
    print(out.get("detail", "Backend unavailable"), file=sys.stderr)
    return 1


def command_doctor(args):
    names = [
        ("gh", "github-meta", "tool.diagnose"),
        ("gh-api", "github-meta", "quota.diagnose"),
        ("gh-skill", "gh-skill", "code.discover"),
        ("github-code", "github-code", "code.discover"),
        ("src", "sourcegraph", "tool.diagnose"),
        ("sourcegraph", "sourcegraph", "code.discover"),
        ("npx-skills", "skills-cli", "tool.diagnose"),
    ]
    jobs = []
    for name, provider, op in names:
        job = discovery_job(provider, "skill", 1, args.timeout)
        job.update(id=name, operation=op, raw=True)
        jobs.append(job)
    report = engine_run(jobs, discovery=3, enrichment=4, timeout=args.timeout)
    checks = [
        {
            "name": "uv",
            "status": "ok" if shutil.which("uv") else "missing",
            "detail": shutil.which("uv") or "uv required",
        }
    ]
    for name, _, _ in names:
        out = report["outcomes"].get(name, {})
        status = status_for(report, name)
        detail = (
            doctor_success_detail(name, out["raw"]["stdout"])
            if status["status"] == "ok" and out.get("raw")
            else status.get("detail", "")
        )
        checks.append({"name": name, "status": status["status"], "detail": detail})
    ready = [
        r["status"] == "ok"
        for r in checks
        if r["name"] in ("gh-skill", "github-code", "sourcegraph", "npx-skills")
    ]
    overall = "ok" if all(ready) else "degraded" if any(ready) else "broken"
    if args.json:
        print(json.dumps({"overall": overall, "checks": checks}, indent=2))
    else:
        print(f"skill-search doctor: {overall}")
        for check in checks:
            print(f"{check['name']}: {check['status']} - {check['detail']}")
        if any(check["status"] == "rate_limited" for check in checks):
            print("\nGitHub rate-limit workarounds:")
            print("- Wait for the reset shown by `gh api rate_limit`.")
            print("- Use --no-enrich to avoid extra GitHub API calls.")
            print("- Use Sourcegraph and npx results while quota recovers.")
            print("- Check `gh auth status` for the intended account or token.")
    return 0 if any(ready) else 1


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (RuntimeError, OSError, ValueError) as exc:
        print(str(exc), file=sys.stderr)
        raise SystemExit(2)
