#!/usr/bin/env bash
# Runs one acpx invocation with its output in a log, and keeps a viewer open beside the caller
# in Orca: one `pi-viewer acpx` split per worktree, attached to that worktree's acpx sessions.
#
# Driving agents through Orca itself (instead of acpx) would make this helper unnecessary,
# but that depends on agent hooks, which do not work reliably on the work laptop (Jamf sets
# allowManagedHooksOnly; Codex hooks are not installed). Orca also lacks what acpx gives
# callers here: exit status, receipts, permission policy, named follow-ups, timeouts, and
# the shortcut routes.
set -euo pipefail
umask 077

usage() {
  echo "usage: acpx-pane [--view] | --log <file> [--inline] -- <acpx args...>" >&2
  exit 2
}

log="" inline=0 view=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --log) [ "$#" -ge 2 ] || usage; log="$2"; shift 2 ;;
    --inline) inline=1; shift ;;
    # Accepted and ignored: agent sessions that loaded the earlier skill text still pass it.
    --label) [ "$#" -ge 2 ] || usage; shift 2 ;;
    --view) view=1; shift ;;
    --) shift; break ;;
    *) usage ;;
  esac
done
if [ "$view" = 1 ]; then
  [ -z "$log" ] && [ "$#" = 0 ] && [ "$inline" = 0 ] || usage
else
  [ -n "$log" ] && [ "$#" -gt 0 ] || usage
fi

# The run always happens here, in the caller's process: the log, exit status, and Ctrl+C
# belong to acpx. The viewer only watches.
run() { exec acpx "$@" > "$log" 2>&1; }
no_view() {
  echo "acpx-pane: $1" >&2
  exit 1
}

if [ "$inline" = 1 ] || ! command -v orca > /dev/null || ! command -v pi-viewer > /dev/null ||
   ! command -v pi > /dev/null || ! command -v python3 > /dev/null; then
  [ "$view" = 0 ] || no_view "viewing requires Orca, pi-viewer, pi, and Python 3"
  run "$@"
fi

worktree=$(orca worktree current --json 2> /dev/null || true)
worktree_id=$(printf '%s' "$worktree" | jq -r 'if .ok == true then .result.worktree.id // empty else empty end' 2> /dev/null || true)
worktree_path=$(printf '%s' "$worktree" | jq -r 'if .ok == true then .result.worktree.path // empty else empty end' 2> /dev/null || true)
parent_handle=""
if [ -n "$worktree_id" ] && [ -n "${ORCA_TERMINAL_HANDLE:-}" ]; then
  parent=$(orca terminal show --terminal "$ORCA_TERMINAL_HANDLE" --json 2> /dev/null || true)
  parent_handle=$(printf '%s' "$parent" | jq -r --arg worktree "$worktree_id" \
    'if .ok == true and .result.terminal.worktreeId == $worktree and .result.terminal.connected == true then .result.terminal.handle // empty else empty end' \
    2> /dev/null || true)
fi
if [ -n "$worktree_id" ] && [ -z "$parent_handle" ]; then
  terminals=$(orca terminal list --worktree "id:$worktree_id" --json 2> /dev/null || true)
  parent_handle=$(printf '%s' "$terminals" | jq -r --arg worktree "$worktree_id" \
    'if .ok == true then [.result.terminals[] | select(.worktreeId == $worktree and .connected == true and (.agentIdentity // "") != "" and ((.title // "") | startswith("acpx ") | not))] | if length == 1 then .[0].handle else empty end else empty end' \
    2> /dev/null || true)
fi
if [ -n "$worktree_id" ] && [ -z "$parent_handle" ]; then
  active=$(orca terminal show --json 2> /dev/null || true)
  parent_handle=$(printf '%s' "$active" | jq -r --arg worktree "$worktree_id" \
    'if .ok == true and .result.terminal.worktreeId == $worktree and .result.terminal.connected == true and ((.result.terminal.title // "") | startswith("acpx ") | not) then .result.terminal.handle // empty else empty end' \
    2> /dev/null || true)
fi
if [ -z "$parent_handle" ]; then
  [ "$view" = 0 ] || no_view "no active terminal in the current worktree"
  echo "acpx-pane: no active terminal in the current worktree; running without the viewer" >&2
  run "$@"
fi

python_bin=$(command -v python3)
viewer_bin=$(command -v pi-viewer)
key=$(printf '%s' "$worktree_id" | shasum -a 256 | cut -c1-16)
state="${XDG_STATE_HOME:-$HOME/.local/state}/acpx-pane/$key"
mkdir -p "$state"
chmod 700 "$state"
lock_file="$state/lock.flock"

# Concurrent launches in one worktree must not open two viewers.
lock() {
  exec 9>> "$lock_file"
  "$python_bin" -c '
import fcntl
import sys
import time

deadline = time.monotonic() + 20
while True:
    try:
        fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
        break
    except BlockingIOError:
        if time.monotonic() >= deadline:
            sys.exit(1)
        time.sleep(0.1)
'
}

# A viewer whose Orca pane closed is reopened; a live one is reused.
ensure_viewer() {
  local pane="" shown="" split="" command=""
  if [ -f "$state/pane" ]; then
    pane=$(cat "$state/pane")
    shown=$(orca terminal show --terminal "$pane" --json 9>&- 2> /dev/null || true)
    if [ "$(printf '%s' "$shown" | jq -r '.result.terminal.connected // false' 2> /dev/null)" != true ]; then
      pane=""
    fi
  fi
  if [ -z "$pane" ]; then
    command="exec env ACPX_CWD=$(printf %q "${worktree_path:-$PWD}") $(printf %q "$viewer_bin") acpx"
    split=$(orca terminal split --terminal "$parent_handle" --direction horizontal --command "$command" \
      --json 9>&- 2> /dev/null || true)
    pane=$(printf '%s' "$split" | jq -r '.result.split.handle // empty' 2> /dev/null || true)
    [ -n "$pane" ] || return 1
    printf '%s\n' "$pane" > "$state/pane"
  fi
  viewer_pane="$pane"
}

viewer_pane=""
if ! lock; then
  [ "$view" = 0 ] || no_view "timed out waiting for the viewer lock"
  echo "acpx-pane: timed out waiting for the viewer lock; running without the viewer" >&2
  run "$@"
fi
if ! ensure_viewer; then
  exec 9>&-
  [ "$view" = 0 ] || no_view "could not open the viewer"
  echo "acpx-pane: could not open the viewer; running without it" >&2
  run "$@"
fi
exec 9>&-

if [ "$view" = 1 ]; then
  orca terminal switch --terminal "$viewer_pane" --json > /dev/null
  echo "pane: $viewer_pane"
  exit 0
fi
echo "pane: $viewer_pane"
run "$@"
