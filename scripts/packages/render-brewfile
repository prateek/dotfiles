#!/usr/bin/env bash
#
# render-brewfile — emit a Homebrew Bundle Brewfile for a given machine
# type, sourced from home/.chezmoidata/packages.toml.
#
# Implementation: renders home/.chezmoitemplates/brewfile.tmpl. The template is
# the single source of truth for Brewfile shape; this wrapper just normalizes
# the CLI for audit scripts and CI (where the user's chezmoi config might not
# match the machine type being inspected).
#
# Usage:
#   scripts/packages/render-brewfile [--machine-type <name>] [--include-mas] [--output <file>]
#
# Exit non-zero on rendering failure.
#
set -euo pipefail

# shellcheck source-path=SCRIPTDIR
source "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"

machine_type=""
include_mas=""
output=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --machine-type)
      [[ $# -ge 2 ]] || { printf 'render-brewfile: --machine-type requires a value\n' >&2; exit 2; }
      machine_type="$2"; shift 2 ;;
    --machine-type=*)
      machine_type="${1#*=}"; shift ;;
    --include-mas)
      include_mas="true"; shift ;;
    --output)
      [[ $# -ge 2 ]] || { printf 'render-brewfile: --output requires a path\n' >&2; exit 2; }
      output="$2"; shift 2 ;;
    --output=*)
      output="${1#*=}"; shift ;;
    -h|--help)
      sed -n '2,17p' "$0" >&2
      exit 0 ;;
    *)
      printf 'render-brewfile: unknown argument: %s\n' "$1" >&2
      exit 2 ;;
  esac
done

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"

args=(--template "$repo_root/home/.chezmoitemplates/brewfile.tmpl")
if [[ -n $machine_type ]]; then args+=(--machine-type "$machine_type"); fi
if [[ -n $output ]]; then args+=(--output "$output"); fi
# MAS opt-in stays a runtime env switch (the template reads it via env).
if [[ -n $include_mas ]]; then args+=(--env "DOTFILES_INSTALL_MAS_APPS=$include_mas"); fi

render_chezmoi_template "${args[@]}"
