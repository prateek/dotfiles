#!/bin/sh
# chezmoi's onepassword.command (home/.chezmoi.toml.tmpl): run `op` as the
# 1Password service account whose token is in the login keychain.
token="$(security find-generic-password -s op-devland-sa -w)" || {
  echo "op-service-account: store the token first: security add-generic-password -U -s op-devland-sa -a \"\$USER\" -w" >&2
  exit 1
}
OP_SERVICE_ACCOUNT_TOKEN="$token" exec op "$@"
