#!/usr/bin/env python3
"""Find an exact item title in one vault without printing item fields."""

import argparse
import json
from pathlib import Path
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--vault", required=True)
    parser.add_argument("--title", required=True)
    parser.add_argument(
        "--op-command",
        type=Path,
        default=Path(__file__).resolve().parents[1] / "chezmoi-hooks/op-service-account",
    )
    args = parser.parse_args()
    result = subprocess.run(
        [str(args.op_command), "item", "list", "--vault", args.vault, "--format=json"],
        capture_output=True,
        check=True,
    )
    items = json.loads(result.stdout)
    matches = [item["id"] for item in items if item.get("title") == args.title]
    if len(matches) > 1:
        raise ValueError("multiple exact matches")
    print(json.dumps({"found": bool(matches), "id": matches[0] if matches else None}))


if __name__ == "__main__":
    try:
        main()
    except Exception:
        print("find-item: lookup failed; details withheld", file=sys.stderr)
        sys.exit(1)
