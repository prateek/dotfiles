#!/usr/bin/env python3
"""Export an existing Devland SSH key in OpenSSH form and validate it."""

import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--vault", required=True)
    parser.add_argument("--item", required=True)
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--op-command", type=Path, default=Path(__file__).resolve().parents[1] / "chezmoi-hooks/op-service-account")
    args = parser.parse_args()
    if args.output.exists():
        raise ValueError("output already exists")
    item = subprocess.run([str(args.op_command), "item", "get", args.item, "--vault", args.vault, "--format=json"], capture_output=True, check=True)
    data = json.loads(item.stdout)
    key = data.get("private_key", {}).get("ssh_formats", {}).get("openssh")
    if not isinstance(key, str) or not key.startswith("-----BEGIN OPENSSH PRIVATE KEY-----"):
        raise ValueError("item has no OpenSSH private key export")
    descriptor, temporary = tempfile.mkstemp(prefix=".ssh-key-", dir=args.output.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w") as stream:
            stream.write(key)
            if not key.endswith("\n"):
                stream.write("\n")
        subprocess.run(["ssh-keygen", "-y", "-f", temporary], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
        os.link(temporary, args.output)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    print(args.output)


if __name__ == "__main__":
    try:
        main()
    except Exception:
        print("export-ssh-key: export or validation failed; details withheld", file=sys.stderr)
        sys.exit(1)
